// Resizing and reflow, scrollback, and the sequences added since.

import bytes
import self.scrollback
import self.terminal

fn run(cols: Int, rows: Int, input: String) -> terminal.Terminal = {
  var t = terminal.new(cols, rows)
  terminal.feed_string(t, input)
  t
}

test "scrollback memory stays inside its budget under endless output" {
  let limit = 200000
  var t = terminal.with_scrollback(80, 24, limit)
  for i in 0..<20000 {
    terminal.feed_string(t, "\x1b[1;36m⏺\x1b[0m line ${int.to_string(i)} 日本語 👩‍💻 e\u{0301} \x1b[38;2;200;100;50mcolored\x1b[0m\r\n")
    assert(scrollback.bytes_used(t.sb) <= limit)
  }
  assert(t.sb.evicted_lines > 0)
  assert_eq(scrollback.line_count(t.sb) + t.sb.evicted_lines, 20000 - 23)
}

test "resizing wider keeps the content and the cursor" {
  var t = run(5, 3, "ab\r\ncd")
  terminal.resize(t, 8, 3)
  assert_eq(terminal.screen_text(t), "ab\ncd")
  assert_eq((t.cols, t.x, t.y), (8, 2, 1))
  terminal.feed_string(t, "efghij")
  assert_eq(terminal.screen_text(t), "ab\ncdefghij")
}

test "resizing shorter moves the lines above the cursor to scrollback" {
  var t = run(10, 4, "1\r\n2\r\n3\r\n4")
  terminal.resize(t, 10, 2)
  assert_eq(terminal.screen_text(t), "3\n4")
  assert_eq(scrollback.texts(t.sb), ["1", "2"])
  assert_eq(t.y, 1)
}

test "narrowing wraps a wide char that no longer fits onto the next row" {
  var t = run(6, 3, "ab日本")
  terminal.resize(t, 5, 3)
  assert_eq(terminal.screen_text(t), "ab日\n本")
  terminal.resize(t, 3, 3)
  assert_eq(terminal.screen_text(t), "ab\n日\n本")
}

test "widening joins the rows a line wrapped onto" {
  var t = run(5, 3, "abcdefgh\r\nxy")
  assert_eq(terminal.screen_text(t), "abcde\nfgh\nxy")
  terminal.resize(t, 10, 3)
  assert_eq(terminal.screen_text(t), "abcdefgh\nxy")
  assert_eq((t.x, t.y), (2, 1))
}

test "narrowing wraps lines and keeps the cursor at its place in its line" {
  var t = run(10, 4, "0123456789\r\nhello")
  terminal.resize(t, 4, 4)
  assert_eq(terminal.screen_text(t), "4567\n89\nhell\no")
  assert_eq(scrollback.texts(t.sb), ["0123"])
  assert_eq((t.x, t.y), (1, 3))
}

test "spaces at a wrap point survive wrapping again" {
  var t = run(6, 3, "hello world")
  terminal.resize(t, 20, 3)
  assert_eq(terminal.screen_text(t), "hello world")
  terminal.resize(t, 6, 3)
  terminal.resize(t, 20, 3)
  assert_eq(terminal.screen_text(t), "hello world")
}

test "a line wrapped between scrollback and screen is joined" {
  var t = run(4, 2, "abcdefghij")
  assert_eq(terminal.screen_text(t), "efgh\nij")
  assert_eq(scrollback.texts(t.sb), ["abcd"])
  terminal.resize(t, 12, 2)
  assert_eq(terminal.screen_text(t), "abcdefghij")
  assert_eq(scrollback.texts(t.sb), [])
  assert_eq((t.x, t.y), (10, 0))
}

test "a pending wrap stays pending across a reflow" {
  var t = run(5, 3, "abcde")
  terminal.resize(t, 3, 3)
  assert_eq(terminal.screen_text(t), "abc\nde")
  terminal.feed_string(t, "f")
  terminal.resize(t, 10, 3)
  assert_eq(terminal.screen_text(t), "abcdef")
}

test "resizing after the ring has turned keeps row order" {
  var t = run(4, 2, "1\r\n2\r\n3")
  terminal.resize(t, 4, 3)
  assert_eq(terminal.screen_text(t), "2\n3")
  terminal.feed_string(t, "\r\n4\r\n5")
  assert_eq(terminal.screen_text(t), "3\n4\n5")
}

test "an ASCII run stops at a wide char and splits it" {
  let t = run(8, 2, "ab日本\x1b[1;1Habcd")
  assert_eq(terminal.screen_text(t), "abcd本")
  assert_eq(t.x, 4)
}

test "an ASCII run ends on the last column and wraps on the next byte" {
  var t = run(5, 3, "abcde")
  assert_eq((t.x, t.pending_wrap), (4, true))
  terminal.feed_string(t, "fg")
  assert_eq(terminal.screen_text(t), "abcde\nfg")
}

test "the shell's working directory arrives by OSC 7" {
  let t = run(10, 2, "\x1b]7;file://mac.local/Users/me/my%20dir\x07")
  assert_eq(t.cwd, "/Users/me/my dir")
}

test "a live resize settles to what one resize gives" {
  let text = "0123456789abcdefghij\r\nshort\r\n日本語のテキストが折り返す\r\nend"
  var once = run(20, 3, text)
  terminal.resize(once, 7, 3)
  var live = run(20, 3, text)
  terminal.resize_live(live, 15, 3)
  terminal.resize_live(live, 9, 3)
  terminal.resize_live(live, 7, 3)
  terminal.settle(live)
  assert_eq(terminal.screen_text(live), terminal.screen_text(once))
  assert_eq(scrollback.texts(live.sb), scrollback.texts(once.sb))
  assert_eq((live.x, live.y), (once.x, once.y))
}

test "kitty keyboard flags are pushed, queried and popped" {
  var t = run(10, 2, "\x1b[?u")
  assert_eq(terminal.take_replies(t), "\x1b[?0u")
  terminal.feed_string(t, "\x1b[>31u\x1b[?u")
  assert_eq(terminal.take_replies(t), "\x1b[?1u")
  terminal.feed_string(t, "\x1b[<u\x1b[?u")
  assert_eq(terminal.take_replies(t), "\x1b[?0u")
}

test "XTVERSION and the colour scheme are answered" {
  var t = run(10, 2, "\x1b[>0q\x1b[?996n")
  assert_eq(terminal.take_replies(t), "\x1bP>|sprid ${terminal.VERSION}\x1b\\\x1b[?997;1n")
}

test "LF, IND and RI end the pending wrap" {
  let t = run(5, 4, "abcde\nX")
  assert_eq(terminal.screen_text(t), "abcde\n    X")
  let u = run(5, 4, "\r\nabcde\x1bMX")
  assert_eq(terminal.screen_text(u), "    X\nabcde")
}

test "erasing a line to its end ends its wrap" {
  var t = run(5, 4, "abcdefgh")
  assert_eq(bytes.read_u8(t.wrapped, terminal.phys(t, 0)), 1)
  terminal.feed_string(t, "\x1b[1;1H\x1b[K")
  assert_eq(bytes.read_u8(t.wrapped, terminal.phys(t, 0)), 0)
  var u = run(5, 4, "abcdefgh\x1b[1;3H\x1b[J")
  assert_eq(bytes.read_u8(u.wrapped, terminal.phys(u, 0)), 0)
}

test "a resize under the alternate screen keeps the main screen's lines" {
  var t = run(10, 6, "1\r\n2\r\n3\r\n4\r\n5\r\n$ vim\x1b[?1049h")
  terminal.resize(t, 10, 3)
  terminal.feed_string(t, "\x1b[?1049l")
  assert_eq(terminal.screen_text(t), "4\n5\n$ vim")
  assert_eq(scrollback.line_count(t.sb), 3)
}

test "a resize under the alternate screen reflows the main screen" {
  var t = run(10, 3, "0123456789abc\x1b[?1049h")
  terminal.resize(t, 5, 3)
  terminal.resize(t, 10, 3)
  terminal.feed_string(t, "\x1b[?1049l")
  assert_eq(terminal.screen_text(t), "0123456789\nabc")
}

test "deleting and inserting characters carries combining marks" {
  let t = run(10, 2, "aéb\x1b[1;1H\x1b[P")
  assert_eq(terminal.screen_text(t), "éb")
  let u = run(10, 2, "aéb\x1b[1;1H\x1b[@")
  assert_eq(terminal.screen_text(u), " aéb")
}

test "erases take a wide character whole" {
  let t = run(10, 2, "a日b\x1b[1;3H\x1b[K")
  assert_eq(terminal.screen_text(t), "a")
  let u = run(10, 2, "a日b\x1b[1;3H\x1b[X")
  assert_eq(terminal.screen_text(u), "a  b")
}

test "each screen keeps its own saved cursor" {
  let t = run(10, 4, "ab\x1b7\x1b[?1049h\x1b[3;3H\x1b7\x1b[?1049l\x1b8X")
  assert_eq(terminal.screen_text(t), "abX")
}

test "VPA counts from the top margin in origin mode" {
  let t = run(5, 6, "\x1b[3;5r\x1b[?6h\x1b[1dX")
  assert_eq(terminal.screen_text(t), "\n\nX")
}

test "invalid UTF-8 shows the replacement character" {
  var t = terminal.new(10, 2)
  terminal.feed(t, bytes.from_list([0x61, 0xED, 0xA0, 0x80, 0x62, 0xF4, 0x90, 0x80, 0x80, 0x63, 0xE0, 0x80, 0xAF]))
  assert_eq(terminal.screen_text(t), "a\u{FFFD}b\u{FFFD}c\u{FFFD}")
}

test "DECSTR sends the saved cursor home" {
  let t = run(10, 4, "\x1b[3;5H\x1b7\x1b[!p\x1b8X")
  assert_eq(terminal.screen_text(t), "X")
}

test "DECRQM answers for the modes sprid knows" {
  var t = run(10, 2, "\x1b[?2026$p\x1b[?2004h\x1b[?2004$p\x1b[?9999$p")
  assert_eq(terminal.take_replies(t), "\x1b[?2026;2$y\x1b[?2004;1$y\x1b[?9999;0$y")
}

test "a change of height keeps the tab stops" {
  var t = run(20, 4, "\x1b[3g\x1b[1;4H\x1bH")
  terminal.resize(t, 20, 6)
  terminal.feed_string(t, "\r\tX")
  assert_eq(t.x, 4)
}
