// Cell layout shared by the grid and scrollback.
//
// A grid is one flat Bytes of rows * cols cells, SIZE bytes each:
//
//   0  u32  codepoint (0 = never written, shown as a blank)
//   4  u32  foreground color
//   8  u32  background color
//   12 u16  attributes (ATTR_* bits; the top 6 the link's low bits)
//   14 u8   width: 1 normal, 2 head of a wide char, 0 tail of a wide char
//   15 u8   flags (FLAG_* bits; bits 1-5 the link's high bits)
//
// Colors: 0 is the default color, 0x01000000 | n palette entry n,
// 0x02000000 | 0xRRGGBB a direct color.

import bytes

let SIZE = 16

let OFF_CP = 0
let OFF_FG = 4
let OFF_BG = 8
let OFF_ATTRS = 12
let OFF_WIDTH = 14
let OFF_FLAGS = 15

let ATTR_BOLD = 1
let ATTR_FAINT = 2
let ATTR_ITALIC = 4
let ATTR_UNDERLINE = 8
let ATTR_BLINK = 16
let ATTR_INVERSE = 32
let ATTR_HIDDEN = 64
let ATTR_STRIKE = 128
let ATTR_DOUBLE_UNDERLINE = 256
let ATTR_OVERLINE = 512

/// The cell carries extra codepoints (combining marks, ZWJ sequences) in its
/// screen's grapheme map.
let FLAG_GRAPHEME = 1

/// The cell is part of a shell's prompt (OSC 133).
let FLAG_PROMPT = 128

/// The cell is part of the prompt a command that failed was typed at: the
/// shell reported a status other than 0 (OSC 133 D).
let FLAG_FAILED = 64

/// `FLAG_PROMPT` and `FLAG_FAILED` as bits of the u32 at `OFF_ATTRS`; the
/// pen keeps the first.
let PROMPT_BIT = 0x80000000
let FAILED_BIT = 0x40000000

/// The attribute bits proper, without the link's.
let ATTR_MASK = 0x3FF

/// The most links (OSC 8) a terminal tells apart at once: a cell's link is a
/// 11-bit id into its terminal's table, 0 for none. It lives in the bits the
/// attributes and the flags leave free, so it goes wherever the cell goes —
/// scrolled, reflowed, into scrollback — with nothing kept in step.
let LINK_MAX = 2047

/// Every link bit of the u32 at `OFF_ATTRS`.
let LINK_MASK = 0x3E00FC00

/// Link `id` as bits of the u32 at `OFF_ATTRS` (attributes, width, flags).
fn link_bits(id: Int) -> Int = int.bor(int.bshl(int.band(id, 63), 10), int.bshl(int.band(int.bshr(id, 6), 31), 25))

/// The link id in `word`, the u32 at a cell's `OFF_ATTRS`.
fn link_of(word: Int) -> Int = int.bor(int.band(int.bshr(word, 10), 63), int.bshl(int.band(int.bshr(word, 25), 31), 6))

/// Whether the cell at byte `o` of `cells` is part of a prompt.
fn is_prompt(cells: Bytes, o: Int) -> Bool = int.band(bytes.read_u8(cells, o + OFF_FLAGS), FLAG_PROMPT) != 0

/// Whether the cell at byte `o` of `cells` is part of a prompt after a
/// failed command.
fn is_failed(cells: Bytes, o: Int) -> Bool = int.band(bytes.read_u8(cells, o + OFF_FLAGS), FLAG_FAILED) != 0

/// The link of the cell at byte `o` of `cells`.
fn link_at(cells: Bytes, o: Int) -> Int = link_of(bytes.read_u32_le(cells, o + OFF_ATTRS))

let COLOR_DEFAULT = 0

fn palette(n: Int) -> Int = int.bor(0x01000000, int.band(n, 0xFF))

fn rgb(r: Int, g: Int, b: Int) -> Int =
  int.bor(0x02000000, int.bor(int.bshl(int.band(r, 0xFF), 16), int.bor(int.bshl(int.band(g, 0xFF), 8), int.band(b, 0xFF))))

/// A row of `cols` blank cells on background `bg`. Erasing copies this over
/// the row, so an erased cell takes the current background (xterm's
/// background color erase).
fn blank_row(cols: Int, bg: Int) -> Bytes = {
  var row = bytes.new(cols * SIZE)
  for x in 0..<cols {
    bytes.set_u32_le(row, x * SIZE + OFF_BG, bg)
    bytes.set_u8(row, x * SIZE + OFF_WIDTH, 1)
  }
  row
}

test "a link id round-trips through a cell's free bits" {
  for id in [0, 1, 63, 64, 1000, LINK_MAX] {
    let word = int.bor(int.bor(link_bits(id), ATTR_MASK), int.bor(int.bshl(2, 16), int.bshl(FLAG_GRAPHEME + FLAG_PROMPT + FLAG_FAILED, 24)))
    assert_eq(link_of(word), id)
    assert_eq(int.band(word, PROMPT_BIT + FAILED_BIT), PROMPT_BIT + FAILED_BIT)
    assert_eq(int.band(word, LINK_MASK), link_bits(id))
    assert_eq(int.band(word, ATTR_MASK), ATTR_MASK)
    assert_eq(int.band(int.bshr(word, 16), 0xFF), 2)
    assert_eq(int.band(int.bshr(word, 24), FLAG_GRAPHEME), FLAG_GRAPHEME)
  }
}
