// Keyboard input to the bytes a program on the PTY reads.
//
// Kinds, key codes and modifier bits are the window's (snaidhm's
// native/window.almd): a TEXT input carries a code point, a KEY input a DOM
// key code. The encodings are xterm's, which is what TERM=xterm-256color
// promises.

let TEXT = 5
let KEY = 6

let MOD_SHIFT = 1
let MOD_CTRL = 2
let MOD_ALT = 4
let MOD_SUPER = 8

let KEY_BACKSPACE = 8
let KEY_TAB = 9
let KEY_ENTER = 13
let KEY_ESCAPE = 27
let KEY_PAGE_UP = 33
let KEY_PAGE_DOWN = 34
let KEY_END = 35
let KEY_HOME = 36
let KEY_LEFT = 37
let KEY_UP = 38
let KEY_RIGHT = 39
let KEY_DOWN = 40
let KEY_INSERT = 45
let KEY_DELETE = 46
let KEY_F1 = 112

/// Bytes for one input, or "" when it types nothing (Super shortcuts are the
/// window's, not the program's). `app_cursor` is DECCKM: arrows and Home/End
/// send SS3 instead of CSI.
fn encode(kind: Int, code: Int, mods: Int, app_cursor: Bool) -> String =
  encode_with(kind, code, mods, app_cursor, 0)

/// `encode` under kitty keyboard `flags` (the program's, see
/// terminal.kitty_flags). With 1, disambiguate escape codes, a key that
/// xterm's encoding confuses with another is sent as `CSI code ; mods u`:
/// Escape, and Enter, Tab and Backspace with a modifier (Shift+Enter is not
/// Enter), and text typed with Ctrl or Alt (Ctrl+I is not Tab).
fn encode_with(kind: Int, code: Int, mods: Int, app_cursor: Bool, flags: Int) -> String =
  if int.band(mods, MOD_SUPER) != 0 then ""
  else match (if int.band(flags, 1) != 0 then disambiguated(kind, code, mods) else none) {
    some(out) => out,
    none => if kind == TEXT then text(code, mods) else if kind == KEY then key(code, mods, app_cursor) else "",
  }

/// The kitty protocol's encoding of an input xterm's would confuse with
/// another, or none for one xterm's encodes well.
fn disambiguated(kind: Int, code: Int, mods: Int) -> Option[String] =
  if kind == TEXT then (if int.band(mods, MOD_CTRL + MOD_ALT) != 0 then some(csi_u(lower(code), mods)) else none)
  else if kind != KEY then none
  else if code == KEY_ESCAPE then some(csi_u(27, mods))
  else if mods != 0 and list.contains([KEY_ENTER, KEY_TAB, KEY_BACKSPACE], code) then
    some(csi_u(if code == KEY_BACKSPACE then 127 else code, mods))
  else none

/// An ASCII capital as its small letter; anything else as it is.
fn lower(cp: Int) -> Int = if cp >= 0x41 and cp <= 0x5A then cp + 32 else cp

/// `CSI code u`, or `CSI code ; mods u` with modifiers held.
fn csi_u(code: Int, mods: Int) -> String = {
  let m = modifier_param(mods)
  if m > 1 then "\x1b[${int.to_string(code)};${int.to_string(m)}u" else "\x1b[${int.to_string(code)}u"
}

/// A typed character. Ctrl makes a control character of it; Alt (Option, as
/// macos-option-as-alt) sends ESC before it.
fn text(cp: Int, mods: Int) -> String = {
  let base = if int.band(mods, MOD_CTRL) != 0 then control(cp) else string.from_codepoint(cp)
  if int.band(mods, MOD_ALT) != 0 then "\x1b" + base else base
}

/// Ctrl with the keys that aren't letters or @[\]^_, as xterm maps them —
/// Ctrl+Space and Ctrl+2 to NUL, Ctrl+3..7 to ESC, FS, GS, RS, US, Ctrl+8
/// and Ctrl+? to DEL, Ctrl+/ and Ctrl+- to US (the window gives the key
/// without Shift, so Ctrl+_ arrives as Ctrl+- and Ctrl+^ as Ctrl+6).
let CONTROL_KEYS = [(0x20, 0x00), (0x32, 0x00), (0x33, 0x1B), (0x34, 0x1C), (0x35, 0x1D), (0x36, 0x1E), (0x37, 0x1F),
  (0x2F, 0x1F), (0x2D, 0x1F), (0x38, 0x7F), (0x3F, 0x7F)]

/// Ctrl+`cp`: letters and @[\]^_ map to 0x00..0x1F, the keys in
/// `CONTROL_KEYS` as listed there; anything else is itself.
fn control(cp: Int) -> String = {
  let letter = (cp >= 0x40 and cp <= 0x5F) or (cp >= 0x61 and cp <= 0x7A)
  let mapped = if letter then some(int.band(cp, 0x1F)) else lookup(CONTROL_KEYS, cp)
  string.from_codepoint(mapped ?? cp)
}

/// The value paired with `k` in `pairs`.
fn lookup[V](pairs: List[(Int, V)], k: Int) -> Option[V] =
  list.find(pairs, (p) => p.0 == k) |> option.map((p) => p.1)

/// xterm's modifier parameter: 1 + Shift 1 + Alt 2 + Ctrl 4.
fn modifier_param(mods: Int) -> Int =
  1 + (if int.band(mods, MOD_SHIFT) != 0 then 1 else 0)
    + (if int.band(mods, MOD_ALT) != 0 then 2 else 0)
    + (if int.band(mods, MOD_CTRL) != 0 then 4 else 0)

/// A cursor-style key: `CSI final` / `SS3 final`, or `CSI 1;m final` when
/// modified.
fn cursor_key(final: String, mods: Int, app_cursor: Bool) -> String = {
  let m = modifier_param(mods)
  if m > 1 then "\x1b[1;${int.to_string(m)}${final}"
  else if app_cursor then "\x1bO${final}"
  else "\x1b[${final}"
}

/// A tilde key: `CSI n ~`, or `CSI n;m ~` when modified.
fn tilde_key(n: Int, mods: Int) -> String = {
  let m = modifier_param(mods)
  if m > 1 then "\x1b[${int.to_string(n)};${int.to_string(m)}~" else "\x1b[${int.to_string(n)}~"
}

/// The keys sent as cursor keys, and their finals.
let CURSOR_KEYS = [(KEY_UP, "A"), (KEY_DOWN, "B"), (KEY_RIGHT, "C"), (KEY_LEFT, "D"), (KEY_HOME, "H"), (KEY_END, "F")]

/// The keys sent as tilde keys, and their numbers: Insert, Delete, Page Up /
/// Down, F5..F12.
let TILDE_KEYS = [(KEY_INSERT, 2), (KEY_DELETE, 3), (KEY_PAGE_UP, 5), (KEY_PAGE_DOWN, 6),
  (KEY_F1 + 4, 15), (KEY_F1 + 5, 17), (KEY_F1 + 6, 18), (KEY_F1 + 7, 19),
  (KEY_F1 + 8, 20), (KEY_F1 + 9, 21), (KEY_F1 + 10, 23), (KEY_F1 + 11, 24)]

fn key(code: Int, mods: Int, app_cursor: Bool) -> String =
  match lookup(CURSOR_KEYS, code) {
    some(final) => cursor_key(final, mods, app_cursor),
    none => match lookup(TILDE_KEYS, code) {
      some(n) => tilde_key(n, mods),
      none => if code >= KEY_F1 and code < KEY_F1 + 4 then f1_to_f4(code, mods) else other_key(code, mods),
    },
  }

/// F1..F4: SS3 P..S, or CSI 1;m P..S when modified.
fn f1_to_f4(code: Int, mods: Int) -> String = {
  let final = string.from_codepoint(0x50 + code - KEY_F1)
  let m = modifier_param(mods)
  if m > 1 then "\x1b[1;${int.to_string(m)}${final}" else "\x1bO${final}"
}

/// Enter, Backspace, Tab and Escape; Alt sends ESC before them.
fn other_key(code: Int, mods: Int) -> String = {
  let alt = if int.band(mods, MOD_ALT) != 0 then "\x1b" else ""
  if code == KEY_ENTER then alt + "\r"
  else if code == KEY_BACKSPACE then alt + (if int.band(mods, MOD_CTRL) != 0 then "\x08" else "\x7f")
  else if code == KEY_TAB then (if int.band(mods, MOD_SHIFT) != 0 then "\x1b[Z" else alt + "\t")
  else if code == KEY_ESCAPE then alt + "\x1b"
  else ""
}

/// The keys that read as Cmd on Linux when held with Ctrl+Shift.
let LINUX_SHORTCUT_KEYS = [KEY_ENTER, KEY_HOME, KEY_END, KEY_PAGE_UP, KEY_PAGE_DOWN, KEY_UP, KEY_DOWN]

/// The modifiers a shortcut reads. On a Mac a terminal's own keys — copy,
/// paste, tabs, find, font size, scrolling — are Cmd's; on Linux, where the
/// desktop keeps Super, they are Ctrl+Shift's. So there Ctrl+Shift with a
/// character, or with Enter, Home, End, Page Up / Down, Up or Down, reads as
/// Cmd, and one set of shortcuts serves both. Ctrl+Shift with Left, Right or
/// Backspace stays the program's (an editor selects by word with them).
fn shortcut_mods(linux: Bool, kind: Int, code: Int, mods: Int) -> Int =
  if not linux or mods != MOD_CTRL + MOD_SHIFT then mods
  else if kind == TEXT or (kind == KEY and list.contains(LINUX_SHORTCUT_KEYS, code)) then MOD_SUPER
  else mods

/// The Mac's text-editing keys and what they send: (modifiers, key, bytes).
let MAC_EDIT_KEYS = [
  (MOD_SUPER, KEY_LEFT, "\x01"), (MOD_SUPER, KEY_RIGHT, "\x05"), (MOD_SUPER, KEY_BACKSPACE, "\x15"),
  (MOD_ALT, KEY_LEFT, "\x1bb"), (MOD_ALT, KEY_RIGHT, "\x1bf"),
]

/// The Mac's text-editing keys, as the shell's line editor knows them — what
/// macOS terminals commonly send: Cmd+Left / Right to the start and
/// end of the line (Ctrl+A, Ctrl+E), Cmd+Backspace deletes to its start
/// (Ctrl+U), Option+Left / Right move by word (ESC b, ESC f). "" for any
/// other input.
fn mac_edit(kind: Int, code: Int, mods: Int) -> String =
  if kind != KEY then ""
  else list.find(MAC_EDIT_KEYS, (e) => e.0 == mods and e.1 == code) |> option.map((e) => e.2) ?? ""

/// `path` as the shell reads one word: the characters it would take
/// otherwise — spaces, quotes, globs, `$` and the like — escaped with a
/// backslash, as Finder's drop into Terminal.app writes it.
fn shell_escape(path: String) -> String =
  string.join(list.map(string.chars(path), (ch) => if string.contains(" \t'\"\\$`!&*()[]{}|;<>?#~=%^", ch) then "\\" + ch else ch), "")

/// Pasted text: newlines become CR, as typed Enter would, and with
/// bracketed paste (mode 2004) the program is told where it starts and ends.
/// Stray paste-end markers inside are dropped so text can't close the
/// bracket early.
fn paste(s: String, bracketed: Bool) -> String = {
  let body = s |> string.replace("\r\n", "\r") |> string.replace("\n", "\r")
  if bracketed then "\x1b[200~" + string.replace(body, "\x1b[201~", "") + "\x1b[201~" else body
}

/// Whether pasting `s` would press Enter: a line break anywhere in it,
/// even the last character, runs what comes before it.
fn multiline(s: String) -> Bool = string.contains(s, "\n") or string.contains(s, "\r")

test "a line break anywhere is a press of Enter" {
  assert_eq((multiline("ls"), multiline("ls\n"), multiline("a\r\nb")), (false, true, true))
}

test "plain text is itself" {
  assert_eq(encode(TEXT, 0x61, 0, false), "a")
  assert_eq(encode(TEXT, 0x3042, 0, false), "あ")
}

test "ctrl makes control characters" {
  assert_eq(encode(TEXT, 0x63, MOD_CTRL, false), "\x03")
  assert_eq(encode(TEXT, 0x64, MOD_CTRL, false), "\x04")
  assert_eq(encode(TEXT, 0x5B, MOD_CTRL, false), "\x1b")
  assert_eq(encode(TEXT, 0x20, MOD_CTRL, false), string.from_codepoint(0))
}

test "alt prefixes ESC" {
  assert_eq(encode(TEXT, 0x62, MOD_ALT, false), "\x1bb")
  assert_eq(encode(KEY, KEY_BACKSPACE, MOD_ALT, false), "\x1b\x7f")
}

test "super is the window's" {
  assert_eq(encode(TEXT, 0x76, MOD_SUPER, false), "")
}

test "arrows follow DECCKM and modifiers" {
  assert_eq(encode(KEY, KEY_UP, 0, false), "\x1b[A")
  assert_eq(encode(KEY, KEY_UP, 0, true), "\x1bOA")
  assert_eq(encode(KEY, KEY_LEFT, MOD_CTRL, true), "\x1b[1;5D")
  assert_eq(encode(KEY, KEY_RIGHT, MOD_SHIFT + MOD_ALT, false), "\x1b[1;4C")
}

test "editing and function keys" {
  assert_eq(encode(KEY, KEY_ENTER, 0, false), "\r")
  assert_eq(encode(KEY, KEY_BACKSPACE, 0, false), "\x7f")
  assert_eq(encode(KEY, KEY_TAB, MOD_SHIFT, false), "\x1b[Z")
  assert_eq(encode(KEY, KEY_DELETE, 0, false), "\x1b[3~")
  assert_eq(encode(KEY, KEY_PAGE_DOWN, MOD_SHIFT, false), "\x1b[6;2~")
  assert_eq(encode(KEY, KEY_F1, 0, false), "\x1bOP")
  assert_eq(encode(KEY, KEY_F1 + 4, 0, false), "\x1b[15~")
  assert_eq(encode(KEY, KEY_F1 + 11, 0, false), "\x1b[24~")
}

test "paste brackets and normalizes newlines" {
  assert_eq(paste("a\nb\r\nc", false), "a\rb\rc")
  assert_eq(paste("x\x1b[201~y", true), "\x1b[200~xy\x1b[201~")
}

test "kitty disambiguation tells modified keys apart" {
  assert_eq(encode_with(KEY, KEY_ENTER, MOD_SHIFT, false, 1), "\x1b[13;2u")
  assert_eq(encode_with(KEY, KEY_ENTER, 0, false, 1), "\r")
  assert_eq(encode_with(KEY, KEY_ESCAPE, 0, false, 1), "\x1b[27u")
  assert_eq(encode_with(TEXT, 0x63, MOD_CTRL, false, 1), "\x1b[99;5u")
  assert_eq(encode_with(TEXT, 0x61, MOD_ALT, false, 1), "\x1b[97;3u")
  assert_eq(encode_with(TEXT, 0x41, MOD_SHIFT, false, 1), "A")
  assert_eq(encode_with(KEY, KEY_TAB, MOD_SHIFT, false, 1), "\x1b[9;2u")
  assert_eq(encode_with(KEY, KEY_UP, 0, false, 1), "\x1b[A")
  assert_eq(encode_with(KEY, KEY_ENTER, MOD_SHIFT, false, 0), "\r")
}

test "mac editing keys" {
  assert_eq(mac_edit(KEY, KEY_LEFT, MOD_SUPER), "\x01")
  assert_eq(mac_edit(KEY, KEY_RIGHT, MOD_SUPER), "\x05")
  assert_eq(mac_edit(KEY, KEY_BACKSPACE, MOD_SUPER), "\x15")
  assert_eq(mac_edit(KEY, KEY_LEFT, MOD_ALT), "\x1bb")
  assert_eq(mac_edit(KEY, KEY_RIGHT, MOD_ALT), "\x1bf")
  // Shift+Option+Left selects in some editors: left to the program.
  assert_eq(mac_edit(KEY, KEY_LEFT, MOD_ALT + MOD_SHIFT), "")
  assert_eq(mac_edit(TEXT, 0x61, MOD_SUPER), "")
}

test "on Linux Ctrl+Shift is a shortcut's Cmd, and nowhere else" {
  let cs = MOD_CTRL + MOD_SHIFT
  assert_eq(shortcut_mods(true, TEXT, 0x76, cs), MOD_SUPER)
  assert_eq(shortcut_mods(true, KEY, KEY_PAGE_UP, cs), MOD_SUPER)
  assert_eq(shortcut_mods(true, KEY, KEY_ENTER, cs), MOD_SUPER)
  // The program's: Ctrl+Shift+Left, and plain Ctrl.
  assert_eq(shortcut_mods(true, KEY, KEY_LEFT, cs), cs)
  assert_eq(shortcut_mods(true, TEXT, 0x76, MOD_CTRL), MOD_CTRL)
  // A Mac keeps its modifiers.
  assert_eq(shortcut_mods(false, TEXT, 0x76, cs), cs)
}

test "dropped paths are escaped for the shell" {
  assert_eq(shell_escape("/Users/me/Desktop/shot 1.png"), "/Users/me/Desktop/shot\\ 1.png")
  assert_eq(shell_escape("/tmp/a(b)'c\"d$e"), "/tmp/a\\(b\\)\\'c\\\"d\\$e")
  assert_eq(shell_escape("/tmp/日本語.png"), "/tmp/日本語.png")
}

test "ctrl with digits and symbols, as xterm" {
  assert_eq(encode(TEXT, 0x33, MOD_CTRL, false), "\x1b")
  assert_eq(encode(TEXT, 0x36, MOD_CTRL + MOD_SHIFT, false), string.from_codepoint(0x1E))
  assert_eq(encode(TEXT, 0x2D, MOD_CTRL + MOD_SHIFT, false), string.from_codepoint(0x1F))
  assert_eq(encode(TEXT, 0x38, MOD_CTRL, false), "\x7f")
}
