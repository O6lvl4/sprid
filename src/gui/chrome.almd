// The window's own parts: the scrollbar and the tab bar.

import self.terminal
import self.view
import self.width as cell_width
import self.gui.surface
import self.gui.ink

fn scrollbar_width(r: surface.Renderer) -> Int = int.max(4, r.pad_x / 3)

/// The scrollbar's track, by the right edge of the pane in `r.box`: its top
/// and height, pixels.
fn track(r: surface.Renderer) -> (Int, Int) = {
  let top = surface.grid_y(r)
  (top, int.max(1, r.box.1 + r.box.3 - top - r.pad_y))
}

/// The scrollbar thumb's top and bottom, pixels, for the view scrolled
/// `back` lines and `shift` pixels.
fn thumb(r: surface.Renderer, t: terminal.Terminal, back: Int, shift: Int) -> (Int, Int) = {
  let (top, len) = track(r)
  let max = view.max_back(t) * r.cell_h
  let size = int.min(len, int.max(r.cell_h, len * t.rows / (view.max_back(t) + t.rows)))
  let pos = back * r.cell_h + shift
  let y0 = top + (len - size) * (max - pos) / int.max(1, max)
  (y0, y0 + size)
}

/// Where the view is scrolled to, pixels back, with the thumb's top at `y`.
fn scroll_pos_at(r: surface.Renderer, t: terminal.Terminal, y: Int) -> Int = {
  let (top, len) = track(r)
  let max = view.max_back(t) * r.cell_h
  let (y0, y1) = thumb(r, t, 0, 0)
  let room = int.max(1, len - (y1 - y0))
  int.clamp(max - (y - top) * max / room, 0, max)
}

/// Whether pixel column `x` is on the scrollbar: the right margin of the
/// pane in `r.box`, while there is scrollback to scroll.
fn on_scrollbar(r: surface.Renderer, t: terminal.Terminal, x: Int) -> Bool = {
  let right = r.box.0 + r.box.2
  view.max_back(t) > 0 and x >= right - int.max(r.pad_x, scrollbar_width(r) * 3) and x < right
}

/// The tab bar: one tab per title, `active` raised to the terminal's
/// background with an accent line, the others on a darker strip. Returns the
/// quads it pushed.
fn draw_tabs(mut r: surface.Renderer, titles: List[List[Int]], active: Int, width: Int, sx: Float, sy: Float) -> Int = {
  let h = surface.bar_height(r)
  let count = list.len(titles)
  ink.rect(r, 0, 0, width, h, r.theme.tab_bar, 1.0, sx, sy)
  var n = 1
  for i in 0..<count {
    let x0 = i * width / count
    let x1 = (i + 1) * width / count
    n = n + draw_tab_back(r, i, active, x0, x1, h, sx, sy)
    n = n + draw_title(r, titles[i], x0, x1, (h - r.cell_h) / 2 + r.baseline, if i == active then r.theme.fg else r.theme.tab_dim, sx, sy)
  }
  n
}

/// Tab `i`'s background: the window's with an accent on top for the active
/// one, a rule before the others (none beside the active one). How many
/// quads.
fn draw_tab_back(mut r: surface.Renderer, i: Int, active: Int, x0: Int, x1: Int, h: Int, sx: Float, sy: Float) -> Int =
  if i == active then {
    ink.rect(r, x0, 0, x1, h, r.theme.bg, 1.0, sx, sy)
    ink.rect(r, x0, 0, x1, int.max(2, r.line_w), r.theme.accent, 1.0, sx, sy)
    2
  } else if i > 0 and i != active + 1 then {
    ink.rect(r, x0, h / 4, x0 + int.max(1, r.line_w / 2), h - h / 4, r.theme.tab_rule, 1.0, sx, sy)
    1
  } else 0

/// A title, centred between `x0` and `x1`, cut to the tab with room to
/// spare on each side. How many quads.
fn draw_title(mut r: surface.Renderer, title: List[Int], x0: Int, x1: Int, baseline: Int, color: Int, sx: Float, sy: Float) -> Int = {
  let room = int.max(1, (x1 - x0) / r.cell_w - 2)
  let shown = if list.len(title) > room then list.take(title, int.max(1, room - 1)) + [0x2026] else title
  var w = 0
  for cp in shown {
    w = w + advance(r, cp)
  }
  var pen = x0 + (x1 - x0 - w) / 2
  var n = 0
  for cp in shown {
    let slot = ink.glyph(r, cp, false)
    if slot >= 0 then {
      ink.glyph_quad(r, slot, pen, baseline, color, 1.0, sx, sy)
      n = n + 1
    }
    pen = pen + advance(r, cp)
  }
  n
}

/// How far a title's pen moves past `cp`.
// FIXME(almide#3154): a local closure in `draw_title` once one may capture its
// `mut` renderer.
fn advance(r: surface.Renderer, cp: Int) -> Int = r.cell_w * int.max(1, cell_width.of(cp))
