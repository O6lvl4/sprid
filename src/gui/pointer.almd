// The pointer: the wheel, the scrollbar, where it is in the grid.

import snaidhm.native.window as window
import self.gui.render
import self.keys
import self.pty
import self.terminal
import self.view
import self.gui.tabset
import self.gui.uistate

/// Whether a mouse input goes to the program: it asked for the mouse (in SGR
/// form), Shift isn't held, and the pointer is not on the tab bar — or it
/// ends a press the program was sent.
fn app_mouse(t: terminal.Terminal, ui: uistate.Ui, r: render.Renderer, scale: Float, tabs: Int, kind: Int) -> Bool = {
  let wanted = t.mouse_mode != 0 and t.mouse_sgr and int.band(window.event_mods(), window.MOD_SHIFT) == 0
  let on_bar = tabs > 1 and float.to_int(window.event_y() * scale) < render.bar_height(r)
  (wanted and not on_bar and not ui.dragging and ui.tab_drag < 0) or (kind == window.MOUSE_UP and ui.app_button >= 0)
}

/// The wheel moved `dy` logical pixels (positive: toward the end) over cell
/// (`col`, `row`). Scrollback follows it by the pixel — a trackpad moves the
/// text with the fingers, not a line at a time once a line's worth adds up.
/// A program that asked for the mouse is told of it a line at a time, and a
/// full-screen one without the mouse gets arrow keys.
fn wheel(mut cur: tabset.Tab, mut ui: uistate.Ui, r: render.Renderer, scale: Float, dy: Float, col: Int, row: Int) -> Unit = {
  let reports = cur.t.mouse_mode != 0 and cur.t.mouse_sgr
  if not reports and not cur.t.alt then wheel_scroll(cur, ui, r, dy * scale)
  else wheel_lines(cur, ui, r, scale, dy, reports, col, row)
}

/// Scrollback moved by `px` pixels (positive: toward the end).
fn wheel_scroll(mut cur: tabset.Tab, mut ui: uistate.Ui, r: render.Renderer, px: Float) -> Unit = {
  ui.wheel_acc = ui.wheel_acc + px
  let whole = float.to_int(ui.wheel_acc)
  ui.wheel_acc = ui.wheel_acc - int.to_float(whole)
  if whole < 0 then terminal.settle(cur.t)
  let pos = int.clamp(cur.back * r.cell_h + cur.shift - whole, 0, view.max_back(cur.t) * r.cell_h)
  if pos != cur.back * r.cell_h + cur.shift then {
    cur.back = pos / r.cell_h
    cur.shift = pos % r.cell_h
    ui.dirty = true
  }
}

/// The program told of the wheel a line at a time: as mouse reports when
/// it asked for them, else as arrow keys. All of a move in one write: the
/// program reads them together.
fn wheel_lines(mut cur: tabset.Tab, mut ui: uistate.Ui, r: render.Renderer, scale: Float, dy: Float, reports: Bool, col: Int, row: Int) -> Unit = {
  ui.wheel_acc = ui.wheel_acc + dy
  let line_px = int.to_float(r.cell_h) / scale
  let lines = float.to_int(ui.wheel_acc / line_px)
  ui.wheel_acc = ui.wheel_acc - int.to_float(lines) * line_px
  if lines != 0 then {
    let one = if reports then "\x1b[<${int.to_string(if lines < 0 then 64 else 65)};${int.to_string(col + 1)};${int.to_string(row + 1)}M"
      else keys.encode(keys.KEY, if lines < 0 then keys.KEY_UP else keys.KEY_DOWN, 0, cur.t.app_cursor)
    let _ = pty.write(cur.fd, string.repeat(one, int.abs(lines)))
  }
}

/// Scroll to where the pointer puts the scrollbar's thumb.
fn drag_scrollbar(mut cur: tabset.Tab, mut ui: uistate.Ui, r: render.Renderer, scale: Float, tabs: Int) -> Unit = {
  terminal.settle(cur.t)
  let py = float.to_int(window.event_y() * scale)
  let pos = render.scroll_pos_at(r, cur.t, tabs, window.height(), py - ui.scroll_grab)
  if pos != cur.back * r.cell_h + cur.shift then {
    cur.back = pos / r.cell_h
    cur.shift = pos % r.cell_h
    ui.dirty = true
  }
}

/// The line under the pointer, as `tb` is scrolled.
fn pointer_line(r: render.Renderer, tb: tabset.Tab, scale: Float, tabs: Int) -> Int = {
  let py = float.to_int(window.event_y() * scale)
  // The viewport's top line starts `shift` pixels below the grid's top; the
  // line above it shows in those pixels.
  let rel = py - render.grid_top(r, tabs) - tb.shift
  let row = if rel < 0 then (if tb.shift > 0 then -1 else 0) else int.min(rel / r.cell_h, tb.t.rows - 1)
  view.top_line(tb.t, tb.back) + row
}

/// The cell under the pointer: (column, row of the viewport).
fn cell_at(r: render.Renderer, t: terminal.Terminal, scale: Float, tabs: Int) -> (Int, Int) = {
  let px = float.to_int(window.event_x() * scale)
  let py = float.to_int(window.event_y() * scale)
  let gy = render.grid_top(r, tabs)
  (int.clamp((px - r.pad_x) / r.cell_w, 0, t.cols - 1), int.clamp((py - gy) / r.cell_h, 0, t.rows - 1))
}
