// The window's input state, and what an input asks of the tabs.

import snaidhm.native.window as window
import self.links
import self.gui.render
import self.search
import self.field
import self.view

/// Window-wide input state.
type Ui = {
  preedit: List[Int],
  // Where the input method's caret is in it, and the part it is converting
  // ([from, to), empty when none), in characters.
  preedit_caret: Int,
  preedit_from: Int,
  preedit_to: Int,
  wheel_acc: Float,
  // Selecting with the pointer: by cell, word or line (`view.unit_span`),
  // from what the press took — its first and last cell.
  dragging: Bool,
  unit: Int,
  // Option was held at the press: a rectangle is selected.
  rect: Bool,
  anchor_line: Int,
  anchor_col: Int,
  anchor_end_line: Int,
  anchor_end_col: Int,
  // Presses on the grid in a row, to tell a double and a triple click: how
  // many, and the cell of the last.
  clicks: Int,
  click_line: Int,
  click_col: Int,
  dirty: Bool,
  // Renaming the active tab: what its name reads so far.
  renaming: Bool,
  draft: String,
  // The last press, when; on the tab bar, which tab (-1: on the grid).
  click_ms: Int,
  click_tab: Int,
  // A tab being dragged by its title: where it is now, -1 when none is.
  tab_drag: Int,
  // The tab under the pointer (-1: none), and whether the pointer is on
  // its close button: the button shows on it, lit while pointed at.
  hover_tab: Int,
  hover_close: Bool,
  // The button held in a press reported to the program, -1 when none, and
  // the cell the pointer was last reported at.
  app_button: Int,
  report_col: Int,
  report_row: Int,
  // The link under the pointer while Cmd is held (Ctrl on Linux), drawn
  // underlined; the pointer's shape now (snaidhm's POINTER_*).
  link: Option[links.Link],
  pointer: Int,
  // $HOME, which titles show as "~".
  home: String,
  // Find (Cmd+F): whether its bar is open, and the search. The search
  // stays when the bar closes, for Cmd+G and the next Cmd+F.
  finding: Bool,
  find: search.Find,
  // The bar's text field, whether it has the focus (typing goes to it, not
  // the program; a click on the terminal gives the focus back), and whether
  // a drag in it is selecting.
  field: field.Field,
  find_focus: Bool,
  field_drag: Bool,
  // Dragging the scrollbar, and where in its thumb it was taken, pixels.
  scroll_drag: Bool,
  scroll_grab: Int,
  // Where the input method was last told the caret is.
  ime_x: Int,
  ime_y: Int,
}

/// What an input asks of the tabs.
/// `CloseTab` closes the pane in front, its tab with it when it is the
/// last; `CloseTabAt(i)` tab `i` whole, panes and all (its close button).
/// `Zoom` changes the font size by that many points, or with 0 resets it;
/// `Restyle` follows the system's light or dark appearance; `Focus` the
/// window gaining or losing the keyboard.
type Act = | Stay | NewTab | CloseTab | CloseTabAt(Int) | NextTab | PrevTab | GoTo(Int) | NewWindow | CloseWindow | Zoom(Int) | Restyle | Focus(Bool) | Paste | PastePrimary | Selected | Menu | MoveTab(Int) | DetachTab
  | SplitPane(Bool) | FocusPane(Int, Int) | CyclePane(Int) | ResizePane(Int, Int) | ZoomPane | EqualPanes

/// The find bar as drawn.
fn bar(ui: Ui) -> render.Bar = render.Bar { find: ui.find, field: ui.field, focused: ui.find_focus }

fn bar_of(ui: Ui) -> Option[render.Bar] = if ui.finding then some(bar(ui)) else none

/// The input method's composition, as drawn.
fn compose_of(ui: Ui) -> render.Compose =
  render.Compose { cps: ui.preedit, caret: ui.preedit_caret, from: ui.preedit_from, to: ui.preedit_to }

/// End what belonged to the tab that was in front: its find bar and
/// search, a rename, a drag or a press reported to its program.
fn leave_tab(mut ui: Ui) -> Unit = {
  ui.finding = false
  ui.find_focus = false
  ui.find = search.empty()
  ui.field = field.of("")
  ui.renaming = false
  ui.draft = ""
  ui.dragging = false
  ui.app_button = -1
  ui.scroll_drag = false
  ui.field_drag = false
  ui.link = none
  ui.dirty = true
}

/// What the pointer holds let go: a drag selecting, the scrollbar, the find
/// bar's field, a tab held by its title, a press reported to the program.
fn let_go(mut ui: Ui) -> Unit = {
  ui.dragging = false
  ui.scroll_drag = false
  ui.field_drag = false
  ui.tab_drag = -1
  ui.app_button = -1
  ui.dirty = true
}

/// The pointer's shape, set.
fn shape_pointer(mut ui: Ui, shape: Int) -> Unit =
  if shape != ui.pointer then {
    window.set_pointer(shape)
    ui.pointer = shape
  }

/// Where the input method was told the caret is.
fn set_ime(mut ui: Ui, x: Int, y: Int) -> Unit = {
  ui.ime_x = x
  ui.ime_y = y
}
