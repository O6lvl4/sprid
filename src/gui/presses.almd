// Presses, drags and releases: on the find bar, the scrollbar, the tab bar
// and the grid — or, when the program asked for the mouse, reported to it.

import env
import fs
import self.links
import snaidhm.native.window as window
import self.gui.render
import self.field
import self.pty
import self.sys
import self.view
import self.gui.tabset
import self.gui.uistate
import self.gui.findkeys
import self.gui.pointer
import self.gui.tabbar
import self.gui.place

fn on_bar(ui: uistate.Ui, p: place.Place) -> Bool = render.on_bar(p.r, uistate.bar(ui), p.tabs, p.width, place.px(p), place.py(p))

/// A mouse input `kind` on tab `cur`; what it asks of the tabs.
effect fn mouse(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int, p: place.Place) -> uistate.Act =
  if kind == window.MOUSE_DOWN and window.event_code() == 0 and link_click() and open_link(cur, p)! then uistate.Stay
  else if ui.tab_drag >= 0 and (kind == window.MOUSE_MOVE or kind == window.MOUSE_UP) then tabbar.held(ui, kind, p)
  else if off_grid(cur, ui, kind, p) then uistate.Stay
  else if kind == window.MOUSE_DOWN then button_down(cur, ui, p)!
  else if kind == window.MOUSE_MOVE and ui.dragging then {
    drag_select(cur, ui, p)
    uistate.Stay
  }
  else if kind == window.MOUSE_UP then release(cur, ui)
  else uistate.Stay

/// A button pressed on the grid.
effect fn button_down(mut cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> uistate.Act = match window.event_code() {
  0 => press(cur, ui, p)!,
  // A right click: copy, paste, select all, find, clear.
  1 => uistate.Menu,
  // A middle click pastes the PRIMARY selection, as X11 has it.
  2 => if sys.is_linux() then uistate.PastePrimary else uistate.Stay,
  _ => uistate.Stay,
}

/// A button released: a selecting drag ends, with the selection made — for
/// copy-on-select.
fn release(cur: tabset.Tab, mut ui: uistate.Ui) -> uistate.Act =
  if window.event_code() == 0 and ui.dragging then {
    ui.dragging = false
    if cur.sel != none then uistate.Selected else uistate.Stay
  } else uistate.Stay

/// The pointer moved: the link under it found while Cmd is held, and the
/// pointer shaped for where it is — a hand on a link, the I-beam on the
/// grid, the arrow on the tab bar and the scrollbar.
fn hover(cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> Unit = {
  let on_grid = not (p.tabs > 1 and place.py(p) < render.bar_height(p.r)) and not render.on_scrollbar(p.r, cur.t, place.px(p))
  let link = if on_grid and link_click() then {
    let (col, _) = pointer.cell_at(p.r, cur.t, p.scale, p.tabs)
    links.link_at(cur.t, pointer.pointer_line(p.r, cur, p.scale, p.tabs), col)
  } else none
  if link != ui.link then {
    ui.link = link
    ui.dirty = true
  }
  let shape = if link != none then window.POINTER_LINK else if on_grid then window.POINTER_TEXT else window.POINTER_ARROW
  if shape != ui.pointer then {
    window.set_pointer(shape)
    ui.pointer = shape
  }
}

/// Whether a press opens what it is on: Cmd held, Ctrl on Linux — and
/// nothing else, so Cmd+Shift and the like stay presses.
fn link_click() -> Bool =
  window.event_mods() == (if sys.is_linux() then window.MOD_CTRL else window.MOD_SUPER)

/// The URL or file under the pointer opened as the desktop does; whether
/// there was one. Even where the program has the mouse: the press is the
/// window's.
effect fn open_link(cur: tabset.Tab, p: place.Place) -> Bool = {
  let (col, _) = pointer.cell_at(p.r, cur.t, p.scale, p.tabs)
  let line = pointer.pointer_line(p.r, cur, p.scale, p.tabs)
  match links.link_at(cur.t, line, col) {
    some(l) => match target_of(cur, l)! {
      some(target) => sys.open_target(target),
      none => false,
    },
    none => false,
  }
}

/// What to open for link `l`: a URL as it is, a path from the tab's working
/// directory (or home, for `~/`) when the file is there.
effect fn target_of(cur: tabset.Tab, l: links.Link) -> Option[String] =
  if l.url then some(l.target)
  else {
    let home = env.get("HOME") ?? ""
    let dir = if cur.t.cwd != "" then cur.t.cwd else pty.cwd(cur.fd)
    let path = if string.starts_with(l.target, "~/") then home + string.drop(l.target, 1)
      else if string.starts_with(l.target, "/") then l.target
      else dir + "/" + l.target
    if fs.exists(path) then some(path) else none
  }

/// An input that isn't the grid's to select with: on the find bar, on the
/// scrollbar, or the program's. Whether it was one, done.
fn off_grid(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int, p: place.Place) -> Bool = {
  let done = if kind == window.MOUSE_DOWN then window.event_code() == 0 and press_off_grid(cur, ui, p)
    else held_off_grid(cur, ui, kind, p)
  if done then true
  else if pointer.app_mouse(cur.t, ui, p.r, p.scale, p.tabs, kind) then {
    report(cur, ui, kind, p)
    true
  } else false
}

/// A left press on the find bar or the scrollbar, done; whether it was.
fn press_off_grid(mut cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> Bool =
  if ui.finding and on_bar(ui, p) then {
    press_bar(ui, p)
    true
  } else if render.on_scrollbar(p.r, cur.t, place.px(p)) then {
    press_scrollbar(cur, ui, p)
    true
  } else false

/// A move or release in a drag begun on the find bar or the scrollbar,
/// done; whether it was.
fn held_off_grid(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int, p: place.Place) -> Bool =
  if kind != window.MOUSE_MOVE and kind != window.MOUSE_UP then false
  else if ui.field_drag then {
    drag_bar(ui, p, kind)
    true
  } else if ui.scroll_drag then {
    pointer.drag_scrollbar(cur, ui, p.r, p.scale, p.tabs)
    if kind == window.MOUSE_UP then ui.scroll_drag = false
    true
  } else false

/// A press on the find bar focuses it and puts the caret there (Shift:
/// selects to there); a drag selects.
fn press_bar(mut ui: uistate.Ui, p: place.Place) -> Unit = {
  let at = render.field_index_at(p.r, uistate.bar(ui), p.tabs, p.width, place.px(p))
  ui.field = field.move_to(ui.field, at, int.band(window.event_mods(), window.MOD_SHIFT) != 0)
  ui.find_focus = true
  ui.field_drag = true
  ui.dirty = true
}

fn drag_bar(mut ui: uistate.Ui, p: place.Place, kind: Int) -> Unit = {
  let at = render.field_index_at(p.r, uistate.bar(ui), p.tabs, p.width, place.px(p))
  if at != ui.field.caret then {
    ui.field = field.move_to(ui.field, at, true)
    ui.dirty = true
  }
  if kind == window.MOUSE_UP then ui.field_drag = false
}

/// The scrollbar: its thumb is dragged from where it was taken; a press on
/// the track brings the thumb's middle there.
fn press_scrollbar(mut cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> Unit = {
  let y = place.py(p)
  let (y0, y1) = render.thumb(p.r, cur.t, cur.back, cur.shift)
  ui.scroll_grab = if y >= y0 and y < y1 then y - y0 else (y1 - y0) / 2
  ui.scroll_drag = true
  pointer.drag_scrollbar(cur, ui, p.r, p.scale, p.tabs)
}

/// The program asked for the mouse: presses, releases and motion are its,
/// as SGR reports. Shift held keeps them the window's, for selecting text
/// as anywhere else.
fn report(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int, p: place.Place) -> Unit = {
  let (col, row) = pointer.cell_at(p.r, cur.t, p.scale, p.tabs)
  let mods = window.event_mods()
  // Modifier bits of a report: Alt 8, Ctrl 16 (Shift is the window's).
  let held = (if int.band(mods, window.MOD_ALT) != 0 then 8 else 0)
    + (if int.band(mods, window.MOD_CTRL) != 0 then 16 else 0)
  let at = ";${int.to_string(col + 1)};${int.to_string(row + 1)}"
  if kind == window.MOUSE_DOWN then {
    // The window's buttons are left 0, right 1, middle 2; a report's left
    // 0, middle 1, right 2.
    let code = window.event_code()
    let button = if code == 1 then 2 else if code == 2 then 1 else 0
    ui.app_button = button
    let _ = pty.write(cur.fd, "\x1b[<${int.to_string(button + held)}${at}M")
  } else if kind == window.MOUSE_UP then {
    if ui.app_button >= 0 then {
      let _ = pty.write(cur.fd, "\x1b[<${int.to_string(ui.app_button + held)}${at}m")
    }
    ui.app_button = -1
  } else if (col, row) != (ui.report_col, ui.report_row) then report_motion(cur, ui, held, at)
  ui.report_col = col
  ui.report_row = row
}

/// Motion: with a button held under 1002 and 1003, without one only under
/// 1003; once per cell.
fn report_motion(cur: tabset.Tab, ui: uistate.Ui, held: Int, at: String) -> Unit =
  if ui.app_button >= 0 and cur.t.mouse_mode >= 1002 then {
    let _ = pty.write(cur.fd, "\x1b[<${int.to_string(ui.app_button + 32 + held)}${at}M")
  } else if ui.app_button < 0 and cur.t.mouse_mode == 1003 then {
    let _ = pty.write(cur.fd, "\x1b[<${int.to_string(35 + held)}${at}M")
  }

/// A left press on the window: a tab (a double click renames it) or the
/// grid. A press anywhere ends a rename, keeping the draft.
effect fn press(mut cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> uistate.Act = {
  if ui.renaming then findkeys.finish_rename(cur, ui, true)
  if p.tabs > 1 and place.py(p) < render.bar_height(p.r) then tabbar.press(cur, ui, render.tab_at(p.r, place.px(p), p.width, p.tabs))
  else {
    press_grid(cur, ui, p)!
    uistate.Stay
  }
}

/// A press on the grid. On the cell just pressed, soon enough, it counts
/// on: the second selects the word there, the third the line; a fourth
/// stays with the line.
effect fn press_grid(mut cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> Unit = {
  let (col, _) = pointer.cell_at(p.r, cur.t, p.scale, p.tabs)
  let line = pointer.pointer_line(p.r, cur, p.scale, p.tabs)
  let now = sys.now_ms()
  let again = ui.click_tab < 0 and ui.clicks > 0 and now - ui.click_ms < place.DOUBLE_CLICK_MS
    and line == ui.click_line and col == ui.click_col
  ui.clicks = if again then int.min(ui.clicks + 1, 3) else 1
  ui.click_ms = now
  ui.click_tab = -1
  ui.click_line = line
  ui.click_col = col
  ui.unit = ui.clicks - 1
  ui.rect = ui.unit == 0 and int.band(window.event_mods(), window.MOD_ALT) != 0
  // SPRID_TRACE: where a press lands, to check it against the pointer.
  if env.get("SPRID_TRACE") != none then eprintln("press y ${float.to_string(window.event_y())} scale ${float.to_string(p.scale)} grid_top ${int.to_string(render.grid_top(p.r, p.tabs))} cell_h ${int.to_string(p.r.cell_h)} shift ${int.to_string(cur.shift)} back ${int.to_string(cur.back)} -> line ${int.to_string(line - view.top_line(cur.t, cur.back))} col ${int.to_string(col)}")
  let (l0, c0, l1, c1) = view.unit_span(cur.t, ui.unit, line, col)
  ui.anchor_line = l0
  ui.anchor_col = c0
  ui.anchor_end_line = l1
  ui.anchor_end_col = c1
  ui.dragging = true
  let sel = if ui.unit == 0 then none
    else some(view.Selection { anchor_line: l0, anchor_col: c0, head_line: l1, head_col: c1, rect: false })
  if sel != cur.sel then ui.dirty = true
  cur.sel = sel
}

/// A drag selecting. By cell, a click that wobbles within its cell selects
/// nothing: a selection starts once the pointer reaches another cell. By
/// word or line, the selection spans what the press took and what the
/// pointer is on, whole.
fn drag_select(mut cur: tabset.Tab, mut ui: uistate.Ui, p: place.Place) -> Unit = {
  let (col, _) = pointer.cell_at(p.r, cur.t, p.scale, p.tabs)
  let line = pointer.pointer_line(p.r, cur, p.scale, p.tabs)
  let (h0, c0, h1, c1) = view.unit_span(cur.t, ui.unit, line, col)
  let before = h0 < ui.anchor_line or (h0 == ui.anchor_line and c0 < ui.anchor_col)
  let sel = if ui.unit == 0 and line == ui.anchor_line and col == ui.anchor_col then none
    else if ui.unit == 0 then some(view.Selection { anchor_line: ui.anchor_line, anchor_col: ui.anchor_col, head_line: line, head_col: col, rect: ui.rect })
    else if before then some(view.Selection { anchor_line: ui.anchor_end_line, anchor_col: ui.anchor_end_col, head_line: h0, head_col: c0, rect: false })
    else some(view.Selection { anchor_line: ui.anchor_line, anchor_col: ui.anchor_col, head_line: h1, head_col: c1, rect: false })
  if sel != cur.sel then {
    cur.sel = sel
    ui.dirty = true
  }
}
