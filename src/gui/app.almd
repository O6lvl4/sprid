// sprid in a window: shells on PTYs, in tabs, drawn with snaidhm.
//
// One loop on the main thread (macOS wants its event loop there): pump the
// window's events, turn keys into bytes for the active tab's PTY, read what
// every tab's program wrote, and draw the active tab when it changed. The
// loop sleeps on the window and every PTY at once (snaidhm's `wait_fds`), so
// it runs only when there is something to do.
//
// Tabs live in a list. A tab is worked on by taking it out (swap it to the
// end and pop it) and pushing it back: indexing would copy it, and with it
// every buffer the tab's terminal writes to next. `list.swap` returns the
// swapped list; assigning it back keeps the tabs uniquely owned.

import bytes
import env
import fs
import snaidhm.native.window as window
import snaidhm.native.frame as frame
import snaidhm.text as text
import snaidhm.web.gpu as gpu
import self.gui.dialog
import self.gui.fonts
import self.gui.composition
import self.gui.findbar
import self.gui.render
import self.keys
import self.pty
import self.scrollback
import self.search
import self.field
import self.config
import self.settings
import self.theme
import self.sys
import self.terminal
import self.view

/// How often a blinking cursor turns on or off, ms.
let BLINK_MS = 530
/// How long the visual bell lights the screen, ms.
let FLASH_MS = 120
/// Cmd+Minus and Cmd+Plus go no further than these, points.
let MIN_FONT_SIZE = 6.0
let MAX_FONT_SIZE = 72.0

/// Least time between two frames, ms: short while the program answers keys —
/// a shell echoes a key and then redraws the line in colour a few ms later,
/// and the second must not wait a whole refresh — and longer while its output
/// streams in, time the parser can use.
let FRAME_MS = 8
let STREAM_FRAME_MS = 50
/// Longest spent draining the active tab's PTY before the window gets a
/// turn, ms; background tabs get the short budget.
let DRAIN_MS = 12
let STREAM_DRAIN_MS = 40
/// How long the window's size must hold before scrollback is reflowed to it,
/// ms: reflowing a full scrollback takes about 0.2 s, too long for every step
/// of a drag.
let SETTLE_MS = 300
/// Longest a synchronized update (mode 2026) may hold the screen, ms.
let SYNC_LIMIT = 150
/// Longest the screen waits while a program has hidden the cursor to draw, ms.
let HIDDEN_LIMIT = 100
/// How soon input a program hasn't taken is offered again, ms.
let WRITE_RETRY_MS = 5
/// Longest a read waits for the rest of a screen a program is drawing, ms.
let MID_UPDATE_GAP_MS = 10
/// Longest the screen waits for a full-screen program's first screen, ms.
let FIRST_SCREEN_LIMIT = 1000

/// One tab: a terminal, the PTY its program runs on, and how it is viewed.
type Tab = {
  t: terminal.Terminal,
  fd: Int,
  // Lines scrolled back into scrollback, 0 at the bottom, and pixels
  // further back than that: a trackpad scrolls by the pixel.
  back: Int,
  shift: Int,
  sel: Option[view.Selection],
  // The program's updates the frame is held for, and when each began.
  up: Updates,
  // The name the user gave it; "" for the automatic title.
  name: String,
  // A bell or notification came while it wasn't being looked at: its title
  // is marked until it is.
  alert: Bool,
}

/// The latest synchronized update and redraw with the cursor hidden that
/// the tab's program began — by the terminal's counts of them — and when
/// each was first seen, ms. A hold is timed from the start of the update it
/// is for: timed from the first of a run of them, a program that keeps the
/// cursor hidden, drawing in synchronized updates, would soon have none of
/// them held, and its half-drawn screens shown.
type Updates = { syncs: Int, sync_at: Int, hides: Int, hide_at: Int }

/// Window-wide input state.
type Ui = {
  preedit: List[Int],
  // Where the input method's caret is in it, and the part it is converting
  // ([from, to), empty when none), in characters.
  preedit_caret: Int,
  preedit_from: Int,
  preedit_to: Int,
  wheel_acc: Float,
  // Selecting with the pointer: by cell, word or line (`view.unit_span`),
  // from what the press took — its first and last cell.
  dragging: Bool,
  unit: Int,
  anchor_line: Int,
  anchor_col: Int,
  anchor_end_line: Int,
  anchor_end_col: Int,
  // Presses on the grid in a row, to tell a double and a triple click: how
  // many, and the cell of the last.
  clicks: Int,
  click_line: Int,
  click_col: Int,
  dirty: Bool,
  // Renaming the active tab: what its name reads so far.
  renaming: Bool,
  draft: String,
  // The last press, when; on the tab bar, which tab (-1: on the grid).
  click_ms: Int,
  click_tab: Int,
  // The button held in a press reported to the program, -1 when none, and
  // the cell the pointer was last reported at.
  app_button: Int,
  report_col: Int,
  report_row: Int,
  // $HOME, which titles show as "~".
  home: String,
  // Find (Cmd+F): whether its bar is open, and the search. The search
  // stays when the bar closes, for Cmd+G and the next Cmd+F.
  finding: Bool,
  find: search.Find,
  // The bar's text field, whether it has the focus (typing goes to it, not
  // the program; a click on the terminal gives the focus back), and whether
  // a drag in it is selecting.
  field: field.Field,
  find_focus: Bool,
  field_drag: Bool,
  // Dragging the scrollbar, and where in its thumb it was taken, pixels.
  scroll_drag: Bool,
  scroll_grab: Int,
  // Where the input method was last told the caret is.
  ime_x: Int,
  ime_y: Int,
}

/// How the window starts: a command for the first tab instead of the login
/// shell (the window closes when it exits), and the grid to size the window
/// to (0: the default window). `capture` draws one frame to a PNG instead.
type Options = { command: Option[String], cols: Int, rows: Int, capture: Option[String] }

/// What an input asks of the tabs.
/// `Zoom` changes the font size by that many points, or with 0 resets it;
/// `Restyle` follows the system's light or dark appearance; `Focus` the
/// window gaining or losing the keyboard.
type Act = | Stay | NewTab | CloseTab | NextTab | PrevTab | GoTo(Int) | NewWindow | CloseWindow | Zoom(Int) | Restyle | Focus(Bool) | Paste

effect fn run(opts: Options) -> Unit = {
  // Before anything starts a program: the shell, the clipboard's tools.
  sys.ensure_utf8_locale()
  sys.ignore_sigpipe()
  let st = load_settings()!
  run_fonts(opts, st)!
}

effect fn run_fonts(opts: Options, st: settings.Settings) -> Unit = match fonts.find(st.font_family)! {
  some(faces) => run_with(opts, faces, st)!,
  none => println("sprid: no font found"),
}

// ── Config ────────────────────────────────────────────────────────────────

/// Where config lives: $XDG_CONFIG_HOME/sprid, else ~/.config/sprid.
effect fn config_dir() -> String = match env.get("XDG_CONFIG_HOME") {
  some(d) => if d != "" then d + "/sprid" else (env.get("HOME") ?? "") + "/.config/sprid",
  none => (env.get("HOME") ?? "") + "/.config/sprid",
}

effect fn config_path() -> String = config_dir()! + "/config"

/// The settings in the config file (the defaults when there is none); what
/// is wrong with it goes to stderr.
effect fn load_settings() -> settings.Settings = {
  let st = read_settings()!
  report(st)!
  st
}

effect fn read_settings() -> settings.Settings = {
  let text = match fs.read_text_if_exists(config_path()!) {
    ok(found) => found ?? "",
    err(_) => "",
  }
  settings.from(config.parse(text))
}

effect fn report(st: settings.Settings) -> Unit = {
  for p in st.problems {
    eprintln("sprid: ${config_path()!}: ${p}")
  }
}

/// A theme file in the config's format (background, foreground, palette,
/// ...): `name` as a path, or a file of that name in the config's `themes`
/// directory.
effect fn theme_file(name: String) -> Option[theme.Theme] = {
  let path = if string.contains(name, "/") then fonts.expand(name)! else config_dir()! + "/themes/" + name
  match fs.read_text_if_exists(path) {
    ok(found) => match found {
      some(text) => some({ ...theme.apply(theme.default(), config.parse(text)), name: name }),
      none => none,
    },
    err(_) => none,
  }
}

/// The theme for the system's appearance now.
effect fn pick_theme(st: settings.Settings, dark: Bool) -> theme.Theme = {
  let name = if dark then st.theme_dark else st.theme_light
  let file = if theme.named(name) == none then theme_file(name)! else none
  settings.theme_for(st, dark, (n) => file)
}

/// `r` dressed by the settings: the theme for the appearance now, the
/// cursor's default shape; the window's uncovered edge in the theme's
/// background.
effect fn styled(r: render.Renderer, st: settings.Settings) -> render.Renderer = {
  let t = pick_theme(st, window.dark())!
  let (bg_r, bg_g, bg_b) = render.rgb_floats(t.bg)
  window.set_background(bg_r, bg_g, bg_b)
  { ...render.with_theme(r, t), cursor_default: st.cursor_shape }
}

effect fn run_with(opts: Options, faces: fonts.Faces, s: settings.Settings) -> Unit = {
  let capture = opts.capture
  var st = s
  // Sized to a grid, the window is measured before it opens, for a Retina
  // display (the scale is only known once it is open).
  let (cw, ch) = render.cell_size(faces, float.to_int(float.round(st.font_size * 2.0)), st.cell_height)
  let (pad_x, pad_y) = (float.to_int(st.pad_x * 2.0), float.to_int(st.pad_y * 2.0))
  let (win_w, win_h) = if opts.cols > 0 and opts.rows > 0 then
    ((opts.cols * cw) / 2 + pad_x / 2 + 1, (opts.rows * ch) / 2 + pad_y / 2 + 1)
  else (960, 620)
  // Started from Finder there is no $SHELL and the directory is /: take the
  // shell from the password database and start at home.
  let shell = match env.get("SHELL") {
    some(s) => s,
    none => if sys.login_shell() != "" then sys.login_shell() else "/bin/zsh",
  }
  let login = "exec ${shell} -l"
  let first = match opts.command {
    some(c) => c,
    none => match capture { some(_) => env.get("SPRID_CAPTURE_CMD") ?? login, none => login },
  }
  let start_dir = if sys.cwd() == "/" or sys.cwd() == "" then env.get("HOME") ?? "" else ""
  // The first program starts before the window opens and the GPU is set up —
  // a login shell's startup files run meanwhile — on the grid the window is
  // expected to hold; it is told the actual one if that differs.
  let expected = (int.max(1, (win_w * 2 - 2 * pad_x) / cw), int.max(1, (win_h * 2 - 2 * pad_y) / ch))
  let first_fd = pty.spawn(first, start_dir, expected.0, expected.1)
  guard first_fd >= 0 else println("sprid: could not start ${shell}")

  guard window.open("sprid", win_w, win_h) else println("sprid: could not open a window")
  window.set_ime(true)
  // A key's echo shows as soon as it is drawn, not a display refresh or two
  // later.
  gpu.set_low_latency(true)
  window.set_option_as_alt(st.option_as_alt)
  let scale = window.scale_factor()
  let device = 1
  // The theme also colours what a window being resized uncovers, until it is
  // drawn for its size.
  var r = styled(render.new(device, faces, float.to_int(float.round(st.font_size * scale)),
    float.to_int(st.pad_x * scale), float.to_int(st.pad_y * scale), st.cell_height), st)!
  // Opened behind another app's window, it has no focus until clicked.
  r.focused = window.focused()
  var width = window.width()
  var height = window.height()
  var font_size = st.font_size
  // The config file, watched: saved, it applies at once.
  let config_fd = if capture == none then sys.watch(config_path()!) else -1
  // A blinking cursor: when it next turns on or off, -1 when it doesn't blink.
  var blink_at = -1
  // When the visual bell's light goes out; -1 when it is not lit.
  var flash_until = -1

  let (cols, rows) = render.grid_size(r, width, height, 1)
  if (cols, rows) != expected then { let _ = pty.resize(first_fd, cols, rows) } else ()
  var tabs: List[Tab] = [Tab { t: terminal.with_scrollback(cols, rows, st.scrollback), fd: first_fd, back: 0, shift: 0, sel: none, up: Updates { syncs: 0, sync_at: 0, hides: 0, hide_at: 0 }, name: "", alert: false }]
  var active = 0
  // For captures of the tab bar: more tabs running the login shell.
  let extra = match capture { some(_) => int.parse(env.get("SPRID_CAPTURE_TABS") ?? "1") ?? 1, none => 1 }
  for _ in 1..<extra {
    match open_tab(r, width, height, list.len(tabs) + 1, login, "", st.scrollback) {
      some(tb) => {
        list.push(tabs, tb)
        relayout(tabs, r, width, height)
      },
      none => (),
    }
  }

  let home = env.get("HOME") ?? ""
  // Questions in Japanese on a Japanese system.
  let ja = string.starts_with(env.get("LANG") ?? "", "ja")
  var ui = Ui { preedit: [], preedit_caret: 0, preedit_from: 0, preedit_to: 0, wheel_acc: 0.0, dragging: false, unit: 0, anchor_line: 0, anchor_col: 0,
                anchor_end_line: 0, anchor_end_col: 0, clicks: 0, click_line: 0, click_col: 0, dirty: true,
                renaming: false, draft: "", click_ms: 0, click_tab: -1, home: home, finding: false, find: search.empty(),
                field: field.of(""), find_focus: false, field_drag: false, scroll_drag: false, scroll_grab: 0,
                ime_x: -1, ime_y: -1,
                app_button: -1, report_col: -1, report_row: -1 }
  var alive = true
  var last_frame = 0
  var streaming = false
  let debug = env.get("SPRID_DEBUG") != none
  let trace = env.get("SPRID_TRACE") != none
  var frames = 0
  var draw_ms = 0
  var wakes = 0
  var wake_report = 0
  // Debug: from an input being taken to the frame showing it, ms.
  var input_at = -1
  var latency_max = 0
  var latency_sum = 0
  var latency_n = 0
  // When the window last changed size, while scrollback waits to be
  // reflowed; -1 when it doesn't.
  var resized_at = -1
  // The PTY of the tab in front, to tell when another comes to the front.
  var front = first_fd
  // The window's title: the tab in front's.
  var window_title = ""
  // Debug: SPRID_AUTOSCROLL="dy,start ms,end ms,every ms" turns the wheel by
  // itself, for measuring scrolling without a hand on the trackpad.
  let auto = list.map(string.split(env.get("SPRID_AUTOSCROLL") ?? "", ","), (x) => float.parse(x) ?? 0.0)
  var auto_next = if list.len(auto) == 4 then float.to_int(auto[1]) else -1
  while alive {
    // Sleep until input, output on any tab, or the next frame is due: with
    // nothing to draw that is indefinitely, so an idle window costs nothing.
    let now = sys.now_ms()
    let frame_wait = int.max(0, last_frame + (if streaming then STREAM_FRAME_MS else FRAME_MS) - now)
    let idle = if capture == none then -1 else 50
    let settle_wait = if resized_at < 0 then -1 else int.max(0, resized_at + SETTLE_MS - now)
    let drawn_wait = if ui.dirty then int.max(frame_wait, sync_wait(tabs, active, now)) else idle
    let auto_wait = if auto_next < 0 then -1 else int.max(0, auto_next - now)
    // Input a program hasn't taken yet (a big paste) is offered again soon.
    let write_wait = if list.any(tabs, (tb) => pty.pending(tb.fd)) then WRITE_RETRY_MS else -1
    // A blinking cursor turns on and off while the window has the focus.
    if r.focused and cursor_blinks(tabs, active, r) then {
      if blink_at < 0 then blink_at = now + BLINK_MS
      else if now >= blink_at then {
        r.blink_off = not r.blink_off
        blink_at = now + BLINK_MS
        ui.dirty = true
      }
    } else {
      blink_at = -1
      r.blink_off = false
    }
    let blink_wait = if blink_at < 0 then -1 else int.max(0, blink_at - now)
    if flash_until >= 0 and now >= flash_until then {
      r.flash = false
      flash_until = -1
      ui.dirty = true
    }
    let flash_wait = if flash_until < 0 then -1 else int.max(0, flash_until - now)
    let timeout = sooner(sooner(sooner(sooner(sooner(drawn_wait, settle_wait), auto_wait), write_wait), blink_wait), flash_wait)
    // With no time to wait, just take the window's events: arming the fd
    // watcher on every turn of a streaming loop costs more than it saves.
    alive = if timeout == 0 then window.pump() else window.wait_fds(list.map(tabs, (tb) => tb.fd) + (if config_fd >= 0 then [config_fd] else []), timeout)
    // The config file was saved: it applies now — the theme, the font and
    // its size, the cursor, Option — over what was set before.
    // (One save can be seen more than once — the file, then its directory.)
    let saved = sys.watch_changed(config_fd)
    let fresh = if saved then read_settings()! else st
    if saved and fresh != st then {
      report(fresh)!
      let new_faces = fresh.font_family != st.font_family
      let resize = new_faces or (fresh.font_size, fresh.pad_x, fresh.pad_y, fresh.cell_height) != (st.font_size, st.pad_x, st.pad_y, st.cell_height)
      st = fresh
      window.set_option_as_alt(st.option_as_alt)
      if new_faces then {
        match fonts.find(st.font_family)! {
          some(f) => {
            r = { ...render.new(device, f, float.to_int(float.round(st.font_size * scale)),
              float.to_int(st.pad_x * scale), float.to_int(st.pad_y * scale), st.cell_height), focused: r.focused }
          },
          none => (),
        }
      }
      r = styled(r, st)!
      if resize then {
        font_size = st.font_size
        r = render.with_size(r, float.to_int(float.round(font_size * scale)),
          float.to_int(st.pad_x * scale), float.to_int(st.pad_y * scale), st.cell_height)
        relayout_live(tabs, r, width, height)
        resized_at = sys.now_ms()
      }
      ui.dirty = true
    }
    // The window's close button: asked first when a program is running.
    if not alive and list.len(tabs) > 0 and capture == none and not may_close_window(tabs, ja) then {
      window.keep_open()
      alive = true
    }
    wakes = wakes + 1
    if debug and sys.now_ms() - wake_report >= 2000 then {
      eprintln("sprid: ${int.to_string(wakes)} wakes in 2 s (dirty ${if ui.dirty then "yes" else "no"}, timeout ${int.to_string(timeout)})"
        + ", input to frame avg ${int.to_string(latency_sum / int.max(1, latency_n))} max ${int.to_string(latency_max)} ms over ${int.to_string(latency_n)}")
      latency_max = 0
      latency_sum = 0
      latency_n = 0
      wakes = 0
      wake_report = sys.now_ms()
    }
    if window.resized() then {
      width = window.width()
      height = window.height()
      relayout_live(tabs, r, width, height)
      resized_at = sys.now_ms()
      ui.dirty = true
    }
    // Once the size has held for a moment, scrollback is reflowed too.
    if resized_at >= 0 and sys.now_ms() - resized_at >= SETTLE_MS then {
      settle_all(tabs)
      resized_at = -1
      ui.dirty = true
      // Lines are numbered anew: the search is run again.
      match take(tabs, active) {
        some(tb) => {
          var cur = tb
          refresh_find(cur, ui)
          list.push(tabs, cur)
          tabs = list.swap(tabs, active, list.len(tabs) - 1)
        },
        none => (),
      }
    }

    // Input goes to the active tab; what it asks of the tabs is done after
    // the tab is back in the list.
    var kind = window.next_event()
    // Typing shows the cursor at once and starts its blink over.
    if kind == window.KEY or kind == window.TEXT then {
      r.blink_off = false
      if blink_at >= 0 then blink_at = sys.now_ms() + BLINK_MS
    }
    if kind != window.NONE and input_at < 0 then input_at = sys.now_ms()
    while kind != window.NONE {
      var act = Stay
      if trace and (kind == window.COMPOSE or kind == window.TEXT or kind == window.KEY) then
        eprintln("input ${int.to_string(sys.now_ms())} kind ${int.to_string(kind)} code ${int.to_string(window.event_code())} end ${int.to_string(window.event_end())} text \"${window.event_text()}\" preedit ${int.to_string(list.len(ui.preedit))}")
      // Counted before the active tab is taken out of the list: with it out,
      // two tabs looked like one — no tab bar to click, and every click
      // below it placed a tab bar's height too low.
      let open = list.len(tabs)
      match take(tabs, active) {
        some(tb) => {
          var cur = tb
          act = handle(cur, ui, kind, r, scale, open, width)!
          list.push(tabs, cur)
          tabs = list.swap(tabs, active, list.len(tabs) - 1)
        },
        none => (),
      }
      match act {
        NewTab => {
          let cwd = cwd_of(tabs, active, env.get("HOME") ?? "")
          match open_tab(r, width, height, list.len(tabs) + 1, login, cwd, st.scrollback) {
            some(tb) => {
              list.push(tabs, tb)
              active = list.len(tabs) - 1
              relayout(tabs, r, width, height)
            },
            none => (),
          }
          ui.dirty = true
        },
        CloseTab => if may_close_tab(tabs, active, ja) then {
          close_tab(tabs, active)
          active = int.min(active, list.len(tabs) - 1)
          relayout(tabs, r, width, height)
          ui.dirty = true
        },
        NextTab => {
          active = (active + 1) % list.len(tabs)
          ui.dirty = true
        },
        PrevTab => {
          active = (active + list.len(tabs) - 1) % list.len(tabs)
          ui.dirty = true
        },
        GoTo(i) => if i < list.len(tabs) and i != active then {
          active = i
          ui.dirty = true
        },
        NewWindow => {
          let _ = sys.open_window(cwd_of(tabs, active, home))
        },
        CloseWindow => if may_close_window(tabs, ja) then alive = false,
        Zoom(step) => {
          let size = if step == 0 then st.font_size
            else float.clamp(font_size + int.to_float(step), MIN_FONT_SIZE, MAX_FONT_SIZE)
          if size != font_size then {
            font_size = size
            r = render.with_size(r, float.to_int(float.round(font_size * scale)),
              float.to_int(st.pad_x * scale), float.to_int(st.pad_y * scale), st.cell_height)
            // As for a resize: the screen now, scrollback once the size
            // holds, so holding Cmd+Plus stays quick.
            relayout_live(tabs, r, width, height)
            resized_at = sys.now_ms()
            ui.dirty = true
          }
        },
        Restyle => {
          r = styled(r, st)!
          ui.dirty = true
        },
        Focus(on) => {
          r.focused = on
          // Programs that asked (mode 1004) are told: CSI I, CSI O.
          match take(tabs, active) {
            some(tb) => {
              var cur = tb
              if cur.t.focus_events then {
                let _ = pty.write(cur.fd, if on then "\x1b[I" else "\x1b[O")
              }
              list.push(tabs, cur)
              tabs = list.swap(tabs, active, list.len(tabs) - 1)
            },
            none => (),
          }
          ui.dirty = true
        },
        Paste => {
          match take(tabs, active) {
            some(tb) => {
              var cur = tb
              let text = clipboard()!
              // Lines pasted where nothing marks them as pasted run one by
              // one as they arrive: asked first.
              if text != "" and (not st.paste_protection or cur.t.bracketed_paste or not keys.multiline(text) or paste_ok(text, ja)!) then {
                let _ = pty.write(cur.fd, keys.paste(text, cur.t.bracketed_paste))
                if cur.back != 0 then ui.dirty = true
                scroll_to(cur, 0)
              }
              list.push(tabs, cur)
              tabs = list.swap(tabs, active, list.len(tabs) - 1)
            },
            none => (),
          }
        },
        Stay => (),
      }
      // What belongs to the tab in front — find, a rename, a drag — ends
      // when another tab comes to the front, before its next input.
      if fd_of(tabs, active) != front then {
        leave_tab(ui)
        front = fd_of(tabs, active)
      }
      kind = if list.len(tabs) == 0 then window.NONE else window.next_event()
    }
    if list.len(tabs) == 0 then alive = false
    if auto_next >= 0 and sys.now_ms() >= auto_next then {
      match take(tabs, active) {
        some(tb) => {
          var cur = tb
          wheel(cur, ui, r, scale, auto[0], 40, 10)
          if trace then eprintln("wheel ${int.to_string(sys.now_ms())}")
          list.push(tabs, cur)
          tabs = list.swap(tabs, active, list.len(tabs) - 1)
        },
        none => (),
      }
      auto_next = if sys.now_ms() >= float.to_int(auto[2]) then -1 else auto_next + float.to_int(auto[3])
    }

    for tb in tabs {
      if pty.pending(tb.fd) then {
        let _ = pty.flush(tb.fd)
      }
    }

    // Every tab's output, the active tab's with the longer budget.
    streaming = false
    for i in 0..<list.len(tabs) {
      match take(tabs, i) {
        some(tb) => {
          var cur = tb
          let title_before = (cur.t.title, cur.t.cwd)
          let bells_before = cur.t.bells
          let (got, more) = drain(cur, if i == active then STREAM_DRAIN_MS else DRAIN_MS)
          if got then {
            match terminal.take_clipboard(cur.t) {
              some(text) => if st.clipboard_write then { let _ = sys.clipboard_set(text) },
              none => (),
            }
            let asked = terminal.take_clipboard_ask(cur.t)
            if asked != "" and (st.clipboard_read == "allow" or (st.clipboard_read == "ask" and not sys.is_linux() and clipboard_read_ok(title_of(cur, home), ja)!)) then {
              let _ = pty.write(cur.fd, terminal.clipboard_reply(asked, clipboard()!))
            }
            let notices = terminal.take_notices(cur.t)
            let bell = cur.t.bells != bells_before
            let looked_at = i == active and r.focused
            // A bell: the screen lit where it is being looked at, a sound if
            // asked for.
            if bell and looked_at and st.bell_flash then {
              r.flash = true
              flash_until = sys.now_ms() + FLASH_MS
              ui.dirty = true
            }
            if bell and st.bell_system then dialog.beep()
            // Marked where it isn't being looked at; the Dock asked to show
            // it when the window is in the background, and notifications
            // shown there.
            if (bell and st.bell_title or list.len(notices) > 0) and not looked_at and not cur.alert then {
              cur.alert = true
              ui.dirty = true
            }
            if not r.focused and (bell and st.bell_attention or list.len(notices) > 0) then window.request_attention()
            if not r.focused then for (title, body) in notices {
              dialog.notify(if title != "" then title else title_of(cur, home), body)
            }
          }
          // A tab in the back retitled itself: the tab bar shows it.
          if got and i != active and (cur.t.title, cur.t.cwd) != title_before then ui.dirty = true
          if got and trace then eprintln("out ${int.to_string(sys.now_ms())} tab ${int.to_string(i)} cursor ${int.to_string(cur.t.x)},${int.to_string(cur.t.y)}")
          if i == active then {
            if got then ui.dirty = true
            if more then streaming = true
          }
          let replies = terminal.take_replies(cur.t)
          if replies != "" then {
            let _ = pty.write(cur.fd, replies)
          }
          list.push(tabs, cur)
          tabs = list.swap(tabs, i, list.len(tabs) - 1)
        },
        none => (),
      }
    }

    // Tabs whose program has exited close; the window closes with the last.
    var i = 0
    while i < list.len(tabs) {
      if pty.eof(fd_of(tabs, i)) and capture == none then {
        close_tab(tabs, i)
        if active >= i and active > 0 then active = active - 1
        relayout(tabs, r, width, height)
        ui.dirty = true
      } else i = i + 1
    }
    pty.reap()
    if list.len(tabs) == 0 then alive = false
    if fd_of(tabs, active) != front then {
      leave_tab(ui)
      front = fd_of(tabs, active)
    }

    // The tab in front, in a window with the focus, is being looked at.
    if r.focused and (list.get(tabs, active) |> option.map((tb) => tb.alert) ?? false) then {
      tabs = list.set(tabs, active, { ...tabs[active], alert: false })
      ui.dirty = true
    }

    let clock = sys.now_ms()
    if alive and ui.dirty and clock - last_frame >= (if streaming then STREAM_FRAME_MS else FRAME_MS) then {
      let titles = tab_titles(tabs, active, ui, home)
      let shown = match list.get(tabs, active) {
        some(tb) => title_of(tb, home),
        none => "",
      }
      if shown != window_title then {
        window.set_title(if shown == "" then "sprid" else shown)
        window_title = shown
      }
      match take(tabs, active) {
        some(tb) => {
          var cur = tb
          // The program is mid-update (mode 2026, or its cursor hidden while
          // it draws): show the screen when it is done, or after a limit if
          // it never says so.
          note_updates(cur, clock)
          let held = hold_left(cur, clock) > 0
          if trace and held then eprintln("held ${int.to_string(clock)} for ${int.to_string(hold_left(cur, clock))} ms")
          if not held then {
            let t0 = sys.now_ms()
            render.draw(r, cur.t, cur.back, cur.shift, cur.sel, compose_of(ui), width, height, titles, active,
              bar_of(ui))
            if trace then eprintln("frame ${int.to_string(sys.now_ms())} cursor ${int.to_string(cur.t.x)},${int.to_string(cur.t.y)} shown ${if cur.t.cursor_visible then "yes" else "no"}"
              + " preedit ${int.to_string(list.len(ui.preedit))} line ${view.text_of(cur.t, view.screen_line(cur.t) + cur.t.y)}")
            frames = frames + 1
            draw_ms = draw_ms + sys.now_ms() - t0
            // The input method composes where typing goes: the find bar
            // while it is open, else the cursor.
            let gy = render.grid_top(r, list.len(titles))
            let (ix, iy) = if ui.finding and ui.find_focus then render.find_caret(r, bar(ui), ui.preedit, list.len(titles), width)
              else {
                // At the input method's caret in the composition, so its
                // candidates follow the typing.
                (r.pad_x + render.compose_caret(compose_of(ui), cur.t.x, cur.t.cols) * r.cell_w, gy + cur.t.y * r.cell_h)
              }
            // Told only when it moves: each time the input method is told,
            // it lays out its candidate window again, which shows as a
            // flicker while typing.
            if trace and list.len(ui.preedit) > 0 then {
              let (x0, ca, cb) = render.compose_span(compose_of(ui), cur.t.x, cur.t.cols)
              eprintln("compose ${int.to_string(sys.now_ms())} x ${int.to_string(cur.t.x)} cols ${int.to_string(cur.t.cols)} span ${int.to_string(x0)} ${int.to_string(ca)}..${int.to_string(cb)}"
                + " caret ${int.to_string(ui.preedit_caret)} sel ${int.to_string(ui.preedit_from)}..${int.to_string(ui.preedit_to)} ime_px ${int.to_string(ix)},${int.to_string(iy)} cell_w ${int.to_string(r.cell_w)} pad ${int.to_string(r.pad_x)}"
                + " text \"${list.join(list.map(ui.preedit, (c) => string.from_codepoint(c)), "")}\"")
            }
            if (ix, iy) != (ui.ime_x, ui.ime_y) then {
              window.set_ime_area(int.to_float(ix) / scale, int.to_float(iy) / scale,
                int.to_float(r.cell_w) / scale, int.to_float(r.cell_h) / scale)
              ui.ime_x = ix
              ui.ime_y = iy
            }
            last_frame = clock
            if input_at >= 0 then {
              let lat = sys.now_ms() - input_at
              latency_max = int.max(latency_max, lat)
              latency_sum = latency_sum + lat
              latency_n = latency_n + 1
              input_at = -1
            }
            // A glyph the frame couldn't make in time is made by the next.
            ui.dirty = r.missed
          }
          list.push(tabs, cur)
          tabs = list.swap(tabs, active, list.len(tabs) - 1)
        },
        none => (),
      }
    }

    match capture {
      some(path) => if (list.len(tabs) > 0 and pty.eof(fd_of(tabs, 0))) or clock > (int.parse(env.get("SPRID_CAPTURE_MS") ?? "3000") ?? 3000) then {
        if debug then eprintln("sprid: ${int.to_string(frames)} frames, draw ${int.to_string(draw_ms)} ms")
        let titles = tab_titles(tabs, active, ui, home)
        match take(tabs, active) {
          some(tb) => {
            var cur = tb
            cur.back = int.clamp(int.parse(env.get("SPRID_CAPTURE_BACK") ?? "0") ?? 0, 0, view.max_back(cur.t))
            cur.shift = int.clamp(int.parse(env.get("SPRID_CAPTURE_SHIFT") ?? "0") ?? 0, 0, r.cell_h - 1)
            // A composition at the cursor, as the input method shows one.
            match env.get("SPRID_CAPTURE_PREEDIT") {
              some(p) => {
                ui.preedit = text.code_points(p)
                ui.preedit_caret = list.len(ui.preedit)
              },
              none => (),
            }
            // The find bar searching for this, stepped up SPRID_CAPTURE_FIND_UP times.
            match env.get("SPRID_CAPTURE_FIND") {
              some(q) => {
                ui.finding = true
                ui.find_focus = true
                ui.field = field.of(q)
                set_query(cur, ui, q, true)
                // The bar's field with its text selected, or without the focus.
                match env.get("SPRID_CAPTURE_FIND_STATE") {
                  some(st) => {
                    if st == "selected" then ui.field = field.select_all(ui.field)
                    if st == "blurred" then ui.find_focus = false
                  },
                  none => (),
                }
                for _ in 0..<(int.parse(env.get("SPRID_CAPTURE_FIND_UP") ?? "0") ?? 0) {
                  find_step(cur, ui, -1)
                }
              },
              none => (),
            }
            render.draw(r, cur.t, cur.back, cur.shift, cur.sel, compose_of(ui), width, height, titles, active,
              bar_of(ui))
            list.push(tabs, cur)
          },
          none => (),
        }
        println(if frame.save_png(path) then "saved ${path}" else "capture failed")
        alive = false
      },
      none => (),
    }
  }
  for tb in tabs {
    pty.close(tb.fd)
  }
}

// ── Tabs ──────────────────────────────────────────────────────────────────

/// Whether tab `i` may close: at once when its shell waits at the prompt,
/// else when the user says so — closing ends what runs in it.
fn may_close_tab(tabs: List[Tab], i: Int, ja: Bool) -> Bool = {
  let running = pty.busy(fd_of(tabs, i))
  running == "" or (if ja then dialog.confirm("このタブを閉じますか？", "「${running}」が実行中です。閉じると終了します。", "閉じる", "キャンセル")
    else dialog.confirm("Close this tab?", "${running} is still running in it, and will be ended.", "Close", "Cancel"))
}

/// Whether the window may close: at once when every shell waits at its
/// prompt, else when the user says so.
fn may_close_window(tabs: List[Tab], ja: Bool) -> Bool = {
  let running = list.map(tabs, (tb) => pty.busy(tb.fd)) |> list.filter((n) => n != "")
  let n = list.len(running)
  let names = list.join(list.take(running, 3), ", ") + (if n > 3 then ", …" else "")
  n == 0 or (if ja then dialog.confirm("ウィンドウを閉じますか？", "${int.to_string(n)} 個のタブでプログラムが実行中です（${names}）。閉じると終了します。", "閉じる", "キャンセル")
    else dialog.confirm("Close the window?", "Programs are running in ${int.to_string(n)} tab${if n > 1 then "s" else ""} (${names}), and will be ended.", "Close", "Cancel"))
}

/// Reflow every tab's scrollback to the size the window settled at.
fn settle_all(mut tabs: List[Tab]) -> Unit = {
  for i in 0..<list.len(tabs) {
    match take(tabs, i) {
      some(tb) => {
        var cur = tb
        if cur.t.reflow_pending then {
          terminal.settle(cur.t)
          scroll_to(cur, 0)
          cur.sel = none
        }
        list.push(tabs, cur)
        tabs = list.swap(tabs, i, list.len(tabs) - 1)
      },
      none => (),
    }
  }
}

/// Tab `i`, taken out of `tabs`: the last tab moves into its place until the
/// caller pushes it back and swaps it home.
fn take(mut tabs: List[Tab], i: Int) -> Option[Tab] = {
  guard i >= 0 and i < list.len(tabs) else none
  tabs = list.swap(tabs, i, list.len(tabs) - 1)
  list.pop(tabs)
}

/// Note the updates `tb`'s program has begun since last looked at, as
/// beginning `now`.
fn note_updates(mut tb: Tab, now: Int) -> Unit = {
  let t = tb.t
  if t.sync_starts != tb.up.syncs then tb.up = { ...tb.up, syncs: t.sync_starts, sync_at: now }
  if t.hide_starts != tb.up.hides then tb.up = { ...tb.up, hides: t.hide_starts, hide_at: now }
}

/// How much longer the frame is held for `tb`'s program to finish drawing,
/// ms; 0 when it isn't. A synchronized update is asked for, a hidden cursor
/// only suggests one — but a program's first full screen comes while it is
/// still starting up, its pieces hundreds of ms apart, and until it is whole
/// the screen before it is the better one to show.
fn hold_left(tb: Tab, now: Int) -> Int = {
  let t = tb.t
  let sync = if t.sync_output then tb.up.sync_at + SYNC_LIMIT - now else 0
  let hidden = if terminal.drawing_hidden(t) then tb.up.hide_at + (if t.first_screen then FIRST_SCREEN_LIMIT else HIDDEN_LIMIT) - now else 0
  int.max(0, int.max(sync, hidden))
}

/// How long the active tab's program may still hold the frame, ms.
fn sync_wait(tabs: List[Tab], active: Int, now: Int) -> Int = match list.get(tabs, active) {
  some(tb) => hold_left(tb, now),
  none => 0,
}

fn fd_of(tabs: List[Tab], i: Int) -> Int = match list.get(tabs, i) {
  some(tb) => tb.fd,
  none => -1,
}

/// Where a tab opened from tab `i` starts: where the program in front there
/// is, else where its shell last said it was, else `home`.
fn cwd_of(tabs: List[Tab], i: Int, home: String) -> String = match list.get(tabs, i) {
  some(tb) => {
    let now = pty.cwd(tb.fd)
    if now != "" then now else if tb.t.cwd != "" then tb.t.cwd else home
  },
  none => home,
}

/// A new tab running `command` in `cwd`, sized for `count` tabs.
fn open_tab(r: render.Renderer, width: Int, height: Int, count: Int, command: String, cwd: String, scrollback: Int) -> Option[Tab] = {
  let (cols, rows) = render.grid_size(r, width, height, count)
  let fd = pty.spawn(command, cwd, cols, rows)
  if fd < 0 then none
  else some(Tab { t: terminal.with_scrollback(cols, rows, scrollback), fd: fd, back: 0, shift: 0, sel: none, up: Updates { syncs: 0, sync_at: 0, hides: 0, hide_at: 0 }, name: "", alert: false })
}

/// Close tab `i` and its program, keeping the other tabs in order.
fn close_tab(mut tabs: List[Tab], i: Int) -> Unit = {
  let n = list.len(tabs)
  if i >= 0 and i < n then {
    var j = i
    while j < n - 1 {
      tabs = list.swap(tabs, j, j + 1)
      j = j + 1
    }
    match list.pop(tabs) {
      some(tb) => pty.close(tb.fd),
      none => (),
    }
  }
}

/// Fit every tab to the window: the grid shrinks by the tab bar from two tabs
/// on.
fn relayout(mut tabs: List[Tab], r: render.Renderer, width: Int, height: Int) -> Unit =
  fit(tabs, r, width, height, false)

/// `relayout` while the window is being resized: scrollback is reflowed once
/// the size holds (`settle_all`).
fn relayout_live(mut tabs: List[Tab], r: render.Renderer, width: Int, height: Int) -> Unit =
  fit(tabs, r, width, height, true)

fn fit(mut tabs: List[Tab], r: render.Renderer, width: Int, height: Int, live: Bool) -> Unit = {
  let (cols, rows) = render.grid_size(r, width, height, list.len(tabs))
  for i in 0..<list.len(tabs) {
    match take(tabs, i) {
      some(tb) => {
        var cur = tb
        if cur.t.cols != cols or cur.t.rows != rows then {
          if live then terminal.resize_live(cur.t, cols, rows) else terminal.resize(cur.t, cols, rows)
          let _ = pty.resize(cur.fd, cols, rows)
          // Lines are numbered anew: a view scrolled back or a selection
          // would point at other lines.
          scroll_to(cur, 0)
          cur.sel = none
        }
        list.push(tabs, cur)
        tabs = list.swap(tabs, i, list.len(tabs) - 1)
      },
      none => (),
    }
  }
}

/// The tab bar's titles; the tab being renamed shows its draft, with a
/// caret.
fn tab_titles(tabs: List[Tab], active: Int, ui: Ui, home: String) -> List[String] =
  list.enumerate(tabs) |> list.map(((i, tb)) => if ui.renaming and i == active then ui.draft + "▏"
    else if tb.alert then "• " + title_of(tb, home)
    else title_of(tb, home))

/// What a tab is called: the name the user gave it, else the title its
/// program set, else its directory's name, else the shell's.
fn title_of(tb: Tab, home: String) -> String = {
  let t = tb.t
  // The directory the shell reported, else the one its foreground program
  // is in (a shell that reports nothing still gets a useful title).
  let dir = if t.cwd != "" then t.cwd else pty.cwd(tb.fd)
  if tb.name != "" then tb.name
  else if t.title != "" then t.title
  else if dir != "" and dir == home then "~"
  else if dir != "" then {
    let parts = string.split(dir, "/") |> list.filter((p) => p != "")
    list.last(parts) ?? "/"
  } else "shell"
}

// ── Output ────────────────────────────────────────────────────────────────

/// Feed the tab everything its program has written, up to `budget_ms` of
/// work: (whether there was any, whether it stopped at the budget with more
/// still coming).
fn drain(mut tb: Tab, budget_ms: Int) -> (Bool, Bool) = {
  let until = sys.now_ms() + budget_ms
  let screen_before = view.screen_line(tb.t)
  var data = pty.read(tb.fd, 0)
  var got = false
  var more = false
  while bytes.len(data) > 0 {
    terminal.feed(tb.t, data)
    got = true
    note_updates(tb, sys.now_ms())
    // Wait a moment for more: a writer refills the PTY 1 KB at a time, and
    // giving up in the gap costs a whole turn of the loop. In the middle of
    // a screen the frame is held for (see `hold_left`) the rest is surely
    // coming, and a program that writes only as fast as it is read — a
    // full-screen redraw comes 1 KB per turn — is kept waiting by every turn
    // not spent reading.
    let gap = if hold_left(tb, sys.now_ms()) > 0 then MID_UPDATE_GAP_MS else 1
    data = if sys.now_ms() < until then pty.read(tb.fd, gap) else {
      more = true
      bytes.new(0)
    }
  }
  // Scrolled back, the viewport stays on the lines it shows while new ones
  // arrive below.
  if tb.back > 0 or tb.shift > 0 then tb.back = int.min(tb.back + view.screen_line(tb.t) - screen_before, view.max_back(tb.t))
  // At the top of what can be scrolled back — none at all on the alternate
  // screen — there is no part of a line above to show.
  if tb.back >= view.max_back(tb.t) and tb.shift > 0 then {
    tb.back = view.max_back(tb.t)
    tb.shift = 0
  }
  (got, more)
}

// ── Input ─────────────────────────────────────────────────────────────────

/// Apply input `kind` to the active tab `cur`; what it asks of the tabs is
/// returned. `tabs` is how many are open, `width` the drawable's.
effect fn handle(mut cur: Tab, mut ui: Ui, kind: Int, r: render.Renderer, scale: Float, tabs: Int, width: Int) -> Act = {
  let t = cur.t
  // A press anywhere but the find bar takes the focus from it: typing goes
  // to the program again, the matches stay marked.
  if kind == window.MOUSE_DOWN and ui.finding and ui.find_focus
      and not render.on_bar(r, bar(ui), tabs, width, float.to_int(window.event_x() * scale), float.to_int(window.event_y() * scale)) then {
    ui.find_focus = false
    ui.dirty = true
  }
  if ui.renaming and (kind == window.TEXT or kind == window.KEY) then {
    rename_key(cur, ui, kind, window.event_code(), window.event_mods())
    Stay
  } else if ui.finding and ui.find_focus and (kind == window.TEXT or kind == window.KEY)
      and find_owns(kind, window.event_code(), shortcut_mods(kind)) then {
    find_key(cur, ui, kind, window.event_code(), shortcut_mods(kind))!
    Stay
  } else if kind == window.TEXT or kind == window.KEY then {
    let linux = sys.is_linux()
    // What was held, and what a shortcut reads it as (Ctrl+Shift is Cmd on
    // Linux, see `keys.shortcut_mods`); a key no shortcut takes goes to the
    // program as it was pressed.
    let held = window.event_mods()
    let mods = shortcut_mods(kind)
    let code = window.event_code()
    let command = kind == window.TEXT and mods == window.MOD_SUPER
    let command_shift = mods == window.MOD_SUPER + window.MOD_SHIFT
    let page = kind == window.KEY and mods == window.MOD_SHIFT and (code == window.KEY_PAGE_UP or code == window.KEY_PAGE_DOWN)
    // Cmd with a key that types nothing: Enter, the arrows, Home, End, ...
    let command_key = kind == window.KEY and mods == window.MOD_SUPER
    // Letters as typed without Shift or Caps Lock.
    let lower = if code >= 0x41 and code <= 0x5A then code + 32 else code
    let edit = if linux then "" else keys.mac_edit(kind, code, mods)
    // Ctrl+Tab / Ctrl+Shift+Tab switch tabs, as in browsers;
    // Tab and Shift+Tab alone stay the program's (completion, a CLI's mode
    // cycling).
    let ctrl_tab = kind == window.KEY and code == window.KEY_TAB
    // On Linux also Ctrl+Page Down / Up, as its terminals do.
    let ctrl_page = linux and kind == window.KEY and held == window.MOD_CTRL
    if ctrl_tab and mods == window.MOD_CTRL then NextTab
    else if ctrl_tab and mods == window.MOD_CTRL + window.MOD_SHIFT then PrevTab
    else if ctrl_page and code == window.KEY_PAGE_DOWN then NextTab
    else if ctrl_page and code == window.KEY_PAGE_UP then PrevTab
    // Linux: Ctrl+Shift+Q closes the window (a Mac's Cmd+Q is the menu's).
    else if linux and command and lower == 0x71 then CloseWindow
    else if command and (code == 0x74 or code == 0x54) then NewTab
    else if command and (code == 0x77 or code == 0x57) then CloseTab
    else if command and code >= 0x31 and code <= 0x39 then GoTo(code - 0x31)
    else if command_shift and ((kind == window.TEXT and code == 0x5D) or (kind == window.KEY and code == window.KEY_RIGHT)) then NextTab
    else if command_shift and ((kind == window.TEXT and code == 0x5B) or (kind == window.KEY and code == window.KEY_LEFT)) then PrevTab
    else if command and lower == 0x6E then NewWindow
    else if command_shift and kind == window.TEXT and lower == 0x77 then CloseWindow
    // Font size: Cmd+Plus — Cmd+= on a US keyboard, Cmd+; on a Japanese one,
    // with or without Shift — Cmd+Minus, and Cmd+0 back to the default.
    else if (command or command_shift) and (code == 0x3D or code == 0x2B or code == 0x3B) then Zoom(1)
    else if command and code == 0x2D then Zoom(-1)
    else if command and code == 0x30 then Zoom(0)
    else if command and lower == 0x6D then {
      window.minimize()
      Stay
    } else if (command_key and code == window.KEY_ENTER)
        or (kind == window.TEXT and mods == window.MOD_SUPER + window.MOD_CTRL and lower == 0x66)
        or (linux and kind == window.KEY and held == 0 and code == window.KEY_F1 + 10) then {
      // Cmd+Enter or Cmd+Ctrl+F (as every Mac app); F11 on Linux.
      window.toggle_fullscreen()
      Stay
    } else if command and lower == 0x61 then {
      // Cmd+A: everything, scrollback and screen, down to the cursor's line —
      // below it the screen is empty — or on the alternate screen all of it.
      terminal.settle(cur.t)
      let screen = view.screen_line(cur.t)
      cur.sel = some(view.Selection { anchor_line: screen - view.max_back(cur.t), anchor_col: 0,
                                      head_line: screen + (if cur.t.alt then cur.t.rows - 1 else cur.t.y), head_col: cur.t.cols - 1 })
      ui.dirty = true
      Stay
    } else if command_key and not t.alt and (code == window.KEY_HOME or code == window.KEY_END or code == window.KEY_PAGE_UP
        or code == window.KEY_PAGE_DOWN or code == window.KEY_UP or code == window.KEY_DOWN) then {
      // Scrolling: Cmd+Home / End to the top and the bottom, Cmd+PageUp /
      // PageDown by pages, Cmd+Up / Down by lines.
      let back = if code == window.KEY_HOME then view.max_back(cur.t)
        else if code == window.KEY_END then 0
        else if code == window.KEY_PAGE_UP then cur.back + t.rows - 1
        else if code == window.KEY_PAGE_DOWN then cur.back - t.rows + 1
        else if code == window.KEY_UP then cur.back + 1
        else cur.back - 1
      if back > cur.back then terminal.settle(cur.t)
      scroll_to(cur, int.clamp(back, 0, view.max_back(cur.t)))
      ui.dirty = true
      Stay
    } else if edit != "" then {
      let _ = pty.write(cur.fd, edit)
      if cur.back != 0 then ui.dirty = true
      scroll_to(cur, 0)
      Stay
    } else if command and lower == 0x66 then {
      // Cmd+F: the find bar, focused, its last query selected — typing
      // replaces it — and searched again from the bottom.
      ui.finding = true
      ui.find_focus = true
      ui.field = field.select_all(ui.field)
      set_query(cur, ui, field.text(ui.field), true)
      ui.dirty = true
      Stay
    } else if (command or command_shift) and lower == 0x67 and ui.find.query != "" then {
      // Cmd+G / Cmd+Shift+G from the terminal: the last search goes on.
      ui.finding = true
      find_step(cur, ui, if command_shift then 1 else -1)
      Stay
    } else if command and (code == 0x6B or code == 0x4B) then {
      // Cmd+K: clear. Scrollback always; the screen too when the shell waits
      // at its prompt — it is sent Ctrl+L, and draws the prompt, with what was
      // typed, at the top. A program running keeps its screen: clearing it
      // under the program would leave its drawing out of step.
      scrollback.clear(cur.t.sb)
      scroll_to(cur, 0)
      cur.sel = none
      refresh_find(cur, ui)
      if pty.busy(cur.fd) == "" then {
        let _ = pty.write(cur.fd, "\x0c")
      }
      ui.dirty = true
      Stay
    } else if command and (code == 0x63 or code == 0x43) then {
      // Cmd+C: the selection to the clipboard.
      match cur.sel {
        some(s) => copy(view.selected_text(t, s))!,
        none => (),
      }
      Stay
    } else if page and not t.alt then {
      // On the alternate screen there is no scrollback: the keys are the
      // program's.
      let step = if code == window.KEY_PAGE_UP then t.rows - 1 else 1 - t.rows
      terminal.settle(cur.t)
      scroll_to(cur, int.clamp(cur.back + step, 0, view.max_back(cur.t)))
      ui.dirty = true
      Stay
    } else {
      if command and (code == 0x76 or code == 0x56) then Paste
      else {
        let out = keys.encode_with(kind, code, held, t.app_cursor, t.kitty_flags)
        if out != "" then {
          let _ = pty.write(cur.fd, out)
          // Typing brings the viewport back to the prompt.
          if cur.back != 0 then ui.dirty = true
          scroll_to(cur, 0)
        }
        Stay
      }
    }
  } else if kind == window.WHEEL then {
    let (col, row) = cell_at(r, t, scale, tabs)
    wheel(cur, ui, r, scale, window.event_dy(), col, row)
    Stay
  } else if kind == window.MOUSE_DOWN and ui.finding and window.event_code() == 0
      and render.on_bar(r, bar(ui), tabs, width, float.to_int(window.event_x() * scale), float.to_int(window.event_y() * scale)) then {
    // A press on the find bar focuses it and puts the caret there (Shift:
    // selects to there); a drag selects.
    let at = render.field_index_at(r, bar(ui), tabs, width, float.to_int(window.event_x() * scale))
    ui.field = field.move_to(ui.field, at, int.band(window.event_mods(), window.MOD_SHIFT) != 0)
    ui.find_focus = true
    ui.field_drag = true
    ui.dirty = true
    Stay
  } else if ui.field_drag and (kind == window.MOUSE_MOVE or kind == window.MOUSE_UP) then {
    let at = render.field_index_at(r, bar(ui), tabs, width, float.to_int(window.event_x() * scale))
    if at != ui.field.caret then {
      ui.field = field.move_to(ui.field, at, true)
      ui.dirty = true
    }
    if kind == window.MOUSE_UP then ui.field_drag = false
    Stay
  } else if kind == window.MOUSE_DOWN and window.event_code() == 0
      and render.on_scrollbar(r, t, width, float.to_int(window.event_x() * scale)) then {
    // The scrollbar: its thumb is dragged from where it was taken; a press
    // on the track brings the thumb's middle there.
    let py = float.to_int(window.event_y() * scale)
    let (y0, y1) = render.thumb(r, t, cur.back, cur.shift, tabs, window.height())
    ui.scroll_grab = if py >= y0 and py < y1 then py - y0 else (y1 - y0) / 2
    ui.scroll_drag = true
    drag_scrollbar(cur, ui, r, scale, tabs)
    Stay
  } else if ui.scroll_drag and (kind == window.MOUSE_MOVE or kind == window.MOUSE_UP) then {
    drag_scrollbar(cur, ui, r, scale, tabs)
    if kind == window.MOUSE_UP then ui.scroll_drag = false
    Stay
  } else if (kind == window.MOUSE_DOWN or kind == window.MOUSE_UP or kind == window.MOUSE_MOVE) and app_mouse(t, ui, r, scale, tabs, kind) then {
    // The program asked for the mouse: presses, releases
    // and motion are its, as SGR reports. Shift held keeps them the
    // window's, for selecting text as anywhere else.
    let (col, row) = cell_at(r, t, scale, tabs)
    let mods = window.event_mods()
    // Modifier bits of a report: Alt 8, Ctrl 16 (Shift is the window's).
    let held = (if int.band(mods, window.MOD_ALT) != 0 then 8 else 0)
      + (if int.band(mods, window.MOD_CTRL) != 0 then 16 else 0)
    let at = ";${int.to_string(col + 1)};${int.to_string(row + 1)}"
    if kind == window.MOUSE_DOWN then {
      // The window's buttons are left 0, right 1, middle 2; a report's
      // left 0, middle 1, right 2.
      let code = window.event_code()
      let button = if code == 1 then 2 else if code == 2 then 1 else 0
      ui.app_button = button
      let _ = pty.write(cur.fd, "\x1b[<${int.to_string(button + held)}${at}M")
    } else if kind == window.MOUSE_UP then {
      if ui.app_button >= 0 then {
        let _ = pty.write(cur.fd, "\x1b[<${int.to_string(ui.app_button + held)}${at}m")
      }
      ui.app_button = -1
    } else if (col, row) != (ui.report_col, ui.report_row) then {
      // Motion: with a button held under 1002 and 1003, without one only
      // under 1003; once per cell.
      if ui.app_button >= 0 and t.mouse_mode >= 1002 then {
        let _ = pty.write(cur.fd, "\x1b[<${int.to_string(ui.app_button + 32 + held)}${at}M")
      } else if ui.app_button < 0 and t.mouse_mode == 1003 then {
        let _ = pty.write(cur.fd, "\x1b[<${int.to_string(35 + held)}${at}M")
      }
    }
    ui.report_col = col
    ui.report_row = row
    Stay
  } else if kind == window.MOUSE_DOWN and window.event_code() == 0 then {
    let py = float.to_int(window.event_y() * scale)
    // A press anywhere ends a rename, keeping the draft.
    if ui.renaming then finish_rename(cur, ui, true) else ()
    if tabs > 1 and py < render.bar_height(r) then {
      let i = render.tab_at(r, float.to_int(window.event_x() * scale), width, tabs)
      let now = sys.now_ms()
      // A double click renames the tab: its first press made it the active one.
      let double = i == ui.click_tab and now - ui.click_ms < DOUBLE_CLICK_MS
      ui.click_ms = if double then 0 else now
      ui.click_tab = i
      ui.clicks = 0
      if double then {
        ui.renaming = true
        ui.draft = title_of(cur, ui.home)
        ui.dirty = true
        Stay
      } else GoTo(i)
    } else {
      let (col, _) = cell_at(r, t, scale, tabs)
      let line = pointer_line(r, cur, scale, tabs)
      let now = sys.now_ms()
      // A press on the cell just pressed, soon enough, counts on: the
      // second selects the word there, the third the line; a fourth stays
      // with the line.
      let again = ui.click_tab < 0 and ui.clicks > 0 and now - ui.click_ms < DOUBLE_CLICK_MS
        and line == ui.click_line and col == ui.click_col
      ui.clicks = if again then int.min(ui.clicks + 1, 3) else 1
      ui.click_ms = now
      ui.click_tab = -1
      ui.click_line = line
      ui.click_col = col
      ui.unit = ui.clicks - 1
      let (l0, c0, l1, c1) = view.unit_span(cur.t, ui.unit, line, col)
      ui.anchor_line = l0
      ui.anchor_col = c0
      ui.anchor_end_line = l1
      ui.anchor_end_col = c1
      ui.dragging = true
      let sel = if ui.unit == 0 then none
        else some(view.Selection { anchor_line: l0, anchor_col: c0, head_line: l1, head_col: c1 })
      if sel != cur.sel then ui.dirty = true
      cur.sel = sel
      Stay
    }
  } else if kind == window.MOUSE_MOVE and ui.dragging then {
    let (col, _) = cell_at(r, t, scale, tabs)
    let line = pointer_line(r, cur, scale, tabs)
    // By cell, a click that wobbles within its cell selects nothing: a
    // selection starts once the pointer reaches another cell. By word or
    // line, the selection spans what the press took and what the pointer is
    // on, whole.
    let (h0, c0, h1, c1) = view.unit_span(cur.t, ui.unit, line, col)
    let before = h0 < ui.anchor_line or (h0 == ui.anchor_line and c0 < ui.anchor_col)
    let sel = if ui.unit == 0 and line == ui.anchor_line and col == ui.anchor_col then none
      else if ui.unit == 0 then some(view.Selection { anchor_line: ui.anchor_line, anchor_col: ui.anchor_col, head_line: line, head_col: col })
      else if before then some(view.Selection { anchor_line: ui.anchor_end_line, anchor_col: ui.anchor_end_col, head_line: h0, head_col: c0 })
      else some(view.Selection { anchor_line: ui.anchor_line, anchor_col: ui.anchor_col, head_line: h1, head_col: c1 })
    if sel != cur.sel then {
      cur.sel = sel
      ui.dirty = true
    } else ()
    Stay
  } else if kind == window.MOUSE_UP and window.event_code() == 0 then {
    ui.dragging = false
    Stay
  } else if kind == window.THEME then Restyle
  else if kind == window.FOCUS then Focus(window.event_code() == 1)
  else if kind == window.DROP then {
    // A file dropped on the window: its path, escaped, pasted as if typed —
    // the shell takes it as a word, and Claude Code attaches an image.
    let _ = pty.write(cur.fd, keys.paste(keys.shell_escape(window.event_text()) + " ", t.bracketed_paste))
    if cur.back != 0 or cur.shift != 0 then ui.dirty = true
    scroll_to(cur, 0)
    Stay
  } else if kind == window.COMPOSE then {
    let cps = text.code_points(window.event_text())
    ui.preedit = cps
    // The selected range: a caret while typing, the segment being
    // converted while converting (-1: none, the caret at the end).
    let from = window.event_code()
    let to = window.event_end()
    ui.preedit_caret = if from < 0 then list.len(cps) else int.clamp(to, 0, list.len(cps))
    ui.preedit_from = if from >= 0 and to > from then int.min(from, list.len(cps)) else 0
    ui.preedit_to = if from >= 0 and to > from then int.min(to, list.len(cps)) else 0
    ui.dirty = true
    Stay
  } else Stay
}

/// The modifiers of the current key input as a shortcut reads them.
fn shortcut_mods(kind: Int) -> Int = keys.shortcut_mods(sys.is_linux(), kind, window.event_code(), window.event_mods())

/// Whether a mouse input goes to the program: it asked for the mouse (in SGR
/// form), Shift isn't held, and the pointer is not on the tab bar — or it
/// ends a press the program was sent.
fn app_mouse(t: terminal.Terminal, ui: Ui, r: render.Renderer, scale: Float, tabs: Int, kind: Int) -> Bool = {
  let wanted = t.mouse_mode != 0 and t.mouse_sgr and int.band(window.event_mods(), window.MOD_SHIFT) == 0
  let on_bar = tabs > 1 and float.to_int(window.event_y() * scale) < render.bar_height(r)
  (wanted and not on_bar and not ui.dragging) or (kind == window.MOUSE_UP and ui.app_button >= 0)
}

/// The find bar as drawn.
fn bar(ui: Ui) -> render.Bar = findbar.Bar { find: ui.find, field: ui.field, focused: ui.find_focus }

fn bar_of(ui: Ui) -> Option[render.Bar] = if ui.finding then some(bar(ui)) else none

/// Whether an input goes to the focused find bar: every key without Cmd —
/// the program gets nothing while the bar has the focus — and the Cmd keys
/// of a text field (A, C, X, V, arrows, Backspace) and of finding (F, G).
/// Other Cmd shortcuts (tabs, font size) work as ever.
fn find_owns(kind: Int, code: Int, mods: Int) -> Bool = {
  let lower = if code >= 0x41 and code <= 0x5A then code + 32 else code
  let cmd = int.band(mods, window.MOD_SUPER) != 0
  not cmd
    or (kind == window.TEXT and (lower == 0x61 or lower == 0x63 or lower == 0x78 or lower == 0x76 or lower == 0x66 or lower == 0x67))
    or (kind == window.KEY and (code == window.KEY_BACKSPACE or code == window.KEY_DELETE
      or code == window.KEY_LEFT or code == window.KEY_RIGHT))
}

/// An input to the focused find bar. Its field edits as a Mac text field
/// does — Cmd+A, C, X, V; arrows, Option by word, Cmd or Home / End to the
/// ends, Shift selecting; Backspace and Delete, Option by word, Cmd to the
/// start — and searches as it changes. Enter or Up goes to the match above,
/// Shift+Enter or Down the one below (Cmd+G and Cmd+Shift+G too); Escape
/// closes the bar.
effect fn find_key(mut cur: Tab, mut ui: Ui, kind: Int, code: Int, mods: Int) -> Unit = {
  let lower = if code >= 0x41 and code <= 0x5A then code + 32 else code
  let cmd = int.band(mods, window.MOD_SUPER) != 0
  let shift = int.band(mods, window.MOD_SHIFT) != 0
  let alt = int.band(mods, window.MOD_ALT) != 0
  let f = ui.field
  let key = kind == window.KEY
  let cmd_text = kind == window.TEXT and cmd
  if key and code == window.KEY_ESCAPE then {
    ui.finding = false
    ui.find_focus = false
    let nothing: List[Int] = []
    ui.preedit = nothing
    ui.dirty = true
  } else if (key and code == window.KEY_ENTER) or (cmd_text and lower == 0x67) then
    find_step(cur, ui, if shift then 1 else -1)
  else if key and (code == window.KEY_UP or code == window.KEY_DOWN) then
    find_step(cur, ui, if code == window.KEY_UP then -1 else 1)
  else if (cmd_text and (lower == 0x61 or lower == 0x66)) then {
    ui.field = field.select_all(f)
    ui.dirty = true
  } else if cmd_text and lower == 0x63 then {
    // Copy: the field's selection, else the terminal's.
    if field.has_selection(f) then copy(field.selected(f))!
    else match cur.sel {
      some(s) => copy(view.selected_text(cur.t, s))!,
      none => (),
    }
  } else if cmd_text and lower == 0x78 then {
    if field.has_selection(f) then {
      copy(field.selected(f))!
      edit_field(cur, ui, field.insert(f, ""))
    }
  } else if cmd_text and lower == 0x76 then {
    // The first line of the clipboard: a search stays within a line.
    edit_field(cur, ui, field.insert(f, list.first(string.lines(clipboard()!)) ?? ""))
  } else if key and (code == window.KEY_LEFT or code == window.KEY_RIGHT) then {
    let dir = if code == window.KEY_LEFT then -1 else 1
    ui.field = if cmd then field.move_to(f, if dir < 0 then 0 else list.len(f.chars), shift)
      else if alt then field.move_to(f, field.word_edge(f, f.caret, dir), shift)
      else field.step(f, dir, shift)
    ui.dirty = true
  } else if key and (code == window.KEY_HOME or code == window.KEY_END) then {
    ui.field = field.move_to(f, if code == window.KEY_HOME then 0 else list.len(f.chars), shift)
    ui.dirty = true
  } else if key and code == window.KEY_BACKSPACE then
    edit_field(cur, ui, field.delete_to(f, if cmd then 0 else if alt then field.word_edge(f, f.caret, -1) else f.caret - 1))
  else if key and code == window.KEY_DELETE then
    edit_field(cur, ui, field.delete_to(f, if alt then field.word_edge(f, f.caret, 1) else f.caret + 1))
  else if kind == window.TEXT and int.band(mods, window.MOD_SUPER + window.MOD_CTRL) == 0 then
    edit_field(cur, ui, field.insert(f, string.from_codepoint(code)))
  else ()
}

/// The field edited to `g`, searched again when its text changed.
fn edit_field(mut cur: Tab, mut ui: Ui, g: field.Field) -> Unit = {
  let changed = field.text(g) != field.text(ui.field)
  ui.field = g
  if changed then set_query(cur, ui, field.text(g), false)
  ui.dirty = true
}

/// Search for `query`: from the bottom when `fresh`, else narrowing where
/// the search stands; the view follows the current match.
fn set_query(mut cur: Tab, mut ui: Ui, query: String, fresh: Bool) -> Unit = {
  settle_for_find(cur)
  let from = if fresh then search.empty() else ui.find
  ui.find = search.with_query(cur.t, from, query)
  follow(cur, ui.find)
  ui.dirty = true
}

/// The match above (`dir` -1) or below (1) the current one.
fn find_step(mut cur: Tab, mut ui: Ui, dir: Int) -> Unit = {
  settle_for_find(cur)
  ui.find = search.next(cur.t, ui.find, dir)
  follow(cur, ui.find)
  ui.dirty = true
}

/// Scrollback reflowed to the window, if it waits for that: matches are
/// found by line number, and a reflow numbers the lines anew.
fn settle_for_find(mut cur: Tab) -> Unit = {
  if cur.t.reflow_pending then {
    terminal.settle(cur.t)
    scroll_to(cur, 0)
    cur.sel = none
  }
}

/// Scroll so the current match is in view, in the middle when it wasn't.
fn follow(mut cur: Tab, f: search.Find) -> Unit = {
  let top = view.top_line(cur.t, cur.back)
  if f.index >= 0 and (f.line < top or f.line >= top + cur.t.rows) then
    scroll_to(cur, int.clamp(view.screen_line(cur.t) - f.line + cur.t.rows / 2, 0, view.max_back(cur.t)))
}

/// The input method's composition, as drawn.
fn compose_of(ui: Ui) -> render.Compose =
  composition.Compose { cps: ui.preedit, caret: ui.preedit_caret, from: ui.preedit_from, to: ui.preedit_to }

/// Whether the cursor of the tab in front blinks: a blinking DECSCUSR shape,
/// the program's or the config's, shown.
fn cursor_blinks(tabs: List[Tab], active: Int, r: render.Renderer) -> Bool = match list.get(tabs, active) {
  some(tb) => {
    let shape = if tb.t.cursor_shape == 0 then r.cursor_default else tb.t.cursor_shape
    tb.t.cursor_visible and int.band(shape, 1) == 1
  },
  none => false,
}

/// The sooner of two waits, ms; -1 is no limit.
fn sooner(a: Int, b: Int) -> Int = if a < 0 then b else if b < 0 then a else int.min(a, b)

/// Scroll `tb` to `back` lines into scrollback, on a line's edge.
fn scroll_to(mut tb: Tab, back: Int) -> Unit = {
  tb.back = back
  tb.shift = 0
}

/// The search run again over `cur` as it is now — after a reflow numbered
/// its lines anew, or scrollback was cleared — its current match the
/// nearest at or above the bottom of the view, which stays where it is.
fn refresh_find(mut cur: Tab, mut ui: Ui) -> Unit = {
  if ui.find.query != "" then {
    let from = { ...search.empty(), line: view.top_line(cur.t, cur.back) + cur.t.rows - 1 }
    ui.find = search.with_query(cur.t, from, ui.find.query)
    ui.dirty = true
  }
}

/// End what belonged to the tab that was in front: its find bar and
/// search, a rename, a drag or a press reported to its program.
fn leave_tab(mut ui: Ui) -> Unit = {
  ui.finding = false
  ui.find_focus = false
  ui.find = search.empty()
  ui.field = field.of("")
  ui.renaming = false
  ui.draft = ""
  ui.dragging = false
  ui.app_button = -1
  ui.scroll_drag = false
  ui.field_drag = false
  ui.dirty = true
}

/// Longest gap between the presses of a double click, ms (macOS's default).
let DOUBLE_CLICK_MS = 500

/// Edit the name being given to tab `cur`: typing adds, Backspace takes the
/// last character off, Enter keeps it, Escape drops it.
fn rename_key(mut cur: Tab, mut ui: Ui, kind: Int, code: Int, mods: Int) -> Unit = {
  if kind == window.KEY and code == window.KEY_ENTER then finish_rename(cur, ui, true)
  else if kind == window.KEY and code == window.KEY_ESCAPE then finish_rename(cur, ui, false)
  else if kind == window.KEY and code == window.KEY_BACKSPACE then {
    ui.draft = string.take(ui.draft, int.max(0, string.len(ui.draft) - 1))
    ui.dirty = true
  } else if kind == window.TEXT and int.band(mods, window.MOD_SUPER + window.MOD_CTRL) == 0 then {
    ui.draft = ui.draft + string.from_codepoint(code)
    ui.dirty = true
  } else ()
}

/// End a rename, giving the tab the draft when `keep` (an empty one: back to
/// the automatic title).
fn finish_rename(mut cur: Tab, mut ui: Ui, keep: Bool) -> Unit = {
  if keep then cur.name = string.trim(ui.draft) else ()
  ui.renaming = false
  ui.draft = ""
  ui.dirty = true
}

/// The wheel moved `dy` logical pixels (positive: toward the end) over cell
/// (`col`, `row`). Scrollback follows it by the pixel — a trackpad moves the
/// text with the fingers, not a line at a time once a line's worth adds up.
/// A program that asked for the mouse is told of it a line at a time, and a
/// full-screen one without the mouse gets arrow keys.
fn wheel(mut cur: Tab, mut ui: Ui, r: render.Renderer, scale: Float, dy: Float, col: Int, row: Int) -> Unit = {
  let t = cur.t
  let reports = t.mouse_mode != 0 and t.mouse_sgr
  if not reports and not t.alt then {
    ui.wheel_acc = ui.wheel_acc + dy * scale
    let px = float.to_int(ui.wheel_acc)
    ui.wheel_acc = ui.wheel_acc - int.to_float(px)
    if px < 0 then terminal.settle(cur.t)
    let pos = int.clamp(cur.back * r.cell_h + cur.shift - px, 0, view.max_back(cur.t) * r.cell_h)
    if pos != cur.back * r.cell_h + cur.shift then {
      cur.back = pos / r.cell_h
      cur.shift = pos % r.cell_h
      ui.dirty = true
    }
  } else {
    ui.wheel_acc = ui.wheel_acc + dy
    let line_px = int.to_float(r.cell_h) / scale
    let lines = float.to_int(ui.wheel_acc / line_px)
    ui.wheel_acc = ui.wheel_acc - int.to_float(lines) * line_px
    if lines != 0 then {
      // All of a move in one write: the program reads them together.
      let one = if reports then "\x1b[<${int.to_string(if lines < 0 then 64 else 65)};${int.to_string(col + 1)};${int.to_string(row + 1)}M"
        else keys.encode(keys.KEY, if lines < 0 then keys.KEY_UP else keys.KEY_DOWN, 0, t.app_cursor)
      let _ = pty.write(cur.fd, string.repeat(one, int.abs(lines)))
    }
  }
}

/// Scroll to where the pointer puts the scrollbar's thumb.
fn drag_scrollbar(mut cur: Tab, mut ui: Ui, r: render.Renderer, scale: Float, tabs: Int) -> Unit = {
  terminal.settle(cur.t)
  let py = float.to_int(window.event_y() * scale)
  let pos = render.scroll_pos_at(r, cur.t, tabs, window.height(), py - ui.scroll_grab)
  if pos != cur.back * r.cell_h + cur.shift then {
    cur.back = pos / r.cell_h
    cur.shift = pos % r.cell_h
    ui.dirty = true
  }
}

/// The line under the pointer, as `tb` is scrolled.
fn pointer_line(r: render.Renderer, tb: Tab, scale: Float, tabs: Int) -> Int = {
  let py = float.to_int(window.event_y() * scale)
  // The viewport's top line starts `shift` pixels below the grid's top; the
  // line above it shows in those pixels.
  let rel = py - render.grid_top(r, tabs) - tb.shift
  let row = if rel < 0 then (if tb.shift > 0 then -1 else 0) else int.min(rel / r.cell_h, tb.t.rows - 1)
  view.top_line(tb.t, tb.back) + row
}

/// The cell under the pointer: (column, row of the viewport).
fn cell_at(r: render.Renderer, t: terminal.Terminal, scale: Float, tabs: Int) -> (Int, Int) = {
  let px = float.to_int(window.event_x() * scale)
  let py = float.to_int(window.event_y() * scale)
  let gy = render.grid_top(r, tabs)
  (int.clamp((px - r.pad_x) / r.cell_w, 0, t.cols - 1), int.clamp((py - gy) / r.cell_h, 0, t.rows - 1))
}

effect fn copy(s: String) -> Unit = {
  let _ = sys.clipboard_set(s)
}

effect fn clipboard() -> String = sys.clipboard_get()

/// Ask whether the program in the tab called `tab` may read the clipboard.
effect fn clipboard_read_ok(tab: String, ja: Bool) -> Bool =
  if ja then dialog.confirm("クリップボードの読み取りを許可しますか？", "「${tab}」のプログラムがクリップボードの内容を求めています。", "許可", "拒否")
  else dialog.confirm("Let the program read the clipboard?", "The program in \"${tab}\" asks for what is on the clipboard.", "Allow", "Deny")

/// Ask before pasting `text`, which has line breaks, where they would run
/// each line as it arrives.
effect fn paste_ok(text: String, ja: Bool) -> Bool = {
  let lines = string.split(string.replace(string.trim_end(text), "\r\n", "\n"), "\n")
  let n = list.len(lines)
  let preview = lines |> list.take(3) |> list.map((l) => if string.len(l) > 60 then string.take(l, 60) + "…" else l)
  let shown = string.join(preview, "\n") + (if n > 3 then "\n…" else "")
  if ja then dialog.confirm("${int.to_string(n)} 行を貼り付けますか？", "改行を含むため、貼り付けると各行がコマンドとして実行されます。\n\n${shown}", "貼り付ける", "キャンセル")
  else dialog.confirm("Paste ${int.to_string(n)} line${if n > 1 then "s" else ""}?", "The text has line breaks: each line will run as a command as it is pasted.\n\n${shown}", "Paste", "Cancel")
}
