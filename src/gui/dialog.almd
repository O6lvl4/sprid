// Questions in the system's dialog — @extern(rust), backed by native/dialog.rs

/// Ask: `message`, `detail` under it, buttons `yes` (default) and `no`.
/// True for `yes`.
@extern(rust, "crate::dialog", "confirm")
fn confirm(message: String, detail: String, yes: String, no: String) -> Bool = _

/// Show a desktop notification (Notification Center on macOS, notify-send
/// elsewhere); never waits.
@extern(rust, "crate::dialog", "notify")
fn notify(title: String, body: String) -> Unit = _

/// The system's alert sound (macOS; nothing elsewhere).
@extern(rust, "crate::dialog", "beep")
fn beep() -> Unit = _

/// A menu at the pointer: one item per line of `items` (`!` first:
/// disabled, `-`: a separator); the index picked, -1 for none (and on
/// Linux, which has no menu yet). Waits until it closes.
@extern(rust, "crate::dialog", "context_menu")
fn context_menu(items: String) -> Int = _

/// The macOS menu bar, as `spec` describes it (see native/menu.rs).
@extern(rust, "crate::menu", "set_menu")
fn set_menu(spec: String) -> Unit = _

/// Pick item `item` of menu `menu` as a click would (a test's).
@extern(rust, "crate::menu", "perform")
fn perform_menu(menu: Int, item: Int) -> Unit = _

/// Whether the system reopens an app's windows when it starts again (see
/// native/dialog.rs).
@extern(rust, "crate::dialog", "keeps_windows")
fn keeps_windows() -> Bool = _
