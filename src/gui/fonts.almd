// The faces sprid draws with: a monospace face for the grid, its bold, and
// faces to fall back on for what it lacks. `SPRID_FONT` (a path) goes first
// when set.
//
// Only the grid face is read at start. The bold is read when bold text first
// appears, and a fallback when a character first needs it: a face is held in
// memory whole, and the fallbacks alone come to about 12 MB that most
// sessions never touch.

import bytes
import env
import fs
import snaidhm.sfnt as sfnt
import self.sys

/// The grid face, where its bold is, and where the fallbacks are, in order.
type Faces = { regular: sfnt.Font, bold_path: String, fallback_paths: List[String] }

/// Monospace faces, in order of preference, each with its bold.
let MONO = [
  ("~/Library/Fonts/UDEVGothic35NFLG-Regular.ttf", "~/Library/Fonts/UDEVGothic35NFLG-Bold.ttf"),
  ("/System/Library/Fonts/SFNSMono.ttf", ""),
  ("/System/Library/Fonts/Menlo.ttc", ""),
  ("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"),
  ("/usr/share/fonts/TTF/DejaVuSansMono.ttf", "/usr/share/fonts/TTF/DejaVuSansMono-Bold.ttf"),
]

/// Where the grid face has no glyph: Japanese (with the rest of CJK), then
/// symbols — Menlo has the dingbats CLIs draw (✻ ✔ ✘), STIX Two
/// Math the media symbols (⏺), Apple Symbols most of the rest.
let FALLBACK = [
  "/System/Library/Fonts/ヒラギノ角ゴシック W3.ttc",
  "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
  "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
  "/System/Library/Fonts/Menlo.ttc",
  "/System/Library/Fonts/Supplemental/STIXTwoMath.otf",
  "/System/Library/Fonts/Apple Symbols.ttf",
  "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
]

effect fn expand(path: String) -> String =
  if string.starts_with(path, "~/") then (env.get("HOME") ?? "") + string.drop(path, 1) else path

/// Face 0 of the font file at `path`, or none.
fn load(path: String) -> Option[sfnt.Font] =
  if path == "" then none
  else {
    let data = sys.read_file(path)
    if bytes.len(data) == 0 then none else sfnt.load(data, 0)?
  }

/// The first monospace face this system has, with the path of its bold.
effect fn mono(i: Int) -> Option[(sfnt.Font, String)] =
  if i >= list.len(MONO) then none
  else {
    let (regular, bold) = MONO[i]
    match load(expand(regular)!) {
      some(f) => some((f, if bold == "" then "" else expand(bold)!)),
      none => mono(i + 1)!,
    }
  }

effect fn find() -> Option[Faces] = {
  let custom = match env.get("SPRID_FONT") {
    some(p) => match load(p) { some(f) => some((f, "")), none => none },
    none => none,
  }
  let grid = match custom { some(c) => some(c), none => mono(0)! }
  var fallbacks: List[String] = []
  for path in FALLBACK {
    if fs.exists(path) then list.push(fallbacks, path)
  }
  match grid {
    some((f, bold)) => some(Faces { regular: f, bold_path: bold, fallback_paths: fallbacks }),
    none => none,
  }
}
