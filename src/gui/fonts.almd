// The faces sprid draws with: a monospace face for the grid, its bold, and
// faces to fall back on for what it lacks. `SPRID_FONT` (a path) goes first
// when set.
//
// Only the grid face is read at start. The bold is read when bold text first
// appears, and a fallback when a character first needs it: a face is held in
// memory whole, and the fallbacks alone come to about 12 MB that most
// sessions never touch.

import bytes
import env
import fs
import snaidhm.sfnt as sfnt
import self.sys
import self.gui.fontname

/// The grid face, where its bold is, and where the fallbacks are, in order.
type Faces = { regular: sfnt.Font, bold_path: String, fallback_paths: List[String] }

/// Monospace faces, in order of preference, each with its bold.
let MONO = [
  ("~/Library/Fonts/UDEVGothic35NFLG-Regular.ttf", "~/Library/Fonts/UDEVGothic35NFLG-Bold.ttf"),
  ("~/.local/share/fonts/UDEVGothic35NFLG-Regular.ttf", "~/.local/share/fonts/UDEVGothic35NFLG-Bold.ttf"),
  ("/System/Library/Fonts/SFNSMono.ttf", ""),
  ("/System/Library/Fonts/Menlo.ttc", ""),
  ("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"),
  ("/usr/share/fonts/TTF/DejaVuSansMono.ttf", "/usr/share/fonts/TTF/DejaVuSansMono-Bold.ttf"),
]

/// Where the grid face has no glyph: Japanese (with the rest of CJK), then
/// symbols — Menlo has the dingbats CLIs draw (✻ ✔ ✘), STIX Two
/// Math the media symbols (⏺), Apple Symbols most of the rest; on Linux
/// DejaVu Sans the dingbats and Noto Sans Symbols 2 the media symbols
/// (Debian and Ubuntu paths, then Arch's).
let FALLBACK = [
  "/System/Library/Fonts/ヒラギノ角ゴシック W3.ttc",
  "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
  "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
  "/System/Library/Fonts/Menlo.ttc",
  "/System/Library/Fonts/Supplemental/STIXTwoMath.otf",
  "/System/Library/Fonts/Apple Symbols.ttf",
  "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
  "/usr/share/fonts/TTF/DejaVuSans.ttf",
  "/usr/share/fonts/truetype/noto/NotoSansSymbols2-Regular.ttf",
  "/usr/share/fonts/noto/NotoSansSymbols2-Regular.ttf",
  "/usr/share/fonts/truetype/noto/NotoSansSymbols-Regular.ttf",
  "/usr/share/fonts/noto/NotoSansSymbols-Regular.ttf",
]

effect fn expand(path: String) -> String =
  if string.starts_with(path, "~/") then (env.get("HOME") ?? "") + string.drop(path, 1) else path

/// A face of the font file at `path` — face 0, or `path#n` for face n of a
/// collection — or none.
fn load(path: String) -> Option[sfnt.Font] =
  if path == "" then none
  else {
    let (file, face) = match string.split_once(path, "#") {
      some((f, n)) => (f, int.parse(n) ?? 0),
      none => (path, 0),
    }
    let data = sys.read_file(file)
    if bytes.len(data) == 0 then none else sfnt.load(data, face)?
  }

/// Where font files are: the user's, then the system's.
effect fn font_dirs() -> List[String] = [
  expand("~/Library/Fonts")!, "/Library/Fonts", "/System/Library/Fonts", "/System/Library/Fonts/Supplemental",
  expand("~/.local/share/fonts")!, expand("~/.fonts")!, "/usr/share/fonts", "/usr/local/share/fonts",
]

/// The faces of `family`, looked for in every font file there is: the
/// regular as `path#face`, and the bold's, "" when it has none.
effect fn by_family(family: String) -> Option[(String, String)] = {
  var found: List[(String, fontname.Face)] = []
  for dir in font_dirs()! {
    if fs.is_dir(dir) then {
      let files = match fs.walk(dir) {
        ok(fs_) => fs_,
        err(_) => [],
      }
      for f in files {
        let lower = string.to_lower(f)
        if string.ends_with(lower, ".ttf") or string.ends_with(lower, ".otf") or string.ends_with(lower, ".ttc") then {
          let data = sys.read_file(f)
          for face in fontname.faces(data) {
            list.push(found, (f, face))
          }
        }
      }
    }
  }
  match fontname.choose(found, family) {
    some(((path, face), bold)) => some(("${path}#${int.to_string(face)}", match bold {
      some((bp, bf)) => "${bp}#${int.to_string(bf)}",
      none => "",
    })),
    none => none,
  }
}

/// The first monospace face this system has, with the path of its bold.
effect fn mono(i: Int) -> Option[(sfnt.Font, String)] =
  if i >= list.len(MONO) then none
  else {
    let (regular, bold) = MONO[i]
    match load(expand(regular)!) {
      some(f) => some((f, if bold == "" then "" else expand(bold)!)),
      none => mono(i + 1)!,
    }
  }

/// The faces to draw with: `family` when it is set and found (else a word
/// on stderr), `SPRID_FONT` when set, else the first monospace face here.
effect fn find(family: String) -> Option[Faces] = {
  let named = if family == "" then none else match by_family(family)! {
    some((regular, bold)) => match load(regular) {
      some(f) => some((f, bold)),
      none => none,
    },
    none => {
      eprintln("sprid: no font family \"${family}\" found; using the default")
      none
    },
  }
  let custom = match named {
    some(n) => some(n),
    none => match env.get("SPRID_FONT") {
      some(p) => match load(p) { some(f) => some((f, "")), none => none },
      none => none,
    },
  }
  let grid = match custom { some(c) => some(c), none => mono(0)! }
  var fallbacks: List[String] = []
  for path in FALLBACK {
    if fs.exists(path) then list.push(fallbacks, path)
  }
  match grid {
    some((f, bold)) => some(Faces { regular: f, bold_path: bold, fallback_paths: fallbacks }),
    none => none,
  }
}
