// Tabs: a shell on a PTY with its terminal and view, opened, laid out,
// closed, named; their output read.

import bytes
import self.gui.dialog
import self.gui.render
import self.pty
import self.sys
import self.terminal
import self.view
import self.gui.uistate

/// Longest a synchronized update (mode 2026) may hold the screen, ms.
let SYNC_LIMIT = 150

/// Longest the screen waits while a program has hidden the cursor to draw, ms.
let HIDDEN_LIMIT = 100

/// Longest a read waits for the rest of a screen a program is drawing, ms.
let MID_UPDATE_GAP_MS = 10

/// Longest the screen waits for a full-screen program's first screen, ms.
let FIRST_SCREEN_LIMIT = 1000

/// Longest the screen waits for a program to draw itself again at a new
/// grid size, ms.
let RESIZE_LIMIT = 150

/// One tab: a terminal, the PTY its program runs on, and how it is viewed.
type Tab = {
  t: terminal.Terminal,
  fd: Int,
  // Lines scrolled back into scrollback, 0 at the bottom, and pixels
  // further back than that: a trackpad scrolls by the pixel.
  back: Int,
  shift: Int,
  sel: Option[view.Selection],
  // What `sel` held when it was made (see `view.hold`).
  held: Option[view.Held],
  // The program's updates the frame is held for, and when each began.
  up: Updates,
  // The name the user gave it; "" for the automatic title.
  name: String,
  // A bell or notification came while it wasn't being looked at: its title
  // is marked until it is.
  alert: Bool,
}

/// The latest synchronized update and redraw with the cursor hidden that
/// the tab's program began — by the terminal's counts of them — and when
/// each was first seen, ms. A hold is timed from the start of the update it
/// is for: timed from the first of a run of them, a program that keeps the
/// cursor hidden, drawing in synchronized updates, would soon have none of
/// them held, and its half-drawn screens shown. `resized_at`: when the grid
/// changed size and the program has not yet answered by drawing, -1 when it
/// has.
type Updates = { syncs: Int, sync_at: Int, hides: Int, hide_at: Int, resized_at: Int }

let NO_UPDATES = Updates { syncs: 0, sync_at: 0, hides: 0, hide_at: 0, resized_at: -1 }

/// Whether tab `i` may close: at once when its shell waits at the prompt,
/// else when the user says so — closing ends what runs in it.
fn may_close_tab(tabs: List[Tab], i: Int, ja: Bool) -> Bool = {
  let running = pty.busy(fd_of(tabs, i))
  running == "" or (if ja then dialog.confirm("このタブを閉じますか？", "「${running}」が実行中です。閉じると終了します。", "閉じる", "キャンセル")
    else dialog.confirm("Close this tab?", "${running} is still running in it, and will be ended.", "Close", "Cancel"))
}

/// Whether the window may close: at once when every shell waits at its
/// prompt, else when the user says so.
fn may_close_window(tabs: List[Tab], ja: Bool) -> Bool = {
  let running = list.map(tabs, (tb) => pty.busy(tb.fd)) |> list.filter((n) => n != "")
  let n = list.len(running)
  let names = list.join(list.take(running, 3), ", ") + (if n > 3 then ", …" else "")
  n == 0 or (if ja then dialog.confirm("ウィンドウを閉じますか？", "${int.to_string(n)} 個のタブでプログラムが実行中です（${names}）。閉じると終了します。", "閉じる", "キャンセル")
    else dialog.confirm("Close the window?", "Programs are running in ${int.to_string(n)} tab${if n > 1 then "s" else ""} (${names}), and will be ended.", "Close", "Cancel"))
}

/// Reflow every tab's scrollback to the size the window settled at.
fn settle_all(mut tabs: List[Tab]) -> Unit = {
  for i in 0..<list.len(tabs) {
    match take(tabs, i) {
      some(tb) => {
        var cur = tb
        if cur.t.reflow_pending then {
          terminal.settle(cur.t)
          scroll_to(cur, 0)
          cur.sel = none
        }
        list.push(tabs, cur)
        tabs = list.swap(tabs, i, list.len(tabs) - 1)
      },
      none => (),
    }
  }
}

/// Tab `i`, taken out of `tabs`: the last tab moves into its place until the
/// caller pushes it back and swaps it home.
fn take(mut tabs: List[Tab], i: Int) -> Option[Tab] = {
  guard i >= 0 and i < list.len(tabs) else none
  tabs = list.swap(tabs, i, list.len(tabs) - 1)
  list.pop(tabs)
}

/// `xs` with the item at `from` moved to `to`, the others keeping their
/// order — swapped along, not copied out (see `take`).
fn move_to[T](xs: List[T], from: Int, to: Int) -> List[T] = {
  var out = xs
  var at = from
  let step = if to > from then 1 else -1
  while at != to {
    out = list.swap(out, at, at + step)
    at = at + step
  }
  out
}

/// Note the updates `tb`'s program has begun since last looked at, as
/// beginning `now`.
fn note_updates(mut tb: Tab, now: Int) -> Unit = {
  let t = tb.t
  if t.sync_starts != tb.up.syncs then tb.up = { ...tb.up, syncs: t.sync_starts, sync_at: now }
  if t.hide_starts != tb.up.hides then tb.up = { ...tb.up, hides: t.hide_starts, hide_at: now }
}

/// How much longer the frame is held for `tb`'s program to finish drawing,
/// ms; 0 when it isn't. A synchronized update is asked for, a hidden cursor
/// only suggests one — but a program's first full screen comes while it is
/// still starting up, its pieces hundreds of ms apart, and until it is whole
/// the screen before it is the better one to show. So is the screen before
/// a resize, until the program has drawn itself again at the new size: what
/// it drew for the old one, wrapped or cut to the new, is not a screen it
/// ever drew.
fn hold_left(tb: Tab, now: Int) -> Int = {
  let t = tb.t
  let sync = if t.sync_output then tb.up.sync_at + SYNC_LIMIT - now else 0
  let hidden = if terminal.drawing_hidden(t) then tb.up.hide_at + (if t.first_screen then FIRST_SCREEN_LIMIT else HIDDEN_LIMIT) - now else 0
  let resized = if tb.up.resized_at >= 0 then tb.up.resized_at + RESIZE_LIMIT - now else 0
  int.max(0, int.max(sync, int.max(hidden, resized)))
}

/// How long the active tab's program may still hold the frame, ms.
fn sync_wait(tabs: List[Tab], active: Int, now: Int) -> Int = match list.get(tabs, active) {
  some(tb) => hold_left(tb, now),
  none => 0,
}

fn fd_of(tabs: List[Tab], i: Int) -> Int = match list.get(tabs, i) {
  some(tb) => tb.fd,
  none => -1,
}

/// Where a tab opened from tab `i` starts: where the program in front there
/// is, else where its shell last said it was, else `home`.
fn cwd_of(tabs: List[Tab], i: Int, home: String) -> String = match list.get(tabs, i) {
  some(tb) => {
    let now = pty.cwd(tb.fd)
    if now != "" then now else if tb.t.cwd != "" then tb.t.cwd else home
  },
  none => home,
}

/// A new tab (a pane) running `command` in `cwd`, `cols` x `rows`.
fn open_tab(cols: Int, rows: Int, command: String, cwd: String, scrollback: Int) -> Option[Tab] = {
  let fd = pty.spawn(command, cwd, cols, rows)
  if fd < 0 then none
  else some(Tab { t: terminal.with_scrollback(cols, rows, scrollback), fd: fd, back: 0, shift: 0, sel: none, held: none, up: NO_UPDATES, name: "", alert: false })
}

/// Close tab `i` and its program, keeping the other tabs in order.
fn close_tab(mut tabs: List[Tab], i: Int) -> Unit = {
  let n = list.len(tabs)
  if i >= 0 and i < n then {
    var j = i
    while j < n - 1 {
      tabs = list.swap(tabs, j, j + 1)
      j = j + 1
    }
    match list.pop(tabs) {
      some(tb) => pty.close(tb.fd),
      none => (),
    }
  }
}

/// Every tab (pane) fitted to its size in `sizes`, (fd, (cols, rows)):
/// `live` while the size is still changing — scrollback is reflowed once it
/// holds (`settle_all`) — and, `hold`, its frame held for its program to
/// draw itself again (`hold_left`); a window being resized is drawn at once.
fn fit(mut tabs: List[Tab], sizes: List[(Int, (Int, Int))], live: Bool, hold: Bool) -> Unit = {
  for i in 0..<list.len(tabs) {
    match take(tabs, i) {
      some(tb) => {
        var cur = tb
        // FIXME(almide#3177): read `cur.fd` in the closure once doing so
        // doesn't lose the resize below.
        let fd = cur.fd
        let (cols, rows) = list.find(sizes, (e) => e.0 == fd) |> option.map((e) => e.1) ?? (cur.t.cols, cur.t.rows)
        if cur.t.cols != cols or cur.t.rows != rows then {
          if live then terminal.resize_live(cur.t, cols, rows) else terminal.resize(cur.t, cols, rows)
          let _ = pty.resize(cur.fd, cols, rows)
          // Lines are numbered anew: a view scrolled back or a selection
          // would point at other lines.
          scroll_to(cur, 0)
          cur.sel = none
          // Timed from the first of a run of resizes, as a held update is.
          if hold and cur.up.resized_at < 0 then cur.up = { ...cur.up, resized_at: sys.now_ms() }
        }
        list.push(tabs, cur)
        tabs = list.swap(tabs, i, list.len(tabs) - 1)
      },
      none => (),
    }
  }
}

/// What a tab is called: the name the user gave it, else the title its
/// program set, else its directory's name, else the shell's.
fn title_of(tb: Tab, home: String) -> String = {
  let t = tb.t
  // The directory the shell reported, else the one its foreground program
  // is in (a shell that reports nothing still gets a useful title).
  let dir = if t.cwd != "" then t.cwd else pty.cwd(tb.fd)
  if tb.name != "" then tb.name
  else if t.title != "" then t.title
  else if dir != "" and dir == home then "~"
  else if dir != "" then {
    let parts = string.split(dir, "/") |> list.filter((p) => p != "")
    list.last(parts) ?? "/"
  } else "shell"
}

/// Feed the tab everything its program has written, up to `budget_ms` of
/// work: (whether there was any, whether it stopped at the budget with more
/// still coming). `front`: the tab is the one drawn.
fn drain(mut tb: Tab, budget_ms: Int, front: Bool) -> (Bool, Bool) = {
  let until = sys.now_ms() + budget_ms
  let screen_before = view.screen_line(tb.t)
  var data = pty.read(tb.fd, 0)
  var got = false
  var more = false
  while bytes.len(data) > 0 {
    terminal.feed(tb.t, data)
    got = true
    note_updates(tb, sys.now_ms())
    // Wait a moment for more: a writer refills the PTY 1 KB at a time, and
    // giving up in the gap costs a whole turn of the loop. In the middle of
    // a screen the frame is held for (see `hold_left`) the rest is surely
    // coming, and a program that writes only as fast as it is read — a
    // full-screen redraw comes 1 KB per turn — is kept waiting by every turn
    // not spent reading. A tab in the back has no frame to hold, and waiting
    // on it would keep the one in front waiting.
    let gap = if front and hold_left(tb, sys.now_ms()) > 0 then MID_UPDATE_GAP_MS else 1
    data = if sys.now_ms() < until then pty.read(tb.fd, gap) else {
      more = true
      bytes.new(0)
    }
  }
  // What came after a resize is the program drawing itself at the new size.
  if got then tb.up = { ...tb.up, resized_at: -1 }
  // Scrolled back, the viewport stays on the lines it shows while new ones
  // arrive below.
  if tb.back > 0 or tb.shift > 0 then tb.back = int.min(tb.back + view.screen_line(tb.t) - screen_before, view.max_back(tb.t))
  // At the top of what can be scrolled back — none at all on the alternate
  // screen — there is no part of a line above to show.
  if tb.back >= view.max_back(tb.t) and tb.shift > 0 then {
    tb.back = view.max_back(tb.t)
    tb.shift = 0
  }
  (got, more)
}

/// Remember what the selection holds, before output can change it.
fn hold_sel(mut tb: Tab) -> Unit = match tb.sel {
  some(s) => if (tb.held |> option.map((h) => h.sel)) != some(s) then { tb.held = some(view.hold(tb.t, s)) },
  none => { tb.held = none },
}

/// Let go of a selection whose text output has moved or rewritten; whether
/// it did. Not while the program is mid-frame (a synchronized update, a
/// redraw with the cursor hidden, more still to read): half drawn, the
/// text is about to come back.
fn drop_moved_sel(mut tb: Tab, more: Bool) -> Bool = match tb.held {
  some(h) => if more or hold_left(tb, sys.now_ms()) > 0 or not view.moved(tb.t, h) then false else {
    tb.sel = none
    tb.held = none
    true
  },
  none => false,
}

/// Whether the cursor of the tab in front blinks: a blinking DECSCUSR shape,
/// the program's or the config's, shown.
fn cursor_blinks(tabs: List[Tab], active: Int, r: render.Renderer) -> Bool = match list.get(tabs, active) {
  some(tb) => {
    let shape = if tb.t.cursor_shape == 0 then r.cursor_default else tb.t.cursor_shape
    tb.t.cursor_visible and int.band(shape, 1) == 1
  },
  none => false,
}

/// Scroll `tb` to `back` lines into scrollback, on a line's edge.
fn scroll_to(mut tb: Tab, back: Int) -> Unit = {
  tb.back = back
  tb.shift = 0
}

test "a tab moved keeps the others in order" {
  assert_eq(move_to([0, 1, 2, 3], 0, 2), [1, 2, 0, 3])
  assert_eq(move_to([0, 1, 2, 3], 3, 1), [0, 3, 1, 2])
  assert_eq(move_to([0, 1, 2], 1, 1), [0, 1, 2])
}

test "a resized tab's frame waits for its program to draw again, no longer than the limit" {
  let tb = Tab { t: terminal.new(10, 3), fd: -1, back: 0, shift: 0, sel: none, held: none, up: { ...NO_UPDATES, resized_at: 1000 }, name: "", alert: false }
  assert_eq(hold_left(tb, 1040), RESIZE_LIMIT - 40)
  assert_eq(hold_left(tb, 1000 + RESIZE_LIMIT), 0)
  assert_eq(hold_left({ ...tb, up: NO_UPDATES }, 1040), 0)
}
