// Split panes: how a tab's area is divided among its panes. A layout is a
// tree — a pane, or an area split across (side by side) or down (one above
// the other) at a fraction, each part a layout of its own — so closing a
// pane gives its space back to what it was split from, and every divider
// runs the whole length of what it divides.

/// A pane, by id; or a split: across or down, the first part's fraction,
/// the two parts.
type Layout = | Pane(Int) | Split(Bool, Float, Layout, Layout)

/// A tab of the tab bar: its panes as laid out, by their PTYs; the one in
/// front, which keys go to; and whether that one fills the tab for now
/// (zoomed).
type Group = { layout: Layout, focus: Int, zoomed: Bool }

/// A tab of one pane.
fn single(id: Int) -> Group = Group { layout: Pane(id), focus: id, zoomed: false }

/// A pane's region: its id and its rectangle (x, y, width, height), pixels.
type Region = { id: Int, x: Int, y: Int, w: Int, h: Int }

/// A divider: the split it is — `path` the way down to it, 0 into the
/// first part and 1 into the second — across or down, where it is (`at`, x
/// across, y down) and the rectangle of what it splits.
type Divider = { path: List[Int], across: Bool, at: Int, x: Int, y: Int, w: Int, h: Int }

/// The least a part may be of what it splits.
let MIN_FRACTION = 0.1

/// The panes, in reading order.
fn panes(l: Layout) -> List[Int] = match l {
  Pane(id) => [id],
  Split(_, _, a, b) => panes(a) + panes(b),
}

fn contains(l: Layout, id: Int) -> Bool = list.contains(panes(l), id)

/// `l` with pane `id` split in two: `id` keeps the first half (left or
/// top), `fresh` takes the other.
fn split(l: Layout, id: Int, fresh: Int, across: Bool) -> Layout = match l {
  Pane(p) => if p == id then Split(across, 0.5, Pane(p), Pane(fresh)) else Pane(p),
  Split(dir, f, a, b) => Split(dir, f, split(a, id, fresh, across), split(b, id, fresh, across)),
}

/// `l` without pane `id`: what it was split from takes its place. None when
/// it was the only pane.
fn remove(l: Layout, id: Int) -> Option[Layout] = match l {
  Pane(p) => if p == id then none else some(Pane(p)),
  Split(dir, f, a, b) => match (remove(a, id), remove(b, id)) {
    (some(a2), some(b2)) => some(Split(dir, f, a2, b2)),
    (some(a2), none) => some(a2),
    (none, some(b2)) => some(b2),
    (none, none) => none,
  },
}

/// Where each pane goes in the rectangle (`x`, `y`, `w`, `h`), `gap` pixels
/// between parts.
fn regions(l: Layout, x: Int, y: Int, w: Int, h: Int, gap: Int) -> List[Region] = match l {
  Pane(id) => [Region { id: id, x: x, y: y, w: w, h: h }],
  Split(across, f, a, b) => if across then {
    let first = part(w, gap, f)
    regions(a, x, y, first, h, gap) + regions(b, x + first + gap, y, int.max(1, w - first - gap), h, gap)
  } else {
    let first = part(h, gap, f)
    regions(a, x, y, w, first, gap) + regions(b, x, y + first + gap, w, int.max(1, h - first - gap), gap)
  },
}

/// The first part's length, of `len` split at `f` with `gap` between.
fn part(len: Int, gap: Int, f: Float) -> Int = int.max(1, float.to_int(int.to_float(len - gap) * f))

/// Every divider, outermost first, laid out as `regions` lays the panes.
fn dividers(l: Layout, x: Int, y: Int, w: Int, h: Int, gap: Int) -> List[Divider] = dividers_in(l, [], x, y, w, h, gap)

fn dividers_in(l: Layout, path: List[Int], x: Int, y: Int, w: Int, h: Int, gap: Int) -> List[Divider] = match l {
  Pane(_) => [],
  Split(across, f, a, b) => if across then {
    let first = part(w, gap, f)
    [Divider { path: path, across: true, at: x + first, x: x, y: y, w: w, h: h }]
      + dividers_in(a, path + [0], x, y, first, h, gap) + dividers_in(b, path + [1], x + first + gap, y, int.max(1, w - first - gap), h, gap)
  } else {
    let first = part(h, gap, f)
    [Divider { path: path, across: false, at: y + first, x: x, y: y, w: w, h: h }]
      + dividers_in(a, path + [0], x, y, w, first, gap) + dividers_in(b, path + [1], x, y + first + gap, w, int.max(1, h - first - gap), gap)
  },
}

/// The divider within `slop` pixels of (`px`, `py`), if one is; the
/// innermost where two meet.
fn divider_at(ds: List[Divider], px: Int, py: Int, slop: Int) -> Option[Divider] =
  list.reverse(ds) |> list.find((d) =>
    if d.across then int.abs(px - d.at) <= slop and py >= d.y and py < d.y + d.h
    else int.abs(py - d.at) <= slop and px >= d.x and px < d.x + d.w)

/// The fraction divider `d` splits at with the pointer at (`px`, `py`).
fn fraction_at(d: Divider, px: Int, py: Int, gap: Int) -> Float = {
  let (from, len) = if d.across then (px - d.x, d.w) else (py - d.y, d.h)
  clamp(int.to_float(from) / int.to_float(int.max(1, len - gap)))
}

/// `l` with the split at `path` (see `Divider`) at fraction `f`.
fn set_fraction(l: Layout, path: List[Int], f: Float) -> Layout = match l {
  Pane(id) => Pane(id),
  Split(across, g, a, b) => match list.first(path) {
    none => Split(across, f, a, b),
    some(0) => Split(across, g, set_fraction(a, list.drop(path, 1), f), b),
    some(_) => Split(across, g, a, set_fraction(b, list.drop(path, 1), f)),
  },
}

/// The pane at pixel (`px`, `py`), if one is there.
fn pane_at(regions: List[Region], px: Int, py: Int) -> Option[Int] =
  list.find(regions, (p) => px >= p.x and px < p.x + p.w and py >= p.y and py < p.y + p.h) |> option.map((p) => p.id)

/// The pane next to `id` toward (`dx`, `dy`) — one of them -1 or 1 — the
/// nearest whose side faces it and overlaps it; none at the edge.
fn neighbor(regions: List[Region], id: Int, dx: Int, dy: Int) -> Option[Int] =
  match list.find(regions, (p) => p.id == id) {
    some(from) => regions
      |> list.filter((p) => p.id != id and faces(from, p, dx, dy))
      |> list.sort_by((p) => distance(from, p, dx, dy))
      |> list.first
      |> option.map((p) => p.id),
    none => none,
  }

/// Whether `p` lies past `from` toward (`dx`, `dy`), overlapping it on the
/// other axis.
fn faces(from: Region, p: Region, dx: Int, dy: Int) -> Bool =
  if dx != 0 then (if dx > 0 then p.x >= from.x + from.w else p.x + p.w <= from.x) and p.y < from.y + from.h and p.y + p.h > from.y
  else (if dy > 0 then p.y >= from.y + from.h else p.y + p.h <= from.y) and p.x < from.x + from.w and p.x + p.w > from.x

fn distance(from: Region, p: Region, dx: Int, dy: Int) -> Int =
  if dx > 0 then p.x - (from.x + from.w)
  else if dx < 0 then from.x - (p.x + p.w)
  else if dy > 0 then p.y - (from.y + from.h)
  else from.y - (p.y + p.h)

/// `l` with the divider nearest pane `id` across the way (`dx`, `dy`)
/// points — the innermost split of it on that axis — moved that way by
/// `step` of what it splits. Unchanged when there is none.
fn resize(l: Layout, id: Int, dx: Int, dy: Int, step: Float) -> Layout = match nudge(l, id, dx, dy, step) {
  some(l2) => l2,
  none => l,
}

/// `resize`, none when this part has no divider on that axis around `id`.
fn nudge(l: Layout, id: Int, dx: Int, dy: Int, step: Float) -> Option[Layout] = match l {
  Pane(_) => none,
  Split(across, f, a, b) => if not contains(l, id) then none else match deeper(across, f, a, b, id, dx, dy, step) {
    some(found) => some(found),
    none => own(across, f, a, b, dx, dy, step),
  },
}

/// The split of parts `a` and `b` with a divider inside one of them moved.
fn deeper(across: Bool, f: Float, a: Layout, b: Layout, id: Int, dx: Int, dy: Int, step: Float) -> Option[Layout] =
  // FIXME(almide#3174): `|> option.map((a2) => Split(across, f, a2, b))`
  // once a closure may capture a recursive variant's field.
  match nudge(a, id, dx, dy, step) {
    some(a2) => some(Split(across, f, a2, b)),
    none => match nudge(b, id, dx, dy, step) {
      some(b2) => some(Split(across, f, a, b2)),
      none => none,
    },
  }

/// The split of parts `a` and `b` with its own divider moved, when it runs
/// across the way asked.
fn own(across: Bool, f: Float, a: Layout, b: Layout, dx: Int, dy: Int, step: Float) -> Option[Layout] = {
  let along = if across then dx else dy
  if along == 0 then none else some(Split(across, clamp(f + int.to_float(along) * step), a, b))
}

fn clamp(f: Float) -> Float = float.clamp(f, MIN_FRACTION, 1.0 - MIN_FRACTION)

/// `l` with every split at half again.
fn equalize(l: Layout) -> Layout = match l {
  Pane(id) => Pane(id),
  Split(across, _, a, b) => Split(across, 0.5, equalize(a), equalize(b)),
}

// ── Tests ─────────────────────────────────────────────────────────────────

fn sample() -> Layout = split(split(Pane(1), 1, 2, true), 2, 3, false)

test "splitting and closing panes" {
  let l = sample()
  assert_eq(panes(l), [1, 2, 3])
  assert_eq(remove(l, 2) |> option.map(panes), some([1, 3]))
  // Closing 1 gives the whole width to the column it was split from.
  assert_eq(remove(l, 1), some(Split(false, 0.5, Pane(2), Pane(3))))
  assert_eq(remove(Pane(1), 1), none)
}

test "regions, the pane under a point, and neighbours" {
  let ps = regions(sample(), 0, 0, 101, 51, 1)
  assert_eq(list.map(ps, (p) => (p.id, p.x, p.y, p.w, p.h)), [(1, 0, 0, 50, 51), (2, 51, 0, 50, 25), (3, 51, 26, 50, 25)])
  assert_eq((pane_at(ps, 10, 40), pane_at(ps, 60, 40), pane_at(ps, 50, 10)), (some(1), some(3), none))
  assert_eq((neighbor(ps, 1, 1, 0), neighbor(ps, 3, 0, -1), neighbor(ps, 2, -1, 0), neighbor(ps, 1, -1, 0)), (some(2), some(2), some(1), none))
}

test "dividers: where they are, the one under a point, dragging one" {
  let ds = dividers(sample(), 0, 0, 101, 51, 1)
  assert_eq(list.map(ds, (d) => (d.path, d.across, d.at)), [([], true, 50), ([1], false, 25)])
  assert_eq(divider_at(ds, 52, 10, 2) |> option.map((d) => d.path), some([]))
  // Where the two meet, the inner one.
  assert_eq(divider_at(ds, 52, 25, 2) |> option.map((d) => d.path), some([1]))
  assert_eq(divider_at(ds, 20, 10, 2), none)
  assert_eq(set_fraction(sample(), [1], fraction_at(ds[1], 60, 10, 1)), Split(true, 0.5, Pane(1), Split(false, 0.2, Pane(2), Pane(3))))
  assert_eq(set_fraction(sample(), [], fraction_at(ds[0], 1, 10, 1)), Split(true, MIN_FRACTION, Pane(1), Split(false, 0.5, Pane(2), Pane(3))))
}

test "resizing moves the nearest divider the way asked" {
  let l = sample()
  // Across from pane 1: the outer divider, right and back left.
  assert_eq(resize(l, 1, 1, 0, 0.1), Split(true, 0.6, Pane(1), Split(false, 0.5, Pane(2), Pane(3))))
  assert_eq(resize(l, 3, -1, 0, 0.1), Split(true, 0.4, Pane(1), Split(false, 0.5, Pane(2), Pane(3))))
  // Down from pane 3: the inner one; pane 1 has none on that axis.
  assert_eq(resize(l, 3, 0, -1, 0.1), Split(true, 0.5, Pane(1), Split(false, 0.4, Pane(2), Pane(3))))
  assert_eq(resize(l, 1, 0, 1, 0.1), l)
  assert_eq(resize(resize(l, 1, -1, 0, 0.9), 1, -1, 0, 0.9), Split(true, MIN_FRACTION, Pane(1), Split(false, 0.5, Pane(2), Pane(3))))
}
