// The renderer: its GPU objects, theme and metrics, and where things go in
// the window.

import snaidhm.sfnt as sfnt
import snaidhm.text as text
import self.gui.fonts
import self.gui.emoji
import self.gui.sprite
import self.theme

/// Floats per vertex of the text pipeline: position 2, uv 2, colour 4.
let VERTEX_FLOATS = 8

type Renderer = {
  device: Int,
  // The layer's fonts: the grid face first, then the bold and the fallbacks
  // in the order they were first needed.
  layer: text.TextLayer,
  // Where the bold is in the layer's fonts: -1 not read yet, -2 none.
  bold_index: Int,
  bold_path: String,
  fallback_paths: List[String],
  // Where each fallback read so far is in the layer's fonts, and how many of
  // `fallback_paths` have been tried.
  fallback_indices: List[Int],
  fallbacks_tried: Int,
  size_px: Int,
  cell_w: Int,
  cell_h: Int,
  // The font's own height, ascent to descent, pixels: more than `cell_h`
  // when the cell is set shorter than its glyphs.
  font_h: Int,
  baseline: Int,
  pad_x: Int,
  pad_y: Int,
  // The area of the pane drawn or pointed at now — (x, y, width, height),
  // pixels, its padding included: the window below the tab bar, or its part
  // of a split. The grid sits in it inset by the padding.
  box: (Int, Int, Int, Int),
  line_w: Int,
  // The colours: the theme's, and its 256-colour palette.
  theme: theme.Theme,
  // The cursor's shape when the program sets none (DECSCUSR numbers; 0 a
  // steady bar), whether the window has the focus, and whether a blinking
  // cursor is in its off phase.
  cursor_default: Int,
  focused: Bool,
  blink_off: Bool,
  // The visual bell: the screen lit for a moment.
  flash: Bool,
  palette: List[Int],
  // (code point * 2 + bold) -> glyph cache slot, -1 for no glyph.
  glyphs: Map[Int, Int],
  // Colour emoji: code point -> colour atlas slot, -1 when it has none.
  emojis: Map[Int, Int],
  // Box drawing and block elements, as rectangles for this cell size.
  sprites: Map[Int, List[sprite.Piece]],
  vtx: Int,
  capacity: Int,
  count: Int,
  // Pushing a frame's quads: a glyph or emoji not in the atlas yet can't be
  // made now — uploading it goes through the same staging buffer and would
  // wipe the quads pushed so far — so it is left out, and `missed` asks for
  // another frame, which makes it first.
  pushing: Bool,
  missed: Bool,
  // What was left out, made first thing next frame: (code point, bold), and
  // emoji.
  wanted: List[(Int, Bool)],
  wanted_emoji: List[Int],
  // The tab bar, when its tabs are too many to share it: how far it is
  // scrolled, pixels, and the tab last brought into view (-1: none yet).
  tab_scroll: Int,
  tab_follow: Int,
}

/// `r` in the colours of `t`.
fn with_theme(r: Renderer, t: theme.Theme) -> Renderer = { ...r, theme: t, palette: palette256(t) }

/// The 256-colour palette: the 16 of the theme, the 6x6x6 cube, 24 greys,
/// with the theme's extras over the last two.
fn palette256(t: theme.Theme) -> List[Int] =
  list.fold(t.extra, cube_and_greys(t.ansi), (p, e) => list.set(p, e.0, e.1))

/// The 16 colours, then the 6x6x6 cube and 24 greys of xterm.
fn cube_and_greys(ansi: List[Int]) -> List[Int] = {
  var p = ansi
  let steps = [0, 95, 135, 175, 215, 255]
  for i in 0..<216 {
    let r = steps[i / 36]
    let g = steps[(i / 6) % 6]
    let b = steps[i % 6]
    list.push(p, r * 65536 + g * 256 + b)
  }
  for i in 0..<24 {
    let v = 8 + i * 10
    list.push(p, v * 65536 + v * 256 + v)
  }
  p
}

/// A renderer drawing `faces` at `size_px` pixels per em, the grid inset by
/// `pad_x` x `pad_y` pixels.
fn new(device: Int, faces: fonts.Faces, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> Renderer = {
  let r = Renderer {
    device: device,
    layer: text.new_buffer_layer(device, [faces.regular]),
    bold_index: if faces.bold_path == "" then -2 else -1,
    bold_path: faces.bold_path,
    fallback_paths: faces.fallback_paths,
    fallback_indices: [],
    fallbacks_tried: 0,
    size_px: 0,
    cell_w: 1,
    cell_h: 1,
    font_h: 1,
    baseline: 0,
    pad_x: 0,
    pad_y: 0,
    box: (0, 0, 1, 1),
    line_w: 1,
    theme: theme.default(),
    cursor_default: 0,
    focused: true,
    blink_off: false,
    flash: false,
    palette: palette256(theme.default()),
    glyphs: [:],
    emojis: [:],
    sprites: [:],
    vtx: 0,
    capacity: 0,
    count: 0,
    pushing: false,
    missed: false,
    wanted: [],
    wanted_emoji: [],
    tab_scroll: 0,
    tab_follow: -1,
  }
  with_size(r, size_px, pad_x, pad_y, cell_height)
}

/// `r` drawing at `size_px` pixels per em, inset by `pad_x` x `pad_y`: the
/// cell measured anew, and what was cached for the old cell dropped. The
/// layer, its fonts and its atlas stay — glyphs are cached by size, so going
/// back to a size finds them still there.
fn with_size(r: Renderer, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> Renderer = {
  let size = int.to_float(size_px)
  let grid = r.layer.fonts[0]
  let cell_w = int.max(1, float.to_int(float.round(text.advance_px(r.layer, 0, sfnt.glyph_id(grid, 0x4D), size))))
  let ascent = text.ascent(r.layer, size)
  let natural = ascent + text.descent(r.layer, size)
  let cell_h = int.max(1, float.to_int(float.ceil(natural * cell_height)))
  // Extra line height goes half above, half below.
  let baseline = float.to_int(float.round(ascent + (int.to_float(cell_h) - natural) / 2.0))
  let glyphs: Map[Int, Int] = [:]
  let emojis: Map[Int, Int] = [:]
  let sprites: Map[Int, List[sprite.Piece]] = [:]
  {
    ...r,
    size_px: size_px,
    cell_w: cell_w,
    cell_h: cell_h,
    font_h: int.max(1, float.to_int(float.ceil(natural))),
    baseline: baseline,
    pad_x: pad_x,
    pad_y: pad_y,
    line_w: int.max(1, size_px / 14),
    glyphs: glyphs,
    emojis: emojis,
    sprites: sprites,
  }
}

/// Cell width and height in pixels for `faces` at `size_px`: what `new`
/// works out, without a GPU, so a window can be sized to a grid before it
/// opens.
fn cell_size(faces: fonts.Faces, size_px: Int, cell_height: Float) -> (Int, Int) = {
  let f = faces.regular
  let size = int.to_float(size_px)
  let upem = int.to_float(f.units_per_em)
  let w = int.max(1, float.to_int(float.round(int.to_float(sfnt.advance(f, sfnt.glyph_id(f, 0x4D))) * size / upem)))
  let natural = (int.to_float(f.ascent) - int.to_float(f.descent)) * size / upem
  (w, int.max(1, float.to_int(float.ceil(natural * cell_height))))
}

/// Columns and rows that fit a `width` x `height` drawable with `tabs` tabs
/// open (the tab bar shows from two on).
fn grid_size(r: Renderer, width: Int, height: Int, tabs: Int) -> (Int, Int) = box_grid(r, content_box(r, width, height, tabs))

/// The drawable below the tab bar: a tab's area, split among its panes.
fn content_box(r: Renderer, width: Int, height: Int, tabs: Int) -> (Int, Int, Int, Int) = {
  let top = if tabs > 1 then bar_height(r) else 0
  (0, top, width, int.max(1, height - top))
}

/// Columns and rows of the grid in `box`, inside its padding.
fn box_grid(r: Renderer, box: (Int, Int, Int, Int)) -> (Int, Int) =
  (int.max(1, (box.2 - 2 * r.pad_x) / r.cell_w), int.max(1, (box.3 - 2 * r.pad_y) / r.cell_h))

/// Where the grid of the pane in `r.box` starts, pixels.
fn grid_left(r: Renderer) -> Int = r.box.0 + r.pad_x

fn grid_y(r: Renderer) -> Int = r.box.1 + r.pad_y

/// Height of the tab bar: a row and the padding, the row as tall as its
/// glyphs where the cell is set shorter, so a title stays inside the bar.
fn bar_height(r: Renderer) -> Int = int.max(r.cell_h, r.font_h) + r.pad_y

/// Pixel row the grid starts at: below the tab bar when there is one.
fn grid_top(r: Renderer, tabs: Int) -> Int = r.pad_y + (if tabs > 1 then bar_height(r) else 0)

/// Narrowest a tab gets, in cells: more tabs than fit at this width and the
/// bar scrolls instead, as Terminal's and iTerm2's do.
let TAB_MIN_CELLS = 12

fn tab_min_width(r: Renderer) -> Int = r.cell_w * TAB_MIN_CELLS

/// Whether `tabs` tabs share a bar `width` wide without scrolling it.
fn tabs_fit(r: Renderer, width: Int, tabs: Int) -> Bool = tabs * tab_min_width(r) <= width

/// Tab `i`'s left and right edges on the bar, pixels: the bar shared out
/// while the tabs fit, else each its narrowest, scrolled by `r.tab_scroll`.
fn tab_span(r: Renderer, i: Int, width: Int, tabs: Int) -> (Int, Int) =
  if tabs_fit(r, width, tabs) then (i * width / int.max(1, tabs), (i + 1) * width / int.max(1, tabs))
  else (i * tab_min_width(r) - r.tab_scroll, (i + 1) * tab_min_width(r) - r.tab_scroll)

/// Furthest the tab bar scrolls, pixels.
fn tab_scroll_max(r: Renderer, width: Int, tabs: Int) -> Int = int.max(0, tabs * tab_min_width(r) - width)

/// The tab under pixel `x` of the tab bar, for `tabs` tabs across `width`.
fn tab_at(r: Renderer, x: Int, width: Int, tabs: Int) -> Int =
  if tabs_fit(r, width, tabs) then int.clamp(x * tabs / int.max(1, width), 0, tabs - 1)
  else int.clamp((x + r.tab_scroll) / int.max(1, tab_min_width(r)), 0, tabs - 1)

/// The cell a tab's close button takes, half a cell in from its right edge
/// `x1`: its left and right edges, pixels.
fn close_span(r: Renderer, x1: Int) -> (Int, Int) = (x1 - r.cell_w * 3 / 2, x1 - r.cell_w / 2)

/// Whether pixel `x` of the tab bar is on the close button of tab `i`: its
/// last two cells.
fn on_close(r: Renderer, x: Int, width: Int, tabs: Int, i: Int) -> Bool = {
  let (_, x1) = tab_span(r, i, width, tabs)
  x >= x1 - r.cell_w * 2 and x < x1
}

/// The tab bar scrolled to `to` pixels, kept in range.
fn scroll_tabs(mut r: Renderer, to: Int, width: Int, tabs: Int) -> Unit = {
  r.tab_scroll = int.clamp(to, 0, tab_scroll_max(r, width, tabs))
}

/// The tab bar scrolled as little as brings tab `active` wholly into view —
/// once each time another tab comes to the front, so the wheel may scroll
/// it out of view again — and kept in range as the window or tabs change.
fn follow_tab(mut r: Renderer, active: Int, width: Int, tabs: Int) -> Unit = {
  if active != r.tab_follow then {
    let w = tab_min_width(r)
    let left = active * w
    if left < r.tab_scroll then r.tab_scroll = left
    else if left + w > r.tab_scroll + width then r.tab_scroll = left + w - width
    r.tab_follow = active
  }
  scroll_tabs(r, r.tab_scroll, width, tabs)
}

/// 0xRRGGBB of a cell colour; `fallback` for the default colour.
fn resolve(r: Renderer, color: Int, fallback: Int) -> Int = {
  let kind = int.bshr(color, 24)
  if kind == 1 then r.palette[int.band(color, 0xFF)]
  else if kind == 2 then int.band(color, 0xFFFFFF)
  else fallback
}

fn rgb_floats(rgb: Int) -> (Float, Float, Float) = (
  int.to_float(int.band(int.bshr(rgb, 16), 0xFF)) / 255.0,
  int.to_float(int.band(int.bshr(rgb, 8), 0xFF)) / 255.0,
  int.to_float(int.band(rgb, 0xFF)) / 255.0,
)
