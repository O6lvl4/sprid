// A window's session as it opens: the renderer, the first tab, the input
// state.

import env
import snaidhm.native.window as window
import self.gui.fonts
import self.gui.render
import self.pty
import self.shell
import self.search
import self.field
import self.settings
import self.sys
import self.terminal
import self.gui.tabset
import self.gui.uistate
import self.gui.prefs
import self.gui.session
import self.gui.groups
import self.gui.layout

/// Another window, its first tab's shell started in `cwd`, sized and set up
/// as `from` is; none when it can't be opened.
effect fn open_window(from: session.Session, cwd: String) -> Option[session.Session] = {
  let id = window.open_window("sprid", float.to_int(int.to_float(from.width) / from.scale), float.to_int(int.to_float(from.height) / from.scale))
  guard id > 0 else none
  window.select(id)
  window.set_ime(true)
  let grid = match list.get(from.tabs, from.active) {
    some(tb) => (tb.t.cols, tb.t.rows),
    none => (80, 24),
  }
  let command = if from.capture != none then env.get("SPRID_CAPTURE_CMD") ?? "" else ""
  let fd = pty.spawn(if command != "" then command else shell.command(from.st.shell_integration)!, cwd, grid.0, grid.1)
  // Capturing, each window's frame goes to a file of its own: a.png, a-2.png.
  let capture = from.capture |> option.map((path) => string.replace(path, ".png", "-${int.to_string(id)}.png"))
  if fd < 0 then {
    window.close_window(id)
    none
  } else some(start(id, capture, from.faces, from.st, "", fd, grid)!)
}

/// A window for a tab taken out of `from` — its group and panes — sized and
/// set up as `from` is; none when it can't be opened.
effect fn adopt(from: session.Session, taken: (layout.Group, List[tabset.Tab])) -> Option[session.Session] = {
  let (g, panes) = taken
  let tb = panes[groups.index_of(panes, g.focus)]
  let id = window.open_window("sprid", float.to_int(int.to_float(from.width) / from.scale), float.to_int(int.to_float(from.height) / from.scale))
  guard id > 0 else none
  window.select(id)
  window.set_ime(true)
  var a = start(id, none, from.faces, from.st, "", tb.fd, (tb.t.cols, tb.t.rows))!
  a.tabs = panes
  a.groups = [g]
  a.active = groups.index_of(panes, g.focus)
  a.front = tb.fd
  groups.relayout(a)
  some(a)
}

/// Window `id`'s session as it opens, its first tab on `first_fd`. The
/// window is the selected one.
effect fn start(id: Int, capture: Option[String], faces: fonts.Faces, st: settings.Settings, login: String, first_fd: Int, expected: (Int, Int)) -> session.Session = {
  let scale = window.scale_factor()
  let device = 1
  // The theme also colours what a window being resized uncovers, until it is
  // drawn for its size.
  var r = prefs.styled(render.new(device, faces, float.to_int(float.round(st.font_size * scale)),
    float.to_int(st.pad_x * scale), float.to_int(st.pad_y * scale), st.cell_height), st)!
  // Opened behind another app's window, it has no focus until clicked.
  r.focused = window.focused()
  let width = window.width()
  let height = window.height()
  let (cols, rows) = render.grid_size(r, width, height, 1)
  if (cols, rows) != expected then { let _ = pty.resize(first_fd, cols, rows) } else ()
  let home = env.get("HOME") ?? ""
  var a = session.Session {
    id: id, faces: faces, opening: none, adopting: none, dividing: none,
    capture: capture, home: home,
    // Questions in Japanese on a Japanese system.
    ja: string.starts_with(env.get("LANG") ?? "", "ja"),
    scale: scale, device: device,
    // The config file, watched: saved, it applies at once.
    config_fd: if capture == none then sys.watch(prefs.config_path()!) else -1,
    st: st, r: r,
    tabs: [tabset.Tab { t: terminal.with_scrollback(cols, rows, st.scrollback), fd: first_fd, back: 0, shift: 0, sel: none,
      up: tabset.NO_UPDATES, name: "", alert: false }],
    active: 0, groups: [layout.single(first_fd)], ui: fresh_ui(home), width: width, height: height, font_size: st.font_size,
    blink_at: -1, flash_until: -1, alive: true, last_frame: 0, streaming: false, resized_at: -1,
    front: first_fd, window_title: "", stats: fresh_stats()!,
  }
  if capture != none then staged(a, id, login)!
  a
}

/// What a capture asks for beyond one window of one tab: SPRID_CAPTURE_WINDOWS
/// windows, each opening the next; SPRID_CAPTURE_TABS tabs running `login`;
/// SPRID_CAPTURE_SPLITS, the pane in front split across for each "r" and
/// down for each "d", in turn; then SPRID_CAPTURE_KEYS, inputs apart by
/// spaces (see `typed`).
effect fn staged(mut a: session.Session, id: Int, login: String) -> Unit = {
  let windows = int.parse(env.get("SPRID_CAPTURE_WINDOWS") ?? "1") ?? 1
  if id < windows then a.opening = some("")
  let extra = int.parse(env.get("SPRID_CAPTURE_TABS") ?? "1") ?? 1
  for _ in 1..<extra {
    let (c, r) = groups.new_tab_grid(a)
    match tabset.open_tab(c, r, login, "", a.st.scrollback) {
      some(tb) => groups.add_tab(a, tb),
      none => (),
    }
  }
  if extra > 1 then groups.go_to(a, 0)
  for c in string.chars(env.get("SPRID_CAPTURE_SPLITS") ?? "") {
    let (sc, sr) = groups.split_grid(a, c == "r")
    match tabset.open_tab(sc, sr, login, "", a.st.scrollback) {
      some(tb) => groups.add_pane(a, tb, c == "r"),
      none => (),
    }
  }  for k in string.split(env.get("SPRID_CAPTURE_KEYS") ?? "", " ") { typed(k) }
}

/// An input, "kind:code:mods" — and "@x,y" in points for one of the mouse —
/// queued as if made.
fn typed(input: String) -> Unit = {
  let (head, at) = match string.split(input, "@") {
    [h, xy] => (h, list.map(string.split(xy, ","), (x) => float.parse(x) ?? 0.0)),
    parts => (list.first(parts) ?? "", []),
  }
  let n = list.map(string.split(head, ":"), (x) => int.parse(x) ?? 0)
  if list.len(n) == 3 then {
    if list.len(at) == 2 then window.inject_at(n[0], n[1], n[2], at[0], at[1]) else window.inject(n[0], n[1], n[2])
  }
}

fn fresh_ui(home: String) -> uistate.Ui = uistate.Ui {
  preedit: [], preedit_caret: 0, preedit_from: 0, preedit_to: 0, wheel_acc: 0.0, dragging: false, unit: 0, rect: false, anchor_line: 0, anchor_col: 0,
  anchor_end_line: 0, anchor_end_col: 0, clicks: 0, click_line: 0, click_col: 0, dirty: true,
  renaming: false, draft: "", click_ms: 0, click_tab: -1, tab_drag: -1, home: home, finding: false, find: search.empty(),
  field: field.of(""), find_focus: false, field_drag: false, scroll_drag: false, scroll_grab: 0,
  ime_x: -1, ime_y: -1,
  app_button: -1, report_col: -1, report_row: -1, link: none, pointer: -1,
}

effect fn fresh_stats() -> session.Stats = {
  let auto = list.map(string.split(env.get("SPRID_AUTOSCROLL") ?? "", ","), (x) => float.parse(x) ?? 0.0)
  session.Stats {
    debug: env.get("SPRID_DEBUG") != none, trace: env.get("SPRID_TRACE") != none,
    frames: 0, draw_ms: 0, wakes: 0, wake_report: 0,
    input_at: -1, latency_max: 0, latency_sum: 0, latency_n: 0,
    auto: auto, auto_next: if list.len(auto) == 4 then float.to_int(auto[1]) else -1,
    quit_at: match int.parse(env.get("SPRID_QUIT_MS") ?? "") {
      ok(ms) => sys.now_ms() + ms,
      err(_) => -1,
    },
  }
}

