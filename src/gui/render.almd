// Drawing a terminal's screen into the window.
//
// Every visible thing is a quad of snaidhm's text pipeline — position, atlas
// uv, colour — so one draw call covers a frame: background runs and
// decorations sample the atlas's solid texel, glyphs their rasterized
// coverage. Glyphs are rasterized once per face and size (snaidhm's glyph
// cache) and looked up here by code point.
//
// A frame is built in two passes. The first makes sure every glyph on screen
// is in the atlas; the second streams the quads to the GPU. They can't be
// one: rasterizing a glyph uploads it through the same staging buffer
// (`gpu.begin_data`) the quads are streamed through.
//
// Positions are physical pixels of the drawable, y down, mapped to normal
// space as they are pushed.

import bytes
import snaidhm.web.gpu as gpu
import snaidhm.sfnt as sfnt
import snaidhm.text as text
import self.cell
import self.gui.fonts
import self.gui.sprite
import self.scrollback
import self.terminal
import self.view
import self.width as cell_width

/// Floats per vertex of the text pipeline: position 2, uv 2, colour 4.
let VERTEX_FLOATS = 8

/// Tokyo Night Storm.
let DEFAULT_BG = 0x24283B
let DEFAULT_FG = 0xC0CAF5
let CURSOR = 0xC0CAF5
let SELECTION = 0x364A82
let TAB_BAR = 0x1F2335
let TAB_DIM = 0x737AA2
let TAB_RULE = 0x3B4261
let ACCENT = 0x7AA2F7
let ANSI = [
  0x1D202F, 0xF7768E, 0x9ECE6A, 0xE0AF68, 0x7AA2F7, 0xBB9AF7, 0x7DCFFF, 0xA9B1D6,
  0x414868, 0xF7768E, 0x9ECE6A, 0xE0AF68, 0x7AA2F7, 0xBB9AF7, 0x7DCFFF, 0xC0CAF5,
]

type Renderer = {
  device: Int,
  layer: text.TextLayer,
  n_regular: Int,
  n_bold: Int,
  size_px: Int,
  cell_w: Int,
  cell_h: Int,
  baseline: Int,
  pad_x: Int,
  pad_y: Int,
  line_w: Int,
  palette: List[Int],
  // (code point * 2 + bold) -> glyph cache slot, -1 for no glyph.
  glyphs: Map[Int, Int],
  // Box drawing and block elements, as rectangles for this cell size.
  sprites: Map[Int, List[sprite.Piece]],
  vtx: Int,
  capacity: Int,
  count: Int,
}

/// The 256-colour palette: the 16 of the theme, the 6x6x6 cube, 24 greys.
fn palette256() -> List[Int] = {
  var p = ANSI
  let steps = [0, 95, 135, 175, 215, 255]
  for i in 0..<216 {
    let r = steps[i / 36]
    let g = steps[(i / 6) % 6]
    let b = steps[i % 6]
    list.push(p, r * 65536 + g * 256 + b)
  }
  for i in 0..<24 {
    let v = 8 + i * 10
    list.push(p, v * 65536 + v * 256 + v)
  }
  p
}

/// A renderer drawing `faces` at `size_px` pixels per em, the grid inset by
/// `pad_x` x `pad_y` pixels.
fn new(device: Int, faces: fonts.Faces, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> Renderer = {
  let layer = text.new_layer(device, faces.regular + faces.bold)
  let size = int.to_float(size_px)
  let m = sfnt.pick(faces.regular, 0x4D)
  let cell_w = int.max(1, float.to_int(float.round(text.advance_px(layer, m.0, m.1, size))))
  let ascent = text.ascent(layer, size)
  let natural = ascent + text.descent(layer, size)
  let cell_h = int.max(1, float.to_int(float.ceil(natural * cell_height)))
  // Extra line height goes half above, half below.
  let baseline = float.to_int(float.round(ascent + (int.to_float(cell_h) - natural) / 2.0))
  Renderer {
    device: device,
    layer: layer,
    n_regular: list.len(faces.regular),
    n_bold: list.len(faces.bold),
    size_px: size_px,
    cell_w: cell_w,
    cell_h: cell_h,
    baseline: baseline,
    pad_x: pad_x,
    pad_y: pad_y,
    line_w: int.max(1, size_px / 14),
    palette: palette256(),
    glyphs: [:],
    sprites: [:],
    vtx: 0,
    capacity: 0,
    count: 0,
  }
}

/// Columns and rows that fit a `width` x `height` drawable.
/// Columns and rows that fit a `width` x `height` drawable with `tabs` tabs
/// open (the tab bar shows from two on).
fn grid_size(r: Renderer, width: Int, height: Int, tabs: Int) -> (Int, Int) =
  (int.max(1, (width - 2 * r.pad_x) / r.cell_w), int.max(1, (height - grid_top(r, tabs) - r.pad_y) / r.cell_h))

/// Height of the tab bar.
fn bar_height(r: Renderer) -> Int = r.cell_h + r.pad_y

/// Pixel row the grid starts at: below the tab bar when there is one.
fn grid_top(r: Renderer, tabs: Int) -> Int = r.pad_y + (if tabs > 1 then bar_height(r) else 0)

/// The tab under pixel `x` of the tab bar, for `tabs` tabs across `width`.
fn tab_at(r: Renderer, x: Int, width: Int, tabs: Int) -> Int = int.clamp(x * tabs / int.max(1, width), 0, tabs - 1)

/// 0xRRGGBB of a cell colour; `fallback` for the default colour.
fn resolve(r: Renderer, color: Int, fallback: Int) -> Int = {
  let kind = int.bshr(color, 24)
  if kind == 1 then r.palette[int.band(color, 0xFF)]
  else if kind == 2 then int.band(color, 0xFFFFFF)
  else fallback
}

// ── Glyphs ────────────────────────────────────────────────────────────────

/// The glyph cache slot drawing `cp`, rasterizing it on first use; -1 when no
/// face has it.
fn glyph(mut r: Renderer, cp: Int, bold: Bool) -> Int = {
  let k = cp * 2 + (if bold then 1 else 0)
  match map.get(r.glyphs, k) {
    some(slot) => slot,
    none => {
      let offset = if bold then r.n_regular else 0
      let faces = list.slice(r.layer.fonts, offset, offset + (if bold then r.n_bold else r.n_regular))
      let (fi, gid) = sfnt.pick(faces, cp)
      let slot = if gid == 0 then -1 else {
        let before = list.len(r.layer.rects)
        let device = r.device
        let size_px = r.size_px
        r.layer = text.cached(device, r.layer, offset + fi, gid, size_px)
        // The atlas filled up and started over: every slot we knew is gone.
        if list.len(r.layer.rects) < before then map.clear(r.glyphs)
        map.get(r.layer.keys, text.key(offset + fi, gid, size_px)) ?? -1
      }
      map.insert(r.glyphs, k, slot)
      slot
    }
  }
}

/// The rectangles drawing box-drawing or block character `cp`, made once
/// per character.
fn sprite_pieces(mut r: Renderer, cp: Int) -> List[sprite.Piece] =
  match map.get(r.sprites, cp) {
    some(ps) => ps,
    none => {
      let ps = sprite.pieces(cp, r.cell_w, r.cell_h, r.line_w)
      map.insert(r.sprites, cp, ps)
      ps
    }
  }

// ── Quads ─────────────────────────────────────────────────────────────────

/// Push one quad: pixels (x0, y0)-(x1, y1), atlas uv (u0, v0)-(u1, v1),
/// colour 0xRRGGBB at `alpha`.
fn quad(r: Renderer, x0: Float, y0: Float, x1: Float, y1: Float,
        u0: Float, v0: Float, u1: Float, v1: Float, rgb: Int, alpha: Float,
        sx: Float, sy: Float) -> Unit = {
  let cr = int.to_float(int.band(int.bshr(rgb, 16), 0xFF)) / 255.0
  let cg = int.to_float(int.band(int.bshr(rgb, 8), 0xFF)) / 255.0
  let cb = int.to_float(int.band(rgb, 0xFF)) / 255.0
  let nx0 = x0 * sx - 1.0
  let nx1 = x1 * sx - 1.0
  let ny0 = 1.0 - y0 * sy
  let ny1 = 1.0 - y1 * sy
  vertex(nx0, ny0, u0, v0, cr, cg, cb, alpha)
  vertex(nx1, ny0, u1, v0, cr, cg, cb, alpha)
  vertex(nx0, ny1, u0, v1, cr, cg, cb, alpha)
  vertex(nx0, ny1, u0, v1, cr, cg, cb, alpha)
  vertex(nx1, ny0, u1, v0, cr, cg, cb, alpha)
  vertex(nx1, ny1, u1, v1, cr, cg, cb, alpha)
}

fn vertex(x: Float, y: Float, u: Float, v: Float, cr: Float, cg: Float, cb: Float, a: Float) -> Unit = {
  gpu.push_f32(x)
  gpu.push_f32(y)
  gpu.push_f32(u)
  gpu.push_f32(v)
  gpu.push_f32(cr)
  gpu.push_f32(cg)
  gpu.push_f32(cb)
  gpu.push_f32(a)
}

/// A filled rectangle, sampling the atlas's solid texel.
fn rect(r: Renderer, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int, alpha: Float, sx: Float, sy: Float) -> Unit = {
  let slot = map.get(r.layer.keys, text.SOLID) ?? 0
  let atlas = int.to_float(text.ATLAS)
  let u = (int.to_float(r.layer.rects[slot * 6]) + 0.5) / atlas
  let v = (int.to_float(r.layer.rects[slot * 6 + 1]) + 0.5) / atlas
  quad(r, int.to_float(x0), int.to_float(y0), int.to_float(x1), int.to_float(y1), u, v, u, v, rgb, alpha, sx, sy)
}

/// The glyph in `slot` with its pen at `x` on the baseline `y`.
fn glyph_quad(r: Renderer, slot: Int, x: Int, y: Int, rgb: Int, alpha: Float, sx: Float, sy: Float) -> Unit = {
  let o = slot * 6
  let w = r.layer.rects[o + 2]
  let h = r.layer.rects[o + 3]
  if w > 0 and h > 0 then {
    let left = x + r.layer.rects[o + 4]
    let top = y - r.layer.rects[o + 5]
    let atlas = int.to_float(text.ATLAS)
    let ax = int.to_float(r.layer.rects[o])
    let ay = int.to_float(r.layer.rects[o + 1])
    quad(r, int.to_float(left), int.to_float(top), int.to_float(left + w), int.to_float(top + h),
      ax / atlas, ay / atlas, (ax + int.to_float(w)) / atlas, (ay + int.to_float(h)) / atlas,
      rgb, alpha, sx, sy)
  }
}

// ── Frames ────────────────────────────────────────────────────────────────

/// Draw `t` into the window's current frame: the viewport scrolled `back`
/// lines into scrollback, `sel` highlighted, and `preedit` — what the input
/// method is composing — at the cursor. `width` x `height` is the drawable.
fn draw(mut r: Renderer, t: terminal.Terminal, back: Int, sel: Option[view.Selection],
        preedit: List[Int], width: Int, height: Int, tabs: List[String], active: Int) -> Unit = {
  let gy = grid_top(r, list.len(tabs))
  let titles = if list.len(tabs) > 1 then list.map(tabs, (s) => text.code_points(s)) else []
  let top_line = view.top_line(t, back)
  let lines = list.map(0..<t.rows, (y) => view.line_at(t, top_line + y))

  // Pass 1: every glyph on screen into the atlas.
  r.layer = text.solid(r.device, r.layer)
  var marks_total = 0
  for line in lines {
    match line {
      some(row) => {
        for x in 0..<t.cols {
          let o = x * cell.SIZE
          let cp = bytes.read_u32_le(row.cells, o + cell.OFF_CP)
          if sprite.is_sprite(cp) then {
            marks_total = marks_total + list.len(sprite_pieces(r, cp))
          } else if cp > 32 then {
            let bold = int.band(bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS), cell.ATTR_BOLD) != 0
            let _ = glyph(r, cp, bold)
            for mark in marks(row, x) {
              let _ = glyph(r, mark, bold)
              marks_total = marks_total + 1
            }
          }
        }
      },
      none => (),
    }
  }
  for cp in preedit {
    let _ = glyph(r, cp, false)
  }
  var title_chars = 0
  for title in titles {
    for cp in title {
      let _ = glyph(r, cp, false)
      title_chars = title_chars + 1
    }
  }

  // Room for the worst case: per cell a background, a glyph and two lines,
  // plus marks, the cursor, the scrollbar and the composition.
  let quads = t.rows * t.cols * 4 + marks_total + 3 + list.len(preedit) * 3 + title_chars + list.len(titles) * 3 + 1
  if quads * 6 > r.capacity then {
    r.capacity = quads * 6
    r.vtx = gpu.create_buffer(r.device, r.capacity * VERTEX_FLOATS * 4, int.bor(gpu.VERTEX, gpu.COPY_DST))
  }

  // Pass 2: the quads.
  let sx = 2.0 / int.to_float(width)
  let sy = 2.0 / int.to_float(height)
  var n = 0
  gpu.begin_data()
  for y in 0..<t.rows {
    match lines[y] {
      some(row) => { n = n + draw_row(r, row, top_line + y, sel, gy + y * r.cell_h, t.cols, sx, sy) },
      none => (),
    }
  }

  // The cursor, where its line is in view; the composition over it.
  let cursor_row = view.screen_line(t) + t.y - top_line
  if cursor_row >= 0 and cursor_row < t.rows then {
    let cx = r.pad_x + t.x * r.cell_w
    let ctop = gy + cursor_row * r.cell_h
    if list.len(preedit) > 0 then {
      var px = cx
      for cp in preedit {
        let w = r.cell_w * int.max(1, cell_width.of(cp))
        rect(r, px, ctop, px + w, ctop + r.cell_h, DEFAULT_BG, 1.0, sx, sy)
        let slot = glyph(r, cp, false)
        if slot >= 0 then glyph_quad(r, slot, px, ctop + r.baseline, DEFAULT_FG, 1.0, sx, sy)
        let uy = ctop + r.baseline + r.line_w
        rect(r, px, uy, px + w, uy + r.line_w, DEFAULT_FG, 1.0, sx, sy)
        n = n + 3
        px = px + w
      }
    } else if t.cursor_visible then {
      let shape = t.cursor_shape
      if shape == 1 or shape == 2 then rect(r, cx, ctop, cx + r.cell_w, ctop + r.cell_h, CURSOR, 0.5, sx, sy)
      else if shape == 3 or shape == 4 then rect(r, cx, ctop + r.cell_h - 2 * r.line_w, cx + r.cell_w, ctop + r.cell_h, CURSOR, 1.0, sx, sy)
      else rect(r, cx, ctop, cx + int.max(2, r.line_w * 2), ctop + r.cell_h, CURSOR, 1.0, sx, sy)
      n = n + 1
    }
  }

  // Scrolled back: a thumb on the right edge shows where.
  if back > 0 then {
    let total = view.max_back(t) + t.rows
    let track = height - gy - r.pad_y
    let thumb = int.max(r.cell_h, track * t.rows / total)
    let y0 = gy + (track - thumb) * (view.max_back(t) - back) / int.max(1, view.max_back(t))
    let w = int.max(3, r.pad_x / 3)
    rect(r, width - w - 2, y0, width - 2, y0 + thumb, DEFAULT_FG, 0.35, sx, sy)
    n = n + 1
  }

  if list.len(titles) > 1 then n = n + draw_tabs(r, titles, active, width, sx, sy)

  if n > 0 then gpu.flush_to_buffer(r.device, r.vtx)
  r.count = n * 6

  let (br, bgg, bb) = rgb_floats(DEFAULT_BG)
  let encoder = gpu.begin_encoder(r.device)
  let pass = gpu.begin_render_pass(encoder, br, bgg, bb, 1.0)
  if r.count > 0 then {
    gpu.set_pipeline(pass, r.layer.pipeline)
    gpu.set_bind_group(pass, 0, r.layer.bind_group)
    gpu.set_vertex_buffer(pass, 0, r.vtx)
    gpu.draw(pass, r.count)
  }
  gpu.end_pass(pass)
  gpu.finish_and_submit(r.device, encoder)
}

/// The tab bar: one tab per title, `active` raised to the terminal's
/// background with an accent line, the others on a darker strip. Returns the
/// quads it pushed.
fn draw_tabs(mut r: Renderer, titles: List[List[Int]], active: Int, width: Int, sx: Float, sy: Float) -> Int = {
  let h = bar_height(r)
  let count = list.len(titles)
  var n = 0
  rect(r, 0, 0, width, h, TAB_BAR, 1.0, sx, sy)
  n = n + 1
  for i in 0..<count {
    let x0 = i * width / count
    let x1 = (i + 1) * width / count
    if i == active then {
      rect(r, x0, 0, x1, h, DEFAULT_BG, 1.0, sx, sy)
      rect(r, x0, 0, x1, int.max(2, r.line_w), ACCENT, 1.0, sx, sy)
      n = n + 2
    } else if i > 0 and i != active + 1 then {
      rect(r, x0, h / 4, x0 + int.max(1, r.line_w / 2), h - h / 4, TAB_RULE, 1.0, sx, sy)
      n = n + 1
    }
    // The title, centred, cut to the tab with room to spare on each side.
    let room = int.max(1, (x1 - x0) / r.cell_w - 2)
    let title = titles[i]
    let shown = if list.len(title) > room then list.take(title, int.max(1, room - 1)) + [0x2026] else title
    var w = 0
    for cp in shown {
      w = w + r.cell_w * int.max(1, cell_width.of(cp))
    }
    var pen = x0 + (x1 - x0 - w) / 2
    let baseline = (h - r.cell_h) / 2 + r.baseline
    let color = if i == active then DEFAULT_FG else TAB_DIM
    for cp in shown {
      let slot = glyph(r, cp, false)
      if slot >= 0 then {
        glyph_quad(r, slot, pen, baseline, color, 1.0, sx, sy)
        n = n + 1
      }
      pen = pen + r.cell_w * int.max(1, cell_width.of(cp))
    }
  }
  n
}

/// Quads of one row at pixel row `top`: background runs, glyphs, marks and
/// lines. Returns how many it pushed.
fn draw_row(mut r: Renderer, row: scrollback.Row, line: Int, sel: Option[view.Selection],
            top: Int, cols: Int, sx: Float, sy: Float) -> Int = {
  var n = 0
  var x = 0
  while x < cols {
    let bg = colors(r, row, line, x, sel).1
    var end = x + 1
    while end < cols and colors(r, row, line, end, sel).1 == bg {
      end = end + 1
    }
    if bg != DEFAULT_BG then {
      rect(r, r.pad_x + x * r.cell_w, top, r.pad_x + end * r.cell_w, top + r.cell_h, bg, 1.0, sx, sy)
      n = n + 1
    }
    x = end
  }
  for cx in 0..<cols {
    let o = cx * cell.SIZE
    let cp = bytes.read_u32_le(row.cells, o + cell.OFF_CP)
    let attrs = bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS)
    let fg = colors(r, row, line, cx, sel).0
    let alpha = if int.band(attrs, cell.ATTR_FAINT) != 0 then 0.6 else 1.0
    let bold = int.band(attrs, cell.ATTR_BOLD) != 0
    let left = r.pad_x + cx * r.cell_w
    let w = r.cell_w * int.max(1, bytes.read_u8(row.cells, o + cell.OFF_WIDTH))
    if sprite.is_sprite(cp) and int.band(attrs, cell.ATTR_HIDDEN) == 0 then {
      for p in sprite_pieces(r, cp) {
        rect(r, left + p.x0, top + p.y0, left + p.x1, top + p.y1, fg, alpha * p.alpha, sx, sy)
        n = n + 1
      }
    } else if cp > 32 and int.band(attrs, cell.ATTR_HIDDEN) == 0 then {
      let slot = glyph(r, cp, bold)
      if slot >= 0 then {
        glyph_quad(r, slot, left, top + r.baseline, fg, alpha, sx, sy)
        n = n + 1
      }
      // Combining marks have no advance of their own: fonts draw them back
      // from the pen, which stands after the base character.
      for mark in marks(row, cx) {
        let ms = glyph(r, mark, bold)
        if ms >= 0 then {
          glyph_quad(r, ms, left + w, top + r.baseline, fg, alpha, sx, sy)
          n = n + 1
        }
      }
    }
    if int.band(attrs, cell.ATTR_UNDERLINE + cell.ATTR_DOUBLE_UNDERLINE) != 0 then {
      let uy = top + r.baseline + r.line_w
      rect(r, left, uy, left + w, uy + r.line_w, fg, alpha, sx, sy)
      n = n + 1
    }
    if int.band(attrs, cell.ATTR_STRIKE) != 0 then {
      let y0 = top + r.baseline - r.size_px * 3 / 10
      rect(r, left, y0, left + w, y0 + r.line_w, fg, alpha, sx, sy)
      n = n + 1
    }
  }
  n
}

/// The combining marks on cell `x` worth drawing (joiners and variation
/// selectors only steer how the base is shown).
fn marks(row: scrollback.Row, x: Int) -> List[Int] =
  if int.band(bytes.read_u8(row.cells, x * cell.SIZE + cell.OFF_FLAGS), cell.FLAG_GRAPHEME) == 0 then []
  else text.code_points(map.get_or(row.extras, x, ""))
    |> list.filter((cp) => cp != 0x200D and (cp < 0xFE00 or cp > 0xFE0F))

/// Foreground and background of cell `x` as 0xRRGGBB: inverse and hidden
/// applied, and the selection's colour over it.
fn colors(r: Renderer, row: scrollback.Row, line: Int, x: Int, sel: Option[view.Selection]) -> (Int, Int) = {
  let o = x * cell.SIZE
  let fg = resolve(r, bytes.read_u32_le(row.cells, o + cell.OFF_FG), DEFAULT_FG)
  let bg = resolve(r, bytes.read_u32_le(row.cells, o + cell.OFF_BG), DEFAULT_BG)
  let attrs = bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS)
  let (f, b) = if int.band(attrs, cell.ATTR_INVERSE) != 0 then (bg, fg) else (fg, bg)
  let (f2, b2) = if int.band(attrs, cell.ATTR_HIDDEN) != 0 then (b, b) else (f, b)
  match sel {
    some(s) => if view.selected(s, line, x) then (f2, SELECTION) else (f2, b2),
    none => (f2, b2),
  }
}

fn rgb_floats(rgb: Int) -> (Float, Float, Float) = (
  int.to_float(int.band(int.bshr(rgb, 16), 0xFF)) / 255.0,
  int.to_float(int.band(int.bshr(rgb, 8), 0xFF)) / 255.0,
  int.to_float(int.band(rgb, 0xFF)) / 255.0,
)

