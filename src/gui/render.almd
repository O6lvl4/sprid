// Drawing a terminal's screen into the window.
//
// Every visible thing is a quad of snaidhm's text pipeline — position, atlas
// uv, colour — so one draw call covers a frame: background runs and
// decorations sample the atlas's solid texel, glyphs their rasterized
// coverage. Glyphs are rasterized once per face and size (snaidhm's glyph
// cache) and looked up here by code point.
//
// A frame is built in two passes. The first makes sure every glyph on screen
// is in the atlas; the second streams the quads to the GPU. They can't be
// one: rasterizing a glyph uploads it through the same staging buffer
// (`gpu.begin_data`) the quads are streamed through.
//
// Positions are physical pixels of the drawable, y down, mapped to normal
// space as they are pushed.

import snaidhm.web.gpu as gpu
import snaidhm.text as text
import self.cell
import self.gui.sprite
import self.search
import self.terminal
import self.view
import self.gui.surface
import self.gui.ink
import self.gui.composition
import self.gui.chrome
import self.gui.rowpaint
import self.gui.findbar

/// The renderer (its fields: surface.almd).
type Renderer = surface.Renderer
/// The find bar as drawn (findbar.almd).
type Bar = findbar.Bar
/// The input method's composition (composition.almd).
type Compose = composition.Compose

/// A renderer drawing `faces` at `size_px` pixels per em, the grid inset by
/// `pad_x` x `pad_y` pixels.
fn new(device: Int, faces: fonts.Faces, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> surface.Renderer = surface.new(device, faces, size_px, pad_x, pad_y, cell_height)

/// `r` drawing at `size_px` pixels per em, inset by `pad_x` x `pad_y`: the
/// cell measured anew, and what was cached for the old cell dropped. The
/// layer, its fonts and its atlas stay — glyphs are cached by size, so going
/// back to a size finds them still there.
fn with_size(r: surface.Renderer, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> surface.Renderer = surface.with_size(r, size_px, pad_x, pad_y, cell_height)

/// `r` in the colours of `t`.
fn with_theme(r: surface.Renderer, t: theme.Theme) -> surface.Renderer = surface.with_theme(r, t)

/// Pixel row the grid starts at: below the tab bar when there is one.
fn grid_top(r: surface.Renderer, tabs: Int) -> Int = surface.grid_top(r, tabs)

/// Columns and rows that fit a `width` x `height` drawable with `tabs` tabs
/// open (the tab bar shows from two on).
fn grid_size(r: surface.Renderer, width: Int, height: Int, tabs: Int) -> (Int, Int) = surface.grid_size(r, width, height, tabs)

/// Height of the tab bar.
fn bar_height(r: surface.Renderer) -> Int = surface.bar_height(r)

/// The tab under pixel `x` of the tab bar, for `tabs` tabs across `width`.
fn tab_at(r: surface.Renderer, x: Int, width: Int, tabs: Int) -> Int = surface.tab_at(r, x, width, tabs)

/// Cell width and height in pixels for `faces` at `size_px`: what `new`
/// works out, without a GPU, so a window can be sized to a grid before it
/// opens.
fn cell_size(faces: fonts.Faces, size_px: Int, cell_height: Float) -> (Int, Int) = surface.cell_size(faces, size_px, cell_height)

fn rgb_floats(rgb: Int) -> (Float, Float, Float) = surface.rgb_floats(rgb)

/// Whether pixel (`px`, `py`) is on the find bar.
fn on_bar(r: surface.Renderer, b: findbar.Bar, tabs: Int, width: Int, px: Int, py: Int) -> Bool = findbar.on_bar(r, b, tabs, width, px, py)

/// The caret position in the field nearest pixel column `px`.
fn field_index_at(r: surface.Renderer, b: findbar.Bar, tabs: Int, width: Int, px: Int) -> Int = findbar.field_index_at(r, b, tabs, width, px)

/// Where the find bar's caret is: (x, y) of the cell it stands in, pixels.
fn find_caret(r: surface.Renderer, b: findbar.Bar, preedit: List[Int], tabs: Int, width: Int) -> (Int, Int) = findbar.find_caret(r, b, preedit, tabs, width)

/// The scrollbar thumb's top and bottom, pixels, for the view scrolled
/// `back` lines and `shift` pixels.
fn thumb(r: surface.Renderer, t: terminal.Terminal, back: Int, shift: Int, tabs: Int, height: Int) -> (Int, Int) = chrome.thumb(r, t, back, shift, tabs, height)

/// Where the view is scrolled to, pixels back, with the thumb's top at `y`.
fn scroll_pos_at(r: surface.Renderer, t: terminal.Terminal, tabs: Int, height: Int, y: Int) -> Int = chrome.scroll_pos_at(r, t, tabs, height, y)

/// Whether pixel column `x` is on the scrollbar: the right margin, while
/// there is scrollback to scroll.
fn on_scrollbar(r: surface.Renderer, t: terminal.Terminal, width: Int, x: Int) -> Bool = chrome.on_scrollbar(r, t, width, x)

/// The part of a composition shown, and where: characters [`a`, `b`) from
/// column `x0` of the cursor's row. As terminals commonly lay it out: on
/// the cursor's row, over its cells, from the cursor — moved left to end
/// within the row; wider than the row, its end is shown, or from the input
/// method's caret on when the caret is before that.
fn compose_span(c: composition.Compose, x: Int, cols: Int) -> (Int, Int, Int) = composition.compose_span(c, x, cols)

/// The column of the input method's caret in a composition at column `x`:
/// where its candidates go.
fn compose_caret(c: composition.Compose, x: Int, cols: Int) -> Int = composition.compose_caret(c, x, cols)

/// Draw `t` into the window's current frame: the viewport scrolled `back`
/// lines and `shift` pixels into scrollback, `sel` highlighted, and `compose`
/// — what the input method is composing — at the cursor. `width` x `height`
/// is the drawable. With `find`, its matches are marked and its bar is shown
/// — while the bar has the focus, with the composition in it.
fn draw(mut r: surface.Renderer, t: terminal.Terminal, back: Int, shift: Int, sel: Option[view.Selection],
        compose: composition.Compose, width: Int, height: Int, tabs: List[String], active: Int,
        find: Option[findbar.Bar]) -> Unit = {
  let preedit = compose.cps
  let gy = surface.grid_top(r, list.len(tabs))
  let titles = if list.len(tabs) > 1 then list.map(tabs, (s) => text.code_points(s)) else []
  // Scrolled by part of a line, the line above the viewport shows in part at
  // its top: one row more is drawn, from `shift` pixels less than a row
  // above the grid, and what falls outside the grid is covered.
  let extra = if shift > 0 then 1 else 0
  let top_line = view.top_line(t, back) - extra
  let shown = t.rows + extra
  let row_y = gy - (if extra == 1 then r.cell_h - shift else 0)
  // A composition is drawn over the cursor's row (see `compose_span`).
  let composing = list.len(preedit) > 0 and (match find { some(b) => not b.focused, none => true })
  let lines = list.map(0..<shown, (y) => view.line_at(t, top_line + y))
  let query = match find { some(b) => b.find.query, none => "" }
  // The matches on each row, and the current one's columns where it is.
  let found = list.map(lines, (line) => match line {
    some(row) => search.row_spans(row, t.cols, query),
    none => [],
  })
  let current = match find {
    some(b) => if b.find.index >= 0 then (b.find.line - top_line, b.find.from, b.find.to) else (-1, 0, 0),
    none => (-1, 0, 0),
  }
  let bar = match find {
    some(b) => findbar.bar_chars(b, preedit) + findbar.find_count(b.find),
    none => [],
  }

  // Pass 1: every glyph on screen into the atlas.
  r.layer = text.solid(r.device, r.layer)
  var marks_total = 0
  for line in lines {
    match line {
      some(row) => {
        for x in 0..<t.cols {
          let o = x * cell.SIZE
          let cp = bytes.read_u32_le(row.cells, o + cell.OFF_CP)
          if sprite.is_sprite(cp) then {
            marks_total = marks_total + list.len(ink.sprite_pieces(r, cp))
          } else if cp > 32 then {
            let bold = int.band(bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS), cell.ATTR_BOLD) != 0
            if ink.emoji_slot(r, cp) < 0 then {
              let _ = ink.glyph(r, cp, bold)
            }
            for mark in rowpaint.marks(row, x) {
              let _ = ink.glyph(r, mark, bold)
              marks_total = marks_total + 1
            }
          }
        }
      },
      none => (),
    }
  }
  for cp in preedit {
    let _ = ink.glyph(r, cp, false)
  }
  for cp in bar {
    let _ = ink.glyph(r, cp, false)
  }
  // What the last frame had to leave out.
  for w in r.wanted {
    let _ = ink.glyph(r, w.0, w.1)
  }
  for cp in r.wanted_emoji {
    let _ = ink.emoji_slot(r, cp)
  }
  let none_wanted: List[(Int, Bool)] = []
  let no_emoji: List[Int] = []
  r.wanted = none_wanted
  r.wanted_emoji = no_emoji
  // What a title cut short ends with.
  if list.len(titles) > 1 then {
    let _ = ink.glyph(r, 0x2026, false)
  }
  var title_chars = 0
  for title in titles {
    for cp in title {
      let _ = ink.glyph(r, cp, false)
      title_chars = title_chars + 1
    }
  }

  // Room for the worst case: per cell a background, a glyph and two lines,
  // plus marks, the cursor, the scrollbar and the composition.
  let quads = shown * t.cols * 4 + 2 + marks_total + 7 + list.len(preedit) * 3 + title_chars + list.len(titles) * 3 + 1
    + list.len(bar) * 3 + findbar.FIND_QUADS + 1
  if quads * 6 > r.capacity then {
    // Grow by half again, so a count creeping up doesn't replace the buffer
    // every frame, and free the old one: its GPU memory isn't reclaimed
    // otherwise.
    if r.vtx != 0 then gpu.destroy_buffer(r.device, r.vtx)
    r.capacity = int.max(quads * 6, r.capacity * 3 / 2)
    r.vtx = gpu.create_stream_buffer(r.device, r.capacity * surface.VERTEX_FLOATS * 4, int.bor(gpu.VERTEX, gpu.COPY_DST))
  }

  // Pass 2: the quads.
  let sx = 2.0 / int.to_float(width)
  let sy = 2.0 / int.to_float(height)
  var n = 0
  r.missed = false
  r.pushing = true
  gpu.begin_data()
  for y in 0..<shown {
    match lines[y] {
      some(row) => {
        let lit = if current.0 == y then rowpaint.Lit { spans: found[y], from: current.1, to: current.2 } else rowpaint.Lit { spans: found[y], from: -1, to: -1 }
        n = n + rowpaint.draw_row(r, row, top_line + y, sel, lit, row_y + y * r.cell_h, t.cols, sx, sy)
      },
      none => (),
    }
  }
  if extra == 1 then {
    ink.rect(r, 0, 0, width, gy, r.theme.bg, 1.0, sx, sy)
    ink.rect(r, 0, gy + t.rows * r.cell_h, width, height, r.theme.bg, 1.0, sx, sy)
    n = n + 2
  }

  // The cursor, where its line is in view; the composition over it.
  let cursor_row = view.screen_line(t) + t.y - top_line
  if cursor_row >= extra and cursor_row < shown then {
    let cx = r.pad_x + t.x * r.cell_w
    let ctop = row_y + cursor_row * r.cell_h
    if composing then {
      // Underlined, over the cells it covers; the caret a bar, the part being
      // converted boxed. The terminal's cursor is
      // not drawn meanwhile.
      let (x0, ca, cb) = composition.compose_span(compose, t.x, t.cols)
      var px = r.pad_x + x0 * r.cell_w
      var from_x = -1
      var to_x = -1
      var caret_x = if compose.caret == ca then px else -1
      for i in ca..<cb {
        let cp = preedit[i]
        let w = r.cell_w * composition.cell_cols(cp)
        if i == compose.from then from_x = px
        ink.rect(r, px, ctop, px + w, ctop + r.cell_h, r.theme.bg, 1.0, sx, sy)
        let slot = ink.glyph(r, cp, false)
        if slot >= 0 then {
          ink.glyph_quad(r, slot, px, ctop + r.baseline, r.theme.fg, 1.0, sx, sy)
          n = n + 1
        }
        let uy = ctop + r.baseline + r.line_w
        ink.rect(r, px, uy, px + w, uy + r.line_w, r.theme.fg, 1.0, sx, sy)
        n = n + 2
        px = px + w
        if i + 1 == compose.to then to_x = px
        if i + 1 == compose.caret then caret_x = px
      }
      let lw = int.max(1, r.line_w)
      if compose.from < compose.to and from_x >= 0 then {
        let x1 = if to_x >= 0 then to_x else px
        ink.rect(r, from_x, ctop, x1, ctop + lw, r.theme.cursor, 1.0, sx, sy)
        ink.rect(r, from_x, ctop + r.cell_h - lw, x1, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        ink.rect(r, from_x, ctop, from_x + lw, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        ink.rect(r, x1 - lw, ctop, x1, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        n = n + 4
      } else if compose.from >= compose.to and caret_x >= 0 then {
        ink.rect(r, caret_x, ctop, caret_x + int.max(2, r.line_w * 2), ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        n = n + 1
      }
    } else if t.cursor_visible then {
      // The program's shape (DECSCUSR), else the config's.
      let shape = if t.cursor_shape == 0 then r.cursor_default else t.cursor_shape
      let lw = int.max(1, r.line_w)
      if not r.focused then {
        // Keys go elsewhere: a hollow box.
        ink.rect(r, cx, ctop, cx + r.cell_w, ctop + lw, r.theme.cursor, 1.0, sx, sy)
        ink.rect(r, cx, ctop + r.cell_h - lw, cx + r.cell_w, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        ink.rect(r, cx, ctop, cx + lw, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        ink.rect(r, cx + r.cell_w - lw, ctop, cx + r.cell_w, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
        n = n + 3
      } else if r.blink_off and int.band(shape, 1) == 1 then ()
      else if shape == 1 or shape == 2 then ink.rect(r, cx, ctop, cx + r.cell_w, ctop + r.cell_h, r.theme.cursor, 0.5, sx, sy)
      else if shape == 3 or shape == 4 then ink.rect(r, cx, ctop + r.cell_h - 2 * r.line_w, cx + r.cell_w, ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
      else ink.rect(r, cx, ctop, cx + int.max(2, r.line_w * 2), ctop + r.cell_h, r.theme.cursor, 1.0, sx, sy)
      n = n + 1
    }
  }

  // The scrollbar, while there is scrollback: faint at the bottom, plainer
  // scrolled back.
  if view.max_back(t) > 0 then {
    let (y0, y1) = chrome.thumb(r, t, back, shift, list.len(tabs), height)
    let w = chrome.scrollbar_width(r)
    ink.rect(r, width - w - r.pad_x / 4, y0, width - r.pad_x / 4, y1, r.theme.fg, if back > 0 or shift > 0 then 0.4 else 0.2, sx, sy)
    n = n + 1
  }

  if r.flash then {
    ink.rect(r, 0, surface.grid_top(r, list.len(tabs)) - r.pad_y, width, height, r.theme.fg, 0.12, sx, sy)
    n = n + 1
  }

  if list.len(titles) > 1 then n = n + chrome.draw_tabs(r, titles, active, width, sx, sy)
  match find {
    some(b) => { n = n + findbar.draw_find(r, b, preedit, gy, width, sx, sy) },
    none => (),
  }

  r.pushing = false
  if n > 0 then gpu.flush_to_buffer(r.device, r.vtx)
  r.count = n * 6

  let (br, bgg, bb) = surface.rgb_floats(r.theme.bg)
  let encoder = gpu.begin_encoder(r.device)
  let pass = gpu.begin_render_pass(encoder, br, bgg, bb, 1.0)
  if r.count > 0 then {
    gpu.set_pipeline(pass, r.layer.pipeline)
    gpu.set_bind_group(pass, 0, r.layer.bind_group)
    gpu.set_vertex_buffer(pass, 0, r.vtx)
    gpu.draw(pass, r.count)
  }
  gpu.end_pass(pass)
  gpu.finish_and_submit(r.device, encoder)
}
