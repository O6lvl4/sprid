// Drawing a terminal's screen into the window.
//
// Every visible thing is a quad of snaidhm's text pipeline — position, atlas
// uv, colour — so one draw call covers a frame: background runs and
// decorations sample the atlas's solid texel, glyphs their rasterized
// coverage. Glyphs are rasterized once per face and size (snaidhm's glyph
// cache) and looked up here by code point.
//
// A frame is built in two passes. The first makes sure every glyph on screen
// is in the atlas; the second streams the quads to the GPU. They can't be
// one: rasterizing a glyph uploads it through the same staging buffer
// (`gpu.begin_data`) the quads are streamed through.
//
// Positions are physical pixels of the drawable, y down, mapped to normal
// space as they are pushed.

import bytes
import snaidhm.web.gpu as gpu
import snaidhm.sfnt as sfnt
import snaidhm.text as text
import self.cell
import self.gui.fonts
import self.gui.emoji
import self.gui.sprite
import self.scrollback
import self.search
import self.field
import self.terminal
import self.view
import self.width as cell_width

/// Floats per vertex of the text pipeline: position 2, uv 2, colour 4.
let VERTEX_FLOATS = 8

/// Tokyo Night Storm.
let DEFAULT_BG = 0x24283B
let DEFAULT_FG = 0xC0CAF5
let CURSOR = 0xC0CAF5
let SELECTION = 0x364A82
let TAB_BAR = 0x1F2335
let TAB_DIM = 0x737AA2
let TAB_RULE = 0x3B4261
let ACCENT = 0x7AA2F7
/// Find: every match (its text keeps its colour), the current one (dark on
/// orange), and the count when nothing matches.
let MATCH = 0x5E4E2C
let MATCH_CURRENT = 0xFF9E64
let MATCH_FG = 0x1A1B26
let NO_MATCH = 0xF7768E
let ANSI = [
  0x1D202F, 0xF7768E, 0x9ECE6A, 0xE0AF68, 0x7AA2F7, 0xBB9AF7, 0x7DCFFF, 0xA9B1D6,
  0x414868, 0xF7768E, 0x9ECE6A, 0xE0AF68, 0x7AA2F7, 0xBB9AF7, 0x7DCFFF, 0xC0CAF5,
]

type Renderer = {
  device: Int,
  // The layer's fonts: the grid face first, then the bold and the fallbacks
  // in the order they were first needed.
  layer: text.TextLayer,
  // Where the bold is in the layer's fonts: -1 not read yet, -2 none.
  bold_index: Int,
  bold_path: String,
  fallback_paths: List[String],
  // Where each fallback read so far is in the layer's fonts, and how many of
  // `fallback_paths` have been tried.
  fallback_indices: List[Int],
  fallbacks_tried: Int,
  size_px: Int,
  cell_w: Int,
  cell_h: Int,
  baseline: Int,
  pad_x: Int,
  pad_y: Int,
  line_w: Int,
  palette: List[Int],
  // (code point * 2 + bold) -> glyph cache slot, -1 for no glyph.
  glyphs: Map[Int, Int],
  // Colour emoji: code point -> colour atlas slot, -1 when it has none.
  emojis: Map[Int, Int],
  // Box drawing and block elements, as rectangles for this cell size.
  sprites: Map[Int, List[sprite.Piece]],
  vtx: Int,
  capacity: Int,
  count: Int,
}

/// The 256-colour palette: the 16 of the theme, the 6x6x6 cube, 24 greys.
fn palette256() -> List[Int] = {
  var p = ANSI
  let steps = [0, 95, 135, 175, 215, 255]
  for i in 0..<216 {
    let r = steps[i / 36]
    let g = steps[(i / 6) % 6]
    let b = steps[i % 6]
    list.push(p, r * 65536 + g * 256 + b)
  }
  for i in 0..<24 {
    let v = 8 + i * 10
    list.push(p, v * 65536 + v * 256 + v)
  }
  p
}

/// A renderer drawing `faces` at `size_px` pixels per em, the grid inset by
/// `pad_x` x `pad_y` pixels.
fn new(device: Int, faces: fonts.Faces, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> Renderer = {
  let r = Renderer {
    device: device,
    layer: text.new_buffer_layer(device, [faces.regular]),
    bold_index: if faces.bold_path == "" then -2 else -1,
    bold_path: faces.bold_path,
    fallback_paths: faces.fallback_paths,
    fallback_indices: [],
    fallbacks_tried: 0,
    size_px: 0,
    cell_w: 1,
    cell_h: 1,
    baseline: 0,
    pad_x: 0,
    pad_y: 0,
    line_w: 1,
    palette: palette256(),
    glyphs: [:],
    emojis: [:],
    sprites: [:],
    vtx: 0,
    capacity: 0,
    count: 0,
  }
  with_size(r, size_px, pad_x, pad_y, cell_height)
}

/// `r` drawing at `size_px` pixels per em, inset by `pad_x` x `pad_y`: the
/// cell measured anew, and what was cached for the old cell dropped. The
/// layer, its fonts and its atlas stay — glyphs are cached by size, so going
/// back to a size finds them still there.
fn with_size(r: Renderer, size_px: Int, pad_x: Int, pad_y: Int, cell_height: Float) -> Renderer = {
  let size = int.to_float(size_px)
  let grid = r.layer.fonts[0]
  let cell_w = int.max(1, float.to_int(float.round(text.advance_px(r.layer, 0, sfnt.glyph_id(grid, 0x4D), size))))
  let ascent = text.ascent(r.layer, size)
  let natural = ascent + text.descent(r.layer, size)
  let cell_h = int.max(1, float.to_int(float.ceil(natural * cell_height)))
  // Extra line height goes half above, half below.
  let baseline = float.to_int(float.round(ascent + (int.to_float(cell_h) - natural) / 2.0))
  let glyphs: Map[Int, Int] = [:]
  let emojis: Map[Int, Int] = [:]
  let sprites: Map[Int, List[sprite.Piece]] = [:]
  {
    ...r,
    size_px: size_px,
    cell_w: cell_w,
    cell_h: cell_h,
    baseline: baseline,
    pad_x: pad_x,
    pad_y: pad_y,
    line_w: int.max(1, size_px / 14),
    glyphs: glyphs,
    emojis: emojis,
    sprites: sprites,
  }
}

/// Cell width and height in pixels for `faces` at `size_px`: what `new`
/// works out, without a GPU, so a window can be sized to a grid before it
/// opens.
fn cell_size(faces: fonts.Faces, size_px: Int, cell_height: Float) -> (Int, Int) = {
  let f = faces.regular
  let size = int.to_float(size_px)
  let upem = int.to_float(f.units_per_em)
  let w = int.max(1, float.to_int(float.round(int.to_float(sfnt.advance(f, sfnt.glyph_id(f, 0x4D))) * size / upem)))
  let natural = (int.to_float(f.ascent) - int.to_float(f.descent)) * size / upem
  (w, int.max(1, float.to_int(float.ceil(natural * cell_height))))
}

/// Columns and rows that fit a `width` x `height` drawable with `tabs` tabs
/// open (the tab bar shows from two on).
fn grid_size(r: Renderer, width: Int, height: Int, tabs: Int) -> (Int, Int) =
  (int.max(1, (width - 2 * r.pad_x) / r.cell_w), int.max(1, (height - grid_top(r, tabs) - r.pad_y) / r.cell_h))

/// Height of the tab bar.
fn bar_height(r: Renderer) -> Int = r.cell_h + r.pad_y

/// Pixel row the grid starts at: below the tab bar when there is one.
fn grid_top(r: Renderer, tabs: Int) -> Int = r.pad_y + (if tabs > 1 then bar_height(r) else 0)

/// The tab under pixel `x` of the tab bar, for `tabs` tabs across `width`.
fn tab_at(r: Renderer, x: Int, width: Int, tabs: Int) -> Int = int.clamp(x * tabs / int.max(1, width), 0, tabs - 1)

/// 0xRRGGBB of a cell colour; `fallback` for the default colour.
fn resolve(r: Renderer, color: Int, fallback: Int) -> Int = {
  let kind = int.bshr(color, 24)
  if kind == 1 then r.palette[int.band(color, 0xFF)]
  else if kind == 2 then int.band(color, 0xFFFFFF)
  else fallback
}

// ── Glyphs ────────────────────────────────────────────────────────────────

/// The glyph cache slot drawing `cp`, rasterizing it on first use; -1 when no
/// face has it.
fn glyph(mut r: Renderer, cp: Int, bold: Bool) -> Int = {
  let k = cp * 2 + (if bold then 1 else 0)
  match map.get(r.glyphs, k) {
    some(slot) => slot,
    none => {
      let (fi, gid) = face_for(r, cp, bold)
      let slot = if gid == 0 then -1 else {
        let before = list.len(r.layer.rects)
        let device = r.device
        let size_px = r.size_px
        r.layer = text.cached(device, r.layer, fi, gid, size_px)
        // The atlas filled up and started over: every slot we knew is gone.
        if list.len(r.layer.rects) < before then map.clear(r.glyphs)
        map.get(r.layer.keys, text.key(fi, gid, size_px)) ?? -1
      }
      map.insert(r.glyphs, k, slot)
      slot
    }
  }
}

/// The colour atlas slot drawing `cp` as a colour emoji, made on first use;
/// -1 when it isn't one. An emoji is a wide character the grid face has no
/// glyph for and the emoji font an image; it fills its two cells.
fn emoji_slot(mut r: Renderer, cp: Int) -> Int =
  match map.get(r.emojis, cp) {
    some(slot) => slot,
    none => {
      let slot = if cell_width.of(cp) != 2 or sfnt.glyph_id(r.layer.fonts[0], cp) != 0 then -1 else {
        let img = emoji.bitmap(cp, r.cell_w * 2, r.cell_h)
        if bytes.len(img) <= 8 then -1 else {
          let before = list.len(r.layer.color_rects)
          let device = r.device
          r.layer = text.place_color(device, r.layer, cp, img, 8, bytes.read_u32_le(img, 0), bytes.read_u32_le(img, 4))
          // The atlas started over: every slot known before is gone.
          if list.len(r.layer.color_rects) <= before then map.clear(r.emojis)
          text.color_slot(r.layer, cp)
        }
      }
      map.insert(r.emojis, cp, slot)
      slot
    }
  }

/// Quad drawing colour atlas slot `slot` over the two cells from (`x`, `top`).
fn emoji_quad(r: Renderer, slot: Int, x: Int, top: Int, alpha: Float, sx: Float, sy: Float) -> Unit = {
  let o = slot * 4
  let (ax, ay, w, h) = (r.layer.color_rects[o], r.layer.color_rects[o + 1], r.layer.color_rects[o + 2], r.layer.color_rects[o + 3])
  let atlas = int.to_float(text.COLOR_ATLAS)
  quad(r, int.to_float(x), int.to_float(top), int.to_float(x + w), int.to_float(top + h),
    2.0 + int.to_float(ax) / atlas, int.to_float(ay) / atlas, 2.0 + int.to_float(ax + w) / atlas, int.to_float(ay + h) / atlas,
    DEFAULT_FG, alpha, sx, sy)
}

/// The font (index into the layer's fonts) and glyph drawing `cp`: the grid
/// face or its bold, else the first fallback that has it, reading fallbacks
/// until one does. (0, 0) when none has it.
fn face_for(mut r: Renderer, cp: Int, bold: Bool) -> (Int, Int) = {
  let face = if bold then bold_face(r) else 0
  let g = sfnt.glyph_id(r.layer.fonts[face], cp)
  if g != 0 then (face, g)
  else {
    var found = (0, 0)
    for fi in r.fallback_indices {
      if found.1 == 0 then {
        let fg = sfnt.glyph_id(r.layer.fonts[fi], cp)
        if fg != 0 then found = (fi, fg)
      }
    }
    while found.1 == 0 and r.fallbacks_tried < list.len(r.fallback_paths) {
      let path = r.fallback_paths[r.fallbacks_tried]
      r.fallbacks_tried = r.fallbacks_tried + 1
      match fonts.load(path) {
        some(f) => {
          let fi = add_font(r, f)
          r.fallback_indices = r.fallback_indices + [fi]
          let fg = sfnt.glyph_id(f, cp)
          if fg != 0 then found = (fi, fg)
        },
        none => (),
      }
    }
    found
  }
}

/// Where the bold is in the layer's fonts, reading it the first time; the
/// grid face when there is no bold.
fn bold_face(mut r: Renderer) -> Int = {
  if r.bold_index == -1 then {
    let path = r.bold_path
    r.bold_index = match fonts.load(path) {
      some(f) => add_font(r, f),
      none => -2,
    }
  }
  if r.bold_index >= 0 then r.bold_index else 0
}

/// Append `f` to the layer's fonts; its index.
fn add_font(mut r: Renderer, f: sfnt.Font) -> Int = {
  let fi = list.len(r.layer.fonts)
  r.layer = { ...r.layer, fonts: r.layer.fonts + [f] }
  fi
}

/// The rectangles drawing box-drawing or block character `cp`, made once
/// per character.
fn sprite_pieces(mut r: Renderer, cp: Int) -> List[sprite.Piece] =
  match map.get(r.sprites, cp) {
    some(ps) => ps,
    none => {
      let ps = sprite.pieces(cp, r.cell_w, r.cell_h, r.line_w)
      map.insert(r.sprites, cp, ps)
      ps
    }
  }

// ── Quads ─────────────────────────────────────────────────────────────────

/// Push one quad: pixels (x0, y0)-(x1, y1), atlas uv (u0, v0)-(u1, v1),
/// colour 0xRRGGBB at `alpha`.
fn quad(r: Renderer, x0: Float, y0: Float, x1: Float, y1: Float,
        u0: Float, v0: Float, u1: Float, v1: Float, rgb: Int, alpha: Float,
        sx: Float, sy: Float) -> Unit = {
  let cr = int.to_float(int.band(int.bshr(rgb, 16), 0xFF)) / 255.0
  let cg = int.to_float(int.band(int.bshr(rgb, 8), 0xFF)) / 255.0
  let cb = int.to_float(int.band(rgb, 0xFF)) / 255.0
  let nx0 = x0 * sx - 1.0
  let nx1 = x1 * sx - 1.0
  let ny0 = 1.0 - y0 * sy
  let ny1 = 1.0 - y1 * sy
  vertex(nx0, ny0, u0, v0, cr, cg, cb, alpha)
  vertex(nx1, ny0, u1, v0, cr, cg, cb, alpha)
  vertex(nx0, ny1, u0, v1, cr, cg, cb, alpha)
  vertex(nx0, ny1, u0, v1, cr, cg, cb, alpha)
  vertex(nx1, ny0, u1, v0, cr, cg, cb, alpha)
  vertex(nx1, ny1, u1, v1, cr, cg, cb, alpha)
}

fn vertex(x: Float, y: Float, u: Float, v: Float, cr: Float, cg: Float, cb: Float, a: Float) -> Unit = {
  gpu.push_f32(x)
  gpu.push_f32(y)
  gpu.push_f32(u)
  gpu.push_f32(v)
  gpu.push_f32(cr)
  gpu.push_f32(cg)
  gpu.push_f32(cb)
  gpu.push_f32(a)
}

/// A filled rectangle, sampling the atlas's solid texel.
fn rect(r: Renderer, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int, alpha: Float, sx: Float, sy: Float) -> Unit = {
  let slot = map.get(r.layer.keys, text.SOLID) ?? 0
  let atlas = int.to_float(text.ATLAS)
  let u = (int.to_float(r.layer.rects[slot * 6]) + 0.5) / atlas
  let v = (int.to_float(r.layer.rects[slot * 6 + 1]) + 0.5) / atlas
  quad(r, int.to_float(x0), int.to_float(y0), int.to_float(x1), int.to_float(y1), u, v, u, v, rgb, alpha, sx, sy)
}

/// The glyph in `slot` with its pen at `x` on the baseline `y`.
fn glyph_quad(r: Renderer, slot: Int, x: Int, y: Int, rgb: Int, alpha: Float, sx: Float, sy: Float) -> Unit = {
  let o = slot * 6
  let w = r.layer.rects[o + 2]
  let h = r.layer.rects[o + 3]
  if w > 0 and h > 0 then {
    let left = x + r.layer.rects[o + 4]
    let top = y - r.layer.rects[o + 5]
    let atlas = int.to_float(text.ATLAS)
    let ax = int.to_float(r.layer.rects[o])
    let ay = int.to_float(r.layer.rects[o + 1])
    quad(r, int.to_float(left), int.to_float(top), int.to_float(left + w), int.to_float(top + h),
      ax / atlas, ay / atlas, (ax + int.to_float(w)) / atlas, (ay + int.to_float(h)) / atlas,
      rgb, alpha, sx, sy)
  }
}

// ── Frames ────────────────────────────────────────────────────────────────

/// Draw `t` into the window's current frame: the viewport scrolled `back`
/// lines into scrollback, `sel` highlighted, and `preedit` — what the input
/// method is composing — at the cursor. `width` x `height` is the drawable.
/// With `find`, its matches are marked and its bar is shown — while the bar
/// has the focus, with the composition in it.
fn draw(mut r: Renderer, t: terminal.Terminal, back: Int, sel: Option[view.Selection],
        preedit: List[Int], width: Int, height: Int, tabs: List[String], active: Int,
        find: Option[Bar]) -> Unit = {
  let gy = grid_top(r, list.len(tabs))
  let titles = if list.len(tabs) > 1 then list.map(tabs, (s) => text.code_points(s)) else []
  let top_line = view.top_line(t, back)
  let lines = list.map(0..<t.rows, (y) => view.line_at(t, top_line + y))
  let query = match find { some(b) => b.find.query, none => "" }
  // The matches on each row, and the current one's columns where it is.
  let found = list.map(lines, (line) => match line {
    some(row) => search.row_spans(row, t.cols, query),
    none => [],
  })
  let current = match find {
    some(b) => if b.find.index >= 0 then (b.find.line - top_line, b.find.from, b.find.to) else (-1, 0, 0),
    none => (-1, 0, 0),
  }
  let bar = match find {
    some(b) => bar_chars(b, preedit) + find_count(b.find),
    none => [],
  }

  // Pass 1: every glyph on screen into the atlas.
  r.layer = text.solid(r.device, r.layer)
  var marks_total = 0
  for line in lines {
    match line {
      some(row) => {
        for x in 0..<t.cols {
          let o = x * cell.SIZE
          let cp = bytes.read_u32_le(row.cells, o + cell.OFF_CP)
          if sprite.is_sprite(cp) then {
            marks_total = marks_total + list.len(sprite_pieces(r, cp))
          } else if cp > 32 then {
            let bold = int.band(bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS), cell.ATTR_BOLD) != 0
            if emoji_slot(r, cp) < 0 then {
              let _ = glyph(r, cp, bold)
            }
            for mark in marks(row, x) {
              let _ = glyph(r, mark, bold)
              marks_total = marks_total + 1
            }
          }
        }
      },
      none => (),
    }
  }
  for cp in preedit {
    let _ = glyph(r, cp, false)
  }
  for cp in bar {
    let _ = glyph(r, cp, false)
  }
  var title_chars = 0
  for title in titles {
    for cp in title {
      let _ = glyph(r, cp, false)
      title_chars = title_chars + 1
    }
  }

  // Room for the worst case: per cell a background, a glyph and two lines,
  // plus marks, the cursor, the scrollbar and the composition.
  let quads = t.rows * t.cols * 4 + marks_total + 3 + list.len(preedit) * 3 + title_chars + list.len(titles) * 3 + 1
    + list.len(bar) * 3 + FIND_QUADS
  if quads * 6 > r.capacity then {
    // Grow by half again, so a count creeping up doesn't replace the buffer
    // every frame, and free the old one: its GPU memory isn't reclaimed
    // otherwise.
    if r.vtx != 0 then gpu.destroy_buffer(r.device, r.vtx)
    r.capacity = int.max(quads * 6, r.capacity * 3 / 2)
    r.vtx = gpu.create_stream_buffer(r.device, r.capacity * VERTEX_FLOATS * 4, int.bor(gpu.VERTEX, gpu.COPY_DST))
  }

  // Pass 2: the quads.
  let sx = 2.0 / int.to_float(width)
  let sy = 2.0 / int.to_float(height)
  var n = 0
  gpu.begin_data()
  for y in 0..<t.rows {
    match lines[y] {
      some(row) => {
        let lit = if current.0 == y then Lit { spans: found[y], from: current.1, to: current.2 } else Lit { spans: found[y], from: -1, to: -1 }
        n = n + draw_row(r, row, top_line + y, sel, lit, gy + y * r.cell_h, t.cols, sx, sy)
      },
      none => (),
    }
  }

  // The cursor, where its line is in view; the composition over it.
  let cursor_row = view.screen_line(t) + t.y - top_line
  if cursor_row >= 0 and cursor_row < t.rows then {
    let cx = r.pad_x + t.x * r.cell_w
    let ctop = gy + cursor_row * r.cell_h
    let in_bar = match find { some(b) => b.focused, none => false }
    if list.len(preedit) > 0 and not in_bar then {
      var px = cx
      for cp in preedit {
        let w = r.cell_w * int.max(1, cell_width.of(cp))
        rect(r, px, ctop, px + w, ctop + r.cell_h, DEFAULT_BG, 1.0, sx, sy)
        let slot = glyph(r, cp, false)
        if slot >= 0 then glyph_quad(r, slot, px, ctop + r.baseline, DEFAULT_FG, 1.0, sx, sy)
        let uy = ctop + r.baseline + r.line_w
        rect(r, px, uy, px + w, uy + r.line_w, DEFAULT_FG, 1.0, sx, sy)
        n = n + 3
        px = px + w
      }
    } else if t.cursor_visible then {
      let shape = t.cursor_shape
      if shape == 1 or shape == 2 then rect(r, cx, ctop, cx + r.cell_w, ctop + r.cell_h, CURSOR, 0.5, sx, sy)
      else if shape == 3 or shape == 4 then rect(r, cx, ctop + r.cell_h - 2 * r.line_w, cx + r.cell_w, ctop + r.cell_h, CURSOR, 1.0, sx, sy)
      else rect(r, cx, ctop, cx + int.max(2, r.line_w * 2), ctop + r.cell_h, CURSOR, 1.0, sx, sy)
      n = n + 1
    }
  }

  // Scrolled back: a thumb on the right edge shows where.
  if back > 0 then {
    let total = view.max_back(t) + t.rows
    let track = height - gy - r.pad_y
    let thumb = int.max(r.cell_h, track * t.rows / total)
    let y0 = gy + (track - thumb) * (view.max_back(t) - back) / int.max(1, view.max_back(t))
    let w = int.max(3, r.pad_x / 3)
    rect(r, width - w - 2, y0, width - 2, y0 + thumb, DEFAULT_FG, 0.35, sx, sy)
    n = n + 1
  }

  if list.len(titles) > 1 then n = n + draw_tabs(r, titles, active, width, sx, sy)
  match find {
    some(b) => { n = n + draw_find(r, b, preedit, gy, width, sx, sy) },
    none => (),
  }

  if n > 0 then gpu.flush_to_buffer(r.device, r.vtx)
  r.count = n * 6

  let (br, bgg, bb) = rgb_floats(DEFAULT_BG)
  let encoder = gpu.begin_encoder(r.device)
  let pass = gpu.begin_render_pass(encoder, br, bgg, bb, 1.0)
  if r.count > 0 then {
    gpu.set_pipeline(pass, r.layer.pipeline)
    gpu.set_bind_group(pass, 0, r.layer.bind_group)
    gpu.set_vertex_buffer(pass, 0, r.vtx)
    gpu.draw(pass, r.count)
  }
  gpu.end_pass(pass)
  gpu.finish_and_submit(r.device, encoder)
}

/// The tab bar: one tab per title, `active` raised to the terminal's
/// background with an accent line, the others on a darker strip. Returns the
/// quads it pushed.
fn draw_tabs(mut r: Renderer, titles: List[List[Int]], active: Int, width: Int, sx: Float, sy: Float) -> Int = {
  let h = bar_height(r)
  let count = list.len(titles)
  var n = 0
  rect(r, 0, 0, width, h, TAB_BAR, 1.0, sx, sy)
  n = n + 1
  for i in 0..<count {
    let x0 = i * width / count
    let x1 = (i + 1) * width / count
    if i == active then {
      rect(r, x0, 0, x1, h, DEFAULT_BG, 1.0, sx, sy)
      rect(r, x0, 0, x1, int.max(2, r.line_w), ACCENT, 1.0, sx, sy)
      n = n + 2
    } else if i > 0 and i != active + 1 then {
      rect(r, x0, h / 4, x0 + int.max(1, r.line_w / 2), h - h / 4, TAB_RULE, 1.0, sx, sy)
      n = n + 1
    }
    // The title, centred, cut to the tab with room to spare on each side.
    let room = int.max(1, (x1 - x0) / r.cell_w - 2)
    let title = titles[i]
    let shown = if list.len(title) > room then list.take(title, int.max(1, room - 1)) + [0x2026] else title
    var w = 0
    for cp in shown {
      w = w + r.cell_w * int.max(1, cell_width.of(cp))
    }
    var pen = x0 + (x1 - x0 - w) / 2
    let baseline = (h - r.cell_h) / 2 + r.baseline
    let color = if i == active then DEFAULT_FG else TAB_DIM
    for cp in shown {
      let slot = glyph(r, cp, false)
      if slot >= 0 then {
        glyph_quad(r, slot, pen, baseline, color, 1.0, sx, sy)
        n = n + 1
      }
      pen = pen + r.cell_w * int.max(1, cell_width.of(cp))
    }
  }
  n
}

/// Quads of one row at pixel row `top`: background runs, glyphs, marks and
/// lines. Returns how many it pushed.
fn draw_row(mut r: Renderer, row: scrollback.Row, line: Int, sel: Option[view.Selection], lit: Lit,
            top: Int, cols: Int, sx: Float, sy: Float) -> Int = {
  var n = 0
  var x = 0
  while x < cols {
    let bg = colors(r, row, line, x, sel, lit).1
    var end = x + 1
    while end < cols and colors(r, row, line, end, sel, lit).1 == bg {
      end = end + 1
    }
    if bg != DEFAULT_BG then {
      rect(r, r.pad_x + x * r.cell_w, top, r.pad_x + end * r.cell_w, top + r.cell_h, bg, 1.0, sx, sy)
      n = n + 1
    }
    x = end
  }
  for cx in 0..<cols {
    let o = cx * cell.SIZE
    let cp = bytes.read_u32_le(row.cells, o + cell.OFF_CP)
    let attrs = bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS)
    let fg = colors(r, row, line, cx, sel, lit).0
    let alpha = if int.band(attrs, cell.ATTR_FAINT) != 0 then 0.6 else 1.0
    let bold = int.band(attrs, cell.ATTR_BOLD) != 0
    let left = r.pad_x + cx * r.cell_w
    let w = r.cell_w * int.max(1, bytes.read_u8(row.cells, o + cell.OFF_WIDTH))
    if sprite.is_sprite(cp) and int.band(attrs, cell.ATTR_HIDDEN) == 0 then {
      for p in sprite_pieces(r, cp) {
        rect(r, left + p.x0, top + p.y0, left + p.x1, top + p.y1, fg, alpha * p.alpha, sx, sy)
        n = n + 1
      }
    } else if cp > 32 and int.band(attrs, cell.ATTR_HIDDEN) == 0 and emoji_slot(r, cp) >= 0 then {
      let slot = emoji_slot(r, cp)
      emoji_quad(r, slot, left, top, alpha, sx, sy)
      n = n + 1
    } else if cp > 32 and int.band(attrs, cell.ATTR_HIDDEN) == 0 then {
      let slot = glyph(r, cp, bold)
      if slot >= 0 then {
        glyph_quad(r, slot, left, top + r.baseline, fg, alpha, sx, sy)
        n = n + 1
      }
      // Combining marks have no advance of their own: fonts draw them back
      // from the pen, which stands after the base character.
      for mark in marks(row, cx) {
        let ms = glyph(r, mark, bold)
        if ms >= 0 then {
          glyph_quad(r, ms, left + w, top + r.baseline, fg, alpha, sx, sy)
          n = n + 1
        }
      }
    }
    if int.band(attrs, cell.ATTR_UNDERLINE + cell.ATTR_DOUBLE_UNDERLINE) != 0 then {
      let uy = top + r.baseline + r.line_w
      rect(r, left, uy, left + w, uy + r.line_w, fg, alpha, sx, sy)
      n = n + 1
    }
    if int.band(attrs, cell.ATTR_STRIKE) != 0 then {
      let y0 = top + r.baseline - r.size_px * 3 / 10
      rect(r, left, y0, left + w, y0 + r.line_w, fg, alpha, sx, sy)
      n = n + 1
    }
  }
  n
}

/// The combining marks on cell `x` worth drawing (joiners and variation
/// selectors only steer how the base is shown).
fn marks(row: scrollback.Row, x: Int) -> List[Int] =
  if int.band(bytes.read_u8(row.cells, x * cell.SIZE + cell.OFF_FLAGS), cell.FLAG_GRAPHEME) == 0 then []
  else text.code_points(map.get_or(row.extras, x, ""))
    |> list.filter((cp) => cp != 0x200D and (cp < 0xFE00 or cp > 0xFE0F))

/// A row's find matches: their columns, and the current one's (`from` -1
/// when it isn't on the row).
type Lit = { spans: List[(Int, Int)], from: Int, to: Int }

/// Foreground and background of cell `x` as 0xRRGGBB: inverse and hidden
/// applied, and a find match's or the selection's colour over it.
fn colors(r: Renderer, row: scrollback.Row, line: Int, x: Int, sel: Option[view.Selection], lit: Lit) -> (Int, Int) = {
  let o = x * cell.SIZE
  let fg = resolve(r, bytes.read_u32_le(row.cells, o + cell.OFF_FG), DEFAULT_FG)
  let bg = resolve(r, bytes.read_u32_le(row.cells, o + cell.OFF_BG), DEFAULT_BG)
  let attrs = bytes.read_u16_le(row.cells, o + cell.OFF_ATTRS)
  let (f, b) = if int.band(attrs, cell.ATTR_INVERSE) != 0 then (bg, fg) else (fg, bg)
  let (f2, b2) = if int.band(attrs, cell.ATTR_HIDDEN) != 0 then (b, b) else (f, b)
  if x >= lit.from and x < lit.to then (MATCH_FG, MATCH_CURRENT)
  else if list.any(lit.spans, (s) => x >= s.0 and x < s.1) then (f2, MATCH)
  else match sel {
    some(s) => if view.selected(s, line, x) then (f2, SELECTION) else (f2, b2),
    none => (f2, b2),
  }
}

// ── Find bar ──────────────────────────────────────────────────────────────

/// The find bar: the search, the field its query is typed in, and whether
/// it has the focus — typing goes to it rather than the program.
type Bar = { find: search.Find, field: field.Field, focused: Bool }

/// Quads of the find bar besides its characters and their selection and
/// underlines: its box, border and caret.
let FIND_QUADS = 7

/// Width of the find bar's box, cells, at the least.
let FIND_CELLS = 30

/// The count the find bar shows: "3/17", "0/0" when nothing matches.
fn find_count(f: search.Find) -> List[Int] =
  if f.query == "" then [] else text.code_points("${int.to_string(f.index + 1)}/${int.to_string(f.total)}")

/// What the field shows: its text with the composition, if it has the
/// focus, at the caret.
fn bar_chars(b: Bar, preedit: List[Int]) -> List[Int] = {
  let pre = if b.focused then preedit else []
  list.take(b.field.chars, b.field.caret) + pre + list.drop(b.field.chars, b.field.caret)
}

/// The find bar's box: (x0, y0, x1, y1), at the top right of the grid.
fn find_box(r: Renderer, b: Bar, preedit: List[Int], gy: Int, width: Int) -> (Int, Int, Int, Int) = {
  let want = cols_of(bar_chars(b, preedit)) + list.len(find_count(b.find)) + 4
  let w = int.min(width - 2 * r.pad_x, int.max(FIND_CELLS, want) * r.cell_w + r.pad_x)
  let x1 = width - r.pad_x
  (x1 - w, gy, x1, gy + r.cell_h + r.pad_y)
}

/// Columns `cps` take.
fn cols_of(cps: List[Int]) -> Int = list.fold(cps, 0, (acc, cp) => acc + int.max(1, cell_width.of(cp)))

/// The field's layout in the box: where its text starts (pixels), how many
/// columns it may take, and the first character shown — the text scrolls
/// so the caret stays in view.
fn field_layout(r: Renderer, b: Bar, preedit: List[Int], box: (Int, Int, Int, Int)) -> (Int, Int, Int) = {
  let (x0, _, x1, _) = box
  let room = int.max(1, (x1 - x0 - r.pad_x) / r.cell_w - list.len(find_count(b.find)) - 2)
  let chars = bar_chars(b, preedit)
  let caret = b.field.caret + (if b.focused then list.len(preedit) else 0)
  // Back from the caret while the columns up to it fit.
  var first = caret
  var used = 0
  while first > 0 and used + int.max(1, cell_width.of(chars[first - 1])) < room {
    first = first - 1
    used = used + int.max(1, cell_width.of(chars[first]))
  }
  (x0 + r.pad_x / 2, room, first)
}

/// The x of the edge before character `i` of what the field shows.
fn field_x(r: Renderer, b: Bar, preedit: List[Int], box: (Int, Int, Int, Int), i: Int) -> Int = {
  let (left, _, first) = field_layout(r, b, preedit, box)
  left + cols_of(list.slice(bar_chars(b, preedit), first, int.max(first, i))) * r.cell_w
}

/// Where the find bar's caret is: (x, y) of the cell it stands in, pixels.
fn find_caret(r: Renderer, b: Bar, preedit: List[Int], tabs: Int, width: Int) -> (Int, Int) = {
  let box = find_box(r, b, preedit, grid_top(r, tabs), width)
  (field_x(r, b, preedit, box, b.field.caret), box.1 + r.pad_y / 2)
}

/// Whether pixel (`px`, `py`) is on the find bar.
fn on_bar(r: Renderer, b: Bar, tabs: Int, width: Int, px: Int, py: Int) -> Bool = {
  let (x0, y0, x1, y1) = find_box(r, b, [], grid_top(r, tabs), width)
  px >= x0 and px < x1 and py >= y0 and py < y1
}

/// The caret position in the field nearest pixel column `px`.
fn field_index_at(r: Renderer, b: Bar, tabs: Int, width: Int, px: Int) -> Int = {
  let box = find_box(r, b, [], grid_top(r, tabs), width)
  let (left, _, first) = field_layout(r, b, [], box)
  var i = first
  var x = left
  let n = list.len(b.field.chars)
  var done = false
  while not done and i < n {
    let w = r.cell_w * int.max(1, cell_width.of(b.field.chars[i]))
    if px < x + w / 2 then done = true
    else {
      x = x + w
      i = i + 1
    }
  }
  i
}

/// The find bar: the field — its selection, the composition underlined,
/// the caret while it has the focus — and the count on the right. Its border
/// is the accent colour while it has the focus. Returns the quads it pushed.
fn draw_find(mut r: Renderer, b: Bar, preedit: List[Int], gy: Int, width: Int, sx: Float, sy: Float) -> Int = {
  let box = find_box(r, b, preedit, gy, width)
  let (x0, y0, x1, y1) = box
  let lw = int.max(1, r.line_w)
  let edge = if b.focused then ACCENT else TAB_RULE
  rect(r, x0, y0, x1, y1, TAB_BAR, 1.0, sx, sy)
  rect(r, x0, y0, x1, y0 + lw, edge, 1.0, sx, sy)
  rect(r, x0, y1 - lw, x1, y1, edge, 1.0, sx, sy)
  rect(r, x0, y0, x0 + lw, y1, edge, 1.0, sx, sy)
  rect(r, x1 - lw, y0, x1, y1, edge, 1.0, sx, sy)
  var n = 5
  let count = find_count(b.find)
  let baseline = y0 + r.pad_y / 2 + r.baseline
  let ctop = y0 + r.pad_y / 2
  // The count, right-aligned; red when nothing matches.
  var cx = x1 - r.pad_x / 2 - list.len(count) * r.cell_w
  let count_color = if b.find.total == 0 then NO_MATCH else TAB_DIM
  for cp in count {
    let slot = glyph(r, cp, false)
    if slot >= 0 then {
      glyph_quad(r, slot, cx, baseline, count_color, 1.0, sx, sy)
      n = n + 1
    }
    cx = cx + r.cell_w
  }
  // The field: characters from `first` while they fit.
  let (left, room, first) = field_layout(r, b, preedit, box)
  let chars = bar_chars(b, preedit)
  let pre = if b.focused then list.len(preedit) else 0
  let caret = b.field.caret
  let (sel_a, sel_b) = field.range(b.field)
  var pen = left
  var used = 0
  var i = first
  while i < list.len(chars) and used + int.max(1, cell_width.of(chars[i])) <= room {
    let cp = chars[i]
    let cols = int.max(1, cell_width.of(cp))
    let w = r.cell_w * cols
    // Character `i` shown is the field's `at`, or part of the composition.
    let composing = i >= caret and i < caret + pre
    let at = if i < caret then i else i - pre
    if not composing and at >= sel_a and at < sel_b then {
      rect(r, pen, ctop, pen + w, ctop + r.cell_h, SELECTION, 1.0, sx, sy)
      n = n + 1
    }
    let slot = glyph(r, cp, false)
    if slot >= 0 then {
      glyph_quad(r, slot, pen, baseline, DEFAULT_FG, 1.0, sx, sy)
      n = n + 1
    }
    if composing then {
      let uy = baseline + r.line_w
      rect(r, pen, uy, pen + w, uy + r.line_w, DEFAULT_FG, 1.0, sx, sy)
      n = n + 1
    }
    pen = pen + w
    used = used + cols
    i = i + 1
  }
  if b.focused and not field.has_selection(b.field) then {
    let x = field_x(r, b, preedit, box, caret + pre)
    rect(r, x, ctop, x + int.max(2, r.line_w * 2), ctop + r.cell_h, ACCENT, 1.0, sx, sy)
    n = n + 1
  }
  n
}

fn rgb_floats(rgb: Int) -> (Float, Float, Float) = (
  int.to_float(int.band(int.bshr(rgb, 16), 0xFF)) / 255.0,
  int.to_float(int.band(int.bshr(rgb, 8), 0xFF)) / 255.0,
  int.to_float(int.band(rgb, 0xFF)) / 255.0,
)
