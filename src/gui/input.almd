// An input applied to the tab in front: keys (shortcuts.almd, or the find
// bar's and a rename's, findkeys.almd), presses and drags (presses.almd),
// the wheel, the input method, drops, the system's appearance and focus.

import snaidhm.native.window as window
import snaidhm.text as text
import self.gui.render
import self.keys
import self.pty
import self.sys
import self.gui.tabset
import self.gui.uistate
import self.gui.findkeys
import self.gui.pointer
import self.gui.presses
import self.gui.shortcuts

/// Apply input `kind` to the active tab `cur`; what it asks of the tabs is
/// returned. `tabs` is how many are open, `width` the drawable's.
effect fn handle(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int, r: render.Renderer, scale: Float, tabs: Int, width: Int) -> uistate.Act = {
  let p = presses.Place { r: r, scale: scale, tabs: tabs, width: width }
  // A press anywhere but the find bar takes the focus from it: typing goes
  // to the program again, the matches stay marked.
  if kind == window.MOUSE_DOWN and ui.finding and ui.find_focus and not presses.on_bar(ui, p) then {
    ui.find_focus = false
    ui.dirty = true
  }
  if kind == window.TEXT or kind == window.KEY then key(cur, ui, kind)!
  else if kind == window.WHEEL then {
    let (col, row) = pointer.cell_at(r, cur.t, scale, tabs)
    pointer.wheel(cur, ui, r, scale, window.event_dy(), col, row)
    uistate.Stay
  }
  else if kind == window.MOUSE_DOWN or kind == window.MOUSE_UP or kind == window.MOUSE_MOVE then {
    if kind == window.MOUSE_MOVE then presses.hover(cur, ui, p)
    presses.mouse(cur, ui, kind, p)!
  }
  else if kind == window.THEME then uistate.Restyle
  else if kind == window.FOCUS then uistate.Focus(window.event_code() == 1)
  else {
    other(cur, ui, kind)
    uistate.Stay
  }
}

/// A key: a rename's while one is under way, the find bar's while it has
/// the focus and takes the key, else the terminal's.
effect fn key(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int) -> uistate.Act = {
  let mods = keys.shortcut_mods(sys.is_linux(), kind, window.event_code(), window.event_mods())
  if ui.renaming then {
    findkeys.rename_key(cur, ui, kind, window.event_code(), window.event_mods())
    uistate.Stay
  } else if ui.finding and ui.find_focus and findkeys.find_owns(kind, window.event_code(), mods) then {
    findkeys.find_key(cur, ui, kind, window.event_code(), mods)!
    uistate.Stay
  } else shortcuts.key_input(cur, ui, kind)!
}

/// A drop or the input method's composition.
fn other(mut cur: tabset.Tab, mut ui: uistate.Ui, kind: Int) -> Unit =
  if kind == window.DROP then {
    // A file dropped on the window: its path, escaped, pasted as if typed —
    // the shell takes it as a word, and Claude Code attaches an image.
    let _ = pty.write(cur.fd, keys.paste(keys.shell_escape(window.event_text()) + " ", cur.t.bracketed_paste))
    if cur.back != 0 or cur.shift != 0 then ui.dirty = true
    tabset.scroll_to(cur, 0)
  } else if kind == window.COMPOSE then compose(ui)

/// The input method's composition. The selected range: a caret while
/// typing, the segment being converted while converting (-1: none, the
/// caret at the end).
fn compose(mut ui: uistate.Ui) -> Unit = {
  let cps = text.code_points(window.event_text())
  ui.preedit = cps
  let from = window.event_code()
  let to = window.event_end()
  let converting = from >= 0 and to > from
  ui.preedit_caret = if from < 0 then list.len(cps) else int.clamp(to, 0, list.len(cps))
  ui.preedit_from = if converting then int.min(from, list.len(cps)) else 0
  ui.preedit_to = if converting then int.min(to, list.len(cps)) else 0
  ui.dirty = true
}
