// A window's session: everything the main loop keeps from one turn to the
// next — the tabs and which is in front, the renderer, the input state, the
// settings — and what it was started with.

import self.gui.fonts
import self.gui.render
import self.gui.layout
import self.gui.tabset
import self.gui.uistate
import self.settings

/// How often a blinking cursor turns on or off, ms.
let BLINK_MS = 530

/// How long the visual bell lights the screen, ms.
let FLASH_MS = 120

/// Cmd+Minus and Cmd+Plus go no further than these, points.
let MIN_FONT_SIZE = 6.0

let MAX_FONT_SIZE = 72.0

/// Least time between two frames, ms: short, as the program answers keys —
/// a shell echoes a key and then redraws the line in colour a few ms later,
/// and the second must not wait a whole refresh. Under a refresh at 120 Hz:
/// on macOS taking the events waits for the display's next update anyway,
/// and a turn that may not draw yet spends one of them, so at 8 ms a frame
/// came every 12 ms, 80 a second, while scrolling. Output streaming in gets
/// a frame a turn too, each turn a `drain_ms` of parsing, so a frame lands
/// on each refresh of the display, where frames 50 ms apart and 40 ms of
/// parsing between them showed a firehose at 15 a second and scrolled it
/// in lurches. The loop doesn't sleep while output waits
/// (`upkeep.wait_for`), so the frames cost it no throughput.
let FRAME_MS = 4

/// Longest spent draining a tab's PTY before the window gets a turn, ms,
/// where the display's refresh rate isn't known.
let DRAIN_MS = 12

/// `DRAIN_MS` for a display refreshing at `refresh_mhz` millihertz (0:
/// unknown): the refresh's period less 2 ms for the frame and the turn, so
/// the frame lands on the next refresh, not the one after. At 120 Hz, 6 ms:
/// measured on one, 12 ms gave 60 frames a second and 8 ms 57 — the frame
/// missed the refresh by a hair — while 6 ms gave 100, 42 MB of styled lines
/// taking a fifth longer. At 60 Hz, 14 ms.
fn drain_ms(refresh_mhz: Int) -> Int =
  if refresh_mhz <= 0 then DRAIN_MS else int.clamp(1000000 / refresh_mhz - 2, 4, 15)

/// Longest a tab in the back is read for in a turn, ms: what has come is
/// parsed, nothing waited for. Several tabs running Claude Code in the back
/// each had a frame's worth of reading before the one in front was drawn.
let BACK_DRAIN_MS = 2


test "the drain budget leaves 2 ms of the display's refresh for the frame" {
  assert_eq(drain_ms(120000), 6)
  assert_eq(drain_ms(60000), 14)
  assert_eq(drain_ms(0), DRAIN_MS)
  assert_eq(drain_ms(240000), 4)
  assert_eq(drain_ms(30000), 15)
}

/// How long the window's size must hold before scrollback is reflowed to it,
/// ms: reflowing a full scrollback takes about 0.2 s, too long for every step
/// of a drag.
let SETTLE_MS = 300

/// How soon input a program hasn't taken is offered again, ms.
let WRITE_RETRY_MS = 5

type Session = {
  // The window's id (snaidhm's: 1 for the first), and the fonts it draws
  // with.
  id: Int,
  faces: fonts.Faces,
  // As started: a PNG to capture one frame to instead of a window, the
  // command new tabs run, $HOME, whether to ask in Japanese, the display's
  // scale, the GPU device, the config file's watch.
  capture: Option[String],
  home: String,
  ja: Bool,
  scale: Float,
  device: Int,
  config_fd: Int,
  st: settings.Settings,
  r: render.Renderer,
  // The panes, the one keys go to, and the tab bar's tabs: groups of them
  // (groups.almd).
  tabs: List[tabset.Tab],
  active: Int,
  groups: List[layout.Group],
  ui: uistate.Ui,
  // The drawable's size, pixels; the font size now (Cmd+Plus / Minus).
  width: Int,
  height: Int,
  // The size, logical pixels, the last time the window wasn't full screen:
  // what is kept when it is, to open at again.
  windowed: (Float, Float),
  font_size: Float,
  // A blinking cursor: when it next turns on or off, -1 when it doesn't
  // blink. When the visual bell's light goes out, -1 when it is not lit.
  blink_at: Int,
  flash_until: Int,
  alive: Bool,
  last_frame: Int,
  streaming: Bool,
  // The display's refresh paces the frames (see `paced`): whether the host's
  // display link runs, when it last ticked, and whether a tick is waiting
  // for its frame.
  vsync_run: Bool,
  vsync_at: Int,
  vsync_due: Bool,
  // When the window last changed size, while scrollback waits to be
  // reflowed; -1 when it doesn't.
  resized_at: Int,
  // The PTY of the tab in front, to tell when another comes to the front;
  // the window's title, the tab in front's.
  front: Int,
  window_title: String,
  // A new window asked for, to open in this directory; a tab taken out of
  // this one for a window of its own.
  opening: Option[String],
  adopting: Option[(layout.Group, List[tabset.Tab])],
  // The divider being dragged.
  dividing: Option[layout.Divider],
  stats: Stats,
}

/// Debugging: SPRID_DEBUG's counts of frames, wakes and input-to-frame
/// latency; SPRID_TRACE's log of reads and frames; SPRID_AUTOSCROLL="dy,start
/// ms,end ms,every ms", which turns the wheel by itself, for measuring
/// scrolling without a hand on the trackpad.
type Stats = {
  debug: Bool,
  trace: Bool,
  frames: Int,
  draw_ms: Int,
  wakes: Int,
  wake_report: Int,
  // From an input being taken to the frame showing it, ms.
  input_at: Int,
  latency_max: Int,
  latency_sum: Int,
  latency_n: Int,
  auto: List[Float],
  auto_next: Int,
  // SPRID_QUIT_MS: when to quit as Cmd+Q does, for a test of what quitting
  // keeps; -1 when not.
  quit_at: Int,
  // The windows kept while sprid runs (restore.keep_running): when last,
  // the text kept, and whether a keep waits for KEEP_MS to pass.
  kept_at: Int,
  kept: String,
  keep_due: Bool,
}

/// How often, at most, the windows are kept while sprid runs, ms.
let KEEP_MS = 3000

/// The sooner of two waits, ms; -1 is no limit.
fn sooner(a: Int, b: Int) -> Int = if a < 0 then b else if b < 0 then a else int.min(a, b)

/// Frames keep step with the display, as Ghostty's do: while frames are
/// being drawn the host's display link runs, and a frame is drawn only when
/// it ticks, so each refresh shows what had changed up to the tick before it
/// — never two frames in one refresh and none in the next, which a wheel
/// turned at its own pace made of frames drawn as its events came, and
/// which showed as scrolling that caught. The link is kept running
/// `VSYNC_KEEP_MS` past the last frame, so the first frame after a pause is
/// drawn at once, and the ones after it in step. A tick that never comes —
/// the display asleep, the link lost — is given up on after `VSYNC_LOST_MS`
/// and the frame drawn unpaced.
let VSYNC_KEEP_MS = 250
let VSYNC_LOST_MS = 100

/// Whether a frame waits for the display's next tick: the link runs, the
/// last tick's frame is drawn, and the link hasn't gone quiet.
fn paced(run: Bool, due: Bool, at: Int, now: Int) -> Bool = run and not due and now - at < VSYNC_LOST_MS

test "a frame is paced while the link ticks" {
  assert_eq(paced(true, false, 1000, 1005), true)
  assert_eq(paced(true, true, 1000, 1005), false)
  assert_eq(paced(false, false, 1000, 1005), false)
  assert_eq(paced(true, false, 1000, 1100), false)
}

/// The renderer sized for the font size, padding and line height in use, in
/// pixels of the display the window is on.
fn sized(a: Session) -> render.Renderer =
  render.with_size(a.r, float.to_int(float.round(a.font_size * a.scale)),
    float.to_int(a.st.pad_x * a.scale), float.to_int(a.st.pad_y * a.scale), a.st.cell_height)

/// A frame drawn, taking `ms`.
fn count_frame(mut s: Stats, ms: Int) -> Unit = {
  s.frames = s.frames + 1
  s.draw_ms = s.draw_ms + ms
}

/// An input taken now, if none is waiting to be shown.
fn note_input(mut s: Stats, now: Int) -> Unit = { if s.input_at < 0 then s.input_at = now }

/// The input waiting to be shown shown now.
fn shown(mut s: Stats, now: Int) -> Unit = {
  if s.input_at >= 0 then {
    let lat = now - s.input_at
    s.latency_max = int.max(s.latency_max, lat)
    s.latency_sum = s.latency_sum + lat
    s.latency_n = s.latency_n + 1
    s.input_at = -1
  }
}
