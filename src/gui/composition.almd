// The input method's composition: where it lies in the row.

import snaidhm.text as text
import self.width as cell_width

/// What the input method is composing: its characters, where among them its
/// caret is, and the part being converted, [`from`, `to`) (empty when none).
type Compose = { cps: List[Int], caret: Int, from: Int, to: Int }

fn no_compose() -> Compose = Compose { cps: [], caret: 0, from: 0, to: 0 }

/// The part of a composition shown, and where: characters [`a`, `b`) from
/// column `x0` of the cursor's row. As terminals commonly lay it out: on
/// the cursor's row, over its cells, from the cursor — moved left to end
/// within the row; wider than the row, its end is shown, or from the input
/// method's caret on when the caret is before that.
fn compose_span(c: Compose, x: Int, cols: Int) -> (Int, Int, Int) = {
  let n = list.len(c.cps)
  var a = n
  var w = 0
  while a > 0 and w + cell_cols(c.cps[a - 1]) <= cols {
    a = a - 1
    w = w + cell_cols(c.cps[a])
  }
  var b = n
  let focus = compose_focus(c)
  if focus < a then {
    a = focus
    b = a
    w = 0
    while b < n and w + cell_cols(c.cps[b]) <= cols {
      w = w + cell_cols(c.cps[b])
      b = b + 1
    }
  }
  (int.max(0, int.min(x, cols - w)), a, b)
}

/// Where in a composition the input method is: the part being converted,
/// else its caret.
fn compose_focus(c: Compose) -> Int = int.clamp(if c.from < c.to then c.from else c.caret, 0, list.len(c.cps))

/// The column of the input method's caret in a composition at column `x`:
/// where its candidates go.
fn compose_caret(c: Compose, x: Int, cols: Int) -> Int = {
  let (x0, a, b) = compose_span(c, x, cols)
  x0 + cols_of(list.slice(c.cps, a, int.clamp(compose_focus(c), a, b)))
}

fn cell_cols(cp: Int) -> Int = int.max(1, cell_width.of(cp))

/// Columns `cps` take.
fn cols_of(cps: List[Int]) -> Int = list.fold(cps, 0, (acc, cp) => acc + int.max(1, cell_width.of(cp)))

test "a composition lies from the cursor, moved left to end within the row" {
  let c = (s) => { let cps = text.code_points(s); Compose { cps: cps, caret: list.len(cps), from: 0, to: 0 } }
  assert_eq(compose_span(c("a"), 2, 10), (2, 0, 1))
  assert_eq(compose_span(c("あ"), 2, 10), (2, 0, 1))
  // At the right edge it moves left.
  assert_eq(compose_span(c("あ"), 9, 10), (8, 0, 1))
  // Wider than the row: its end, where the caret is.
  assert_eq(compose_span(c("あいうえおか"), 0, 10), (0, 1, 6))
  assert_eq(compose_caret(c("あいうえおか"), 0, 10), 10)
}

test "a long composition shows from the caret when the caret is before its end" {
  let cps = text.code_points("あいうえおか")
  let at_start = Compose { cps: cps, caret: 0, from: 0, to: 0 }
  assert_eq(compose_span(at_start, 0, 10), (0, 0, 5))
  // Converting: from the part being converted.
  let converting = Compose { cps: cps, caret: 6, from: 1, to: 3 }
  assert_eq(compose_span(converting, 0, 10), (0, 1, 6))
  assert_eq(compose_caret(converting, 0, 10), 0)
}
