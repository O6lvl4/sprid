// What the tabs' programs wrote: read, and what it asks of the window —
// replies, the clipboard, bells, notifications — done.

import snaidhm.native.window as window
import self.gui.dialog
import self.gui.tabset
import self.gui.clip
import self.gui.session
import self.gui.uistate
import self.pty
import self.sys
import self.terminal

/// Every tab's output, the active tab's with the longer budget.
effect fn read_all(mut a: session.Session) -> Unit = {
  a.streaming = false
  for i in 0..<list.len(a.tabs) {
    match tabset.take(a.tabs, i) {
      some(tb) => {
        var cur = tb
        read_tab(a, cur, i)!
        list.push(a.tabs, cur)
        a.tabs = list.swap(a.tabs, i, list.len(a.tabs) - 1)
      },
      none => (),
    }
  }
}

effect fn read_tab(mut a: session.Session, mut cur: tabset.Tab, i: Int) -> Unit = {
  let title_before = (cur.t.title, cur.t.cwd)
  let bells_before = cur.t.bells
  tabset.hold_sel(cur)
  let (got, more) = tabset.drain(cur, if i == a.active then session.STREAM_DRAIN_MS else session.DRAIN_MS, i == a.active)
  // The text under the selection moved: the selection goes, and a drag
  // making it stops — its anchor is on other text now.
  if got and tabset.drop_moved_sel(cur, more) then {
    if i == a.active then { a.ui.dragging = false }
    uistate.touch(a.ui)
  }
  if got then asks(a, cur, i, cur.t.bells != bells_before)!
  // A tab in the back retitled itself: the tab bar shows it.
  if got and i != a.active and (cur.t.title, cur.t.cwd) != title_before then uistate.touch(a.ui)
  if got and a.stats.trace then eprintln("out ${int.to_string(sys.now_ms())} tab ${int.to_string(i)} cursor ${int.to_string(cur.t.x)},${int.to_string(cur.t.y)}")
  if i == a.active then {
    if got then uistate.touch(a.ui)
    if more then a.streaming = true
  }
  let replies = terminal.take_replies(cur.t)
  if replies != "" then {
    let _ = pty.write(cur.fd, replies)
  }
}

/// What the program in tab `i` asked of the window: the clipboard set or
/// read, a bell (`bell`), notifications.
effect fn asks(mut a: session.Session, mut cur: tabset.Tab, i: Int, bell: Bool) -> Unit = {
  clipboard(a, cur)!
  let notices = terminal.take_notices(cur.t)
  let looked_at = i == a.active and a.r.focused
  // A bell: the screen lit where it is being looked at, a sound if asked
  // for.
  if bell and looked_at and a.st.bell_flash then flash(a)
  if bell and a.st.bell_system then dialog.beep()
  let noticed = list.len(notices) > 0
  if (bell and a.st.bell_title or noticed) and not looked_at then mark(a, cur)
  if not a.r.focused then away(a, cur, bell, notices)!
}

/// OSC 52: the clipboard set, if the config lets programs; read, if the
/// user does.
effect fn clipboard(a: session.Session, mut cur: tabset.Tab) -> Unit = {
  match terminal.take_clipboard(cur.t) {
    some(text) => if a.st.clipboard_write then { let _ = sys.clipboard_set(text) },
    none => (),
  }
  let asked = terminal.take_clipboard_ask(cur.t)
  if asked != "" and may_read_clipboard(a, cur)! then {
    let _ = pty.write(cur.fd, terminal.clipboard_reply(asked, clip.clipboard()!))
  }
}

/// The visual bell's light on.
fn flash(mut a: session.Session) -> Unit = {
  session.set_flash(a.r, true)
  a.flash_until = sys.now_ms() + session.FLASH_MS
  uistate.touch(a.ui)
}

/// A tab not being looked at marked.
fn mark(mut a: session.Session, mut cur: tabset.Tab) -> Unit =
  if not cur.alert then {
    cur.alert = true
    uistate.touch(a.ui)
  }

/// With the window in the background: the Dock asked to show a bell or
/// notification, and the notifications shown in Notification Center.
effect fn away(a: session.Session, cur: tabset.Tab, bell: Bool, notices: List[(String, String)]) -> Unit = {
  if bell and a.st.bell_attention or list.len(notices) > 0 then window.request_attention()
  for (title, body) in notices {
    dialog.notify(if title != "" then title else tabset.title_of(cur, a.home), body)
  }
}

/// Whether a program may read the clipboard: as the config says, asking
/// the user by default — and refused on Linux while there is no dialog to
/// ask with.
effect fn may_read_clipboard(a: session.Session, cur: tabset.Tab) -> Bool =
  if a.st.clipboard_read == "allow" then true
  else if a.st.clipboard_read == "ask" and not sys.is_linux() then clip.clipboard_read_ok(tabset.title_of(cur, a.home), a.ja)!
  else false
