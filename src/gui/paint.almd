// Frames: the tab in front drawn when it changed — held while its program
// is part way through drawing a screen — and the input method told where
// typing goes; and a capture, one frame saved as a PNG.

import env
import snaidhm.native.window as window
import snaidhm.native.frame as frame
import snaidhm.text as text
import self.gui.drawn
import self.gui.render
import self.gui.surface
import self.gui.tabset
import self.gui.uistate
import self.gui.findkeys
import self.gui.session
import self.gui.groups
import self.gui.composition
import self.field
import self.pty
import self.sys
import self.view
import self.links

/// The display refreshed: the frame for it is drawn this turn.
fn refreshed(mut a: session.Session) -> Unit = {
  a.vsync_at = sys.now_ms()
  a.vsync_due = true
  if a.stats.trace then eprintln("vsync ${int.to_string(a.vsync_at)} late ${int.to_string(window.event_code())} refresh ${int.to_string(window.refresh_rate())}")
}

/// Draw the tab in front if it changed and a frame is due — at the
/// display's tick while the link runs (see `session.paced`).
fn draw_due(mut a: session.Session) -> Unit = {
  let clock = sys.now_ms()
  let paced = session.paced(a.vsync_run, a.vsync_due, a.vsync_at, clock)
  // Drawn or not, this tick's chance is taken: what changes after it waits
  // for the next. While the link runs the ticks are the pace, and the
  // least gap between frames doesn't apply: a tick 2 ms after a frame drawn
  // late for the tick before was passed over, and the wheel's next step
  // showed a refresh late, twice as long.
  a.vsync_due = false
  let spaced = a.vsync_run or clock - a.last_frame >= session.FRAME_MS
  if a.alive and a.ui.dirty and not paced and spaced then {
    retitle(a)
    groups.place_box(a)
    // With every tab still in the list: taken out, the tab in front would
    // be missing from the tab bar.
    let titles = groups.titles(a)
    match tabset.take(a.tabs, a.active) {
      some(tb) => {
        var cur = tb
        // The program is mid-update (mode 2026, or its cursor hidden while
        // it draws): show the screen when it is done, or after a limit if
        // it never says so.
        tabset.note_updates(cur, clock)
        // Not while the view moves: the wheel waited out the hold, and the
        // view jumped the whole way at once when it ended — Claude Code
        // starts a synchronized update every few tens of ms.
        let left = if drawn.moved(cur.seen, cur.back, cur.shift) then 0 else tabset.hold_left(cur, clock)
        if a.stats.trace and left > 0 then eprintln("held ${int.to_string(clock)} for ${int.to_string(left)} ms")
        if left <= 0 then draw(a, cur, titles, clock)
        else if tabset.sliding(cur) then { a.ui.dirty = true }
        list.push(a.tabs, cur)
        a.tabs = list.swap(a.tabs, a.active, list.len(a.tabs) - 1)
      },
      none => (),
    }
  }
}

/// The window's title: the tab in front's.
fn retitle(mut a: session.Session) -> Unit = {
  let shown = match list.get(a.tabs, a.active) {
    some(tb) => tabset.title_of(tb, a.home),
    none => "",
  }
  if shown != a.window_title then {
    window.set_title(if shown == "" then "sprid" else shown)
    a.window_title = shown
  }
}

fn draw(mut a: session.Session, mut cur: tabset.Tab, titles: List[String], clock: Int) -> Unit = {
  let t0 = sys.now_ms()
  // Where the view is drawn: sliding after output, when it is.
  let (back, shift) = tabset.view_pos(cur, clock, a.r.cell_h, a.st.scroll_animation)
  groups.slide_others(a, cur.fd, clock)
  // A composition during a rename is in the tab's title, not at the cursor.
  let compose = if a.ui.renaming then composition.no_compose() else uistate.compose_of(a.ui)
  render.draw(a.r, cur.t, back, shift, cur.sel, compose, a.width, a.height, titles, groups.current_of(a, cur.fd), (a.ui.hover_tab, a.ui.hover_close),
    uistate.bar_of(a.ui), a.ui.link, groups.others(a, cur.fd))
  // What is on screen now, for the pointer to be read against until the
  // next frame: this pane's and the ones beside it. Its `back` and `shift`
  // are the view's own, not the slide's: a slide is not the view moved.
  cur.seen = some({ ...drawn.of(a.r, cur.t, back, shift), back: cur.back, shift: cur.shift })
  groups.saw_others(a, cur.fd)
  if a.stats.trace then eprintln("frame ${int.to_string(sys.now_ms())} took ${int.to_string(sys.now_ms() - t0)} view ${int.to_string(back)},${int.to_string(shift)} cursor ${int.to_string(cur.t.x)},${int.to_string(cur.t.y)} shown ${if cur.t.cursor_visible then "yes" else "no"}"
    + " preedit ${int.to_string(list.len(a.ui.preedit))} line ${view.text_of(cur.t, view.screen_line(cur.t) + cur.t.y)}")
  session.count_frame(a.stats, sys.now_ms() - t0)
  place_ime(a, cur, list.len(titles))
  a.last_frame = clock
  session.shown(a.stats, sys.now_ms())
  // A glyph the frame couldn't make in time is made by the next; a view
  // still sliding is drawn on.
  a.ui.dirty = a.r.missed or tabset.sliding(cur) or groups.others_sliding(a, cur.fd)
}

/// Tell the input method where it composes: the find bar while it has the
/// focus, the tab's title while one is being renamed, else at the input
/// method's caret in the composition, so its candidates follow the typing.
/// Told only when it moves: each time it is told, it lays out its candidate
/// window again, which shows as a flicker while typing.
fn place_ime(mut a: session.Session, cur: tabset.Tab, tabs: Int) -> Unit = {
  let r = a.r
  let ui = a.ui
  let (ix, iy) = if ui.finding and ui.find_focus then render.find_caret(r, uistate.bar(ui), ui.preedit, tabs, a.width)
    else if ui.renaming then {
      let (x0, x1) = surface.tab_span(r, groups.current(a), a.width, tabs)
      (render.title_caret(r, text.code_points(ui.draft + uistate.preedit_text(ui) + "▏"), x0, x1), 0)
    }
    else (surface.grid_left(r) + render.compose_caret(uistate.compose_of(ui), cur.t.x, cur.t.cols) * r.cell_w, surface.grid_y(r) + cur.t.y * r.cell_h)
  if a.stats.trace and list.len(ui.preedit) > 0 then trace_compose(a, cur, ix, iy)
  if (ix, iy) != (ui.ime_x, ui.ime_y) then {
    window.set_ime_area(float.from(ix) / a.scale, float.from(iy) / a.scale,
      float.from(r.cell_w) / a.scale, float.from(r.cell_h) / a.scale)
    uistate.set_ime(a.ui, ix, iy)
  }
}

fn trace_compose(a: session.Session, cur: tabset.Tab, ix: Int, iy: Int) -> Unit = {
  let ui = a.ui
  let (x0, ca, cb) = render.compose_span(uistate.compose_of(ui), cur.t.x, cur.t.cols)
  eprintln("compose ${int.to_string(sys.now_ms())} x ${int.to_string(cur.t.x)} cols ${int.to_string(cur.t.cols)} span ${int.to_string(x0)} ${int.to_string(ca)}..${int.to_string(cb)}"
    + " caret ${int.to_string(ui.preedit_caret)} sel ${int.to_string(ui.preedit_from)}..${int.to_string(ui.preedit_to)} ime_px ${int.to_string(ix)},${int.to_string(iy)} cell_w ${int.to_string(a.r.cell_w)} pad ${int.to_string(a.r.pad_x)}"
    + " text \"${list.join(list.map(ui.preedit, (c) => string.from_codepoint(c) ?? ""), "")}\"")
}

/// Capturing: once the first tab's program has ended or SPRID_CAPTURE_MS
/// passed, the frame as SPRID_CAPTURE_* set it up, saved to `path`.
effect fn capture_due(mut a: session.Session, path: String) -> Unit = {
  let clock = sys.now_ms()
  let ended = list.len(a.tabs) > 0 and pty.eof(tabset.fd_of(a.tabs, 0))
  if ended or clock > (int.parse(env.get("SPRID_CAPTURE_MS") ?? "3000") ?? 3000) then {
    if a.stats.debug then eprintln("sprid: ${int.to_string(a.stats.frames)} frames, draw ${int.to_string(a.stats.draw_ms)} ms")
    let titles = groups.titles(a)
    groups.place_box(a)
    match tabset.take(a.tabs, a.active) {
      some(tb) => {
        var cur = tb
        stage(a.ui, cur, a.r.cell_h)!
        render.draw(a.r, cur.t, cur.back, cur.shift, cur.sel, uistate.compose_of(a.ui), a.width, a.height, titles, groups.current_of(a, cur.fd), (a.ui.hover_tab, a.ui.hover_close),
          uistate.bar_of(a.ui), a.ui.link, groups.others(a, cur.fd))
        list.push(a.tabs, cur)
      },
      none => (),
    }
    println(if frame.save_png(path) then "saved ${path}" else "capture failed")
    a.alive = false
  }
}

/// The view, a composition, a link and the find bar as SPRID_CAPTURE_BACK,
/// _SHIFT, _PREEDIT, _LINK, _FIND (stepped up _FIND_UP times, _FIND_STATE "selected" or
/// "blurred") ask.
effect fn stage(mut ui: uistate.Ui, mut cur: tabset.Tab, cell_h: Int) -> Unit = {
  cur.back = int.clamp(int.parse(env.get("SPRID_CAPTURE_BACK") ?? "0") ?? 0, 0, view.max_back(cur.t))
  cur.shift = int.clamp(int.parse(env.get("SPRID_CAPTURE_SHIFT") ?? "0") ?? 0, 0, cell_h - 1)
  match env.get("SPRID_CAPTURE_PREEDIT") {
    some(p) => {
      ui.preedit = text.code_points(p)
      ui.preedit_caret = list.len(ui.preedit)
    },
    none => (),
  }
  match env.get("SPRID_CAPTURE_FIND") {
    some(q) => stage_find(ui, cur, q)!,
    none => (),
  }
  // The link at "row,col" of the screen, as Cmd over it shows it.
  match env.get("SPRID_CAPTURE_LINK") {
    some(at) => {
      let n = list.map(string.split(at, ","), (x) => int.parse(x) ?? 0)
      if list.len(n) == 2 then ui.link = links.link_at(cur.t, view.screen_line(cur.t) + n[0], n[1])
    },
    none => (),
  }
}

effect fn stage_find(mut ui: uistate.Ui, mut cur: tabset.Tab, q: String) -> Unit = {
  ui.finding = true
  ui.find_focus = true
  ui.field = field.of(q)
  findkeys.set_query(cur, ui, q, true)
  let state = env.get("SPRID_CAPTURE_FIND_STATE") ?? ""
  if state == "selected" then ui.field = field.select_all(ui.field)
  if state == "blurred" then ui.find_focus = false
  for _ in 0..<(int.parse(env.get("SPRID_CAPTURE_FIND_UP") ?? "0") ?? 0) {
    findkeys.find_step(cur, ui, -1)
  }
}
