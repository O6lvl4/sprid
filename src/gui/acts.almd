// What an input asks of the tabs and the window, done once the tab it went
// to is back in the list.

import env
import self.gui.render
import self.gui.tabset
import self.gui.clip
import self.gui.uistate
import self.gui.prefs
import self.gui.session
import self.gui.groups
import self.keys
import self.pty
import self.shell
import self.sys
import self.gui.dialog
import self.gui.shortcuts
import self.gui.pointer
import self.prompts
import self.view

effect fn apply(mut a: session.Session, act: uistate.Act) -> Unit = match act {
  uistate.NewTab => new_tab(a)!,
  uistate.CloseTab => close_pane(a),
  uistate.NextTab => groups.go_to(a, (groups.current(a) + 1) % groups.count(a)),
  uistate.PrevTab => groups.go_to(a, (groups.current(a) + groups.count(a) - 1) % groups.count(a)),
  uistate.GoTo(i) => if i < groups.count(a) and i != groups.current(a) then groups.go_to(a, i),
  uistate.MoveTab(to) => groups.move_tab(a, to),
  uistate.DetachTab => { a.adopting = groups.take_out(a, groups.current(a)) },
  _ => pane_act(a, act)!,
}

/// What an input asks of the panes of the tab in front.
effect fn pane_act(mut a: session.Session, act: uistate.Act) -> Unit = match act {
  uistate.SplitPane(across) => split(a, across)!,
  uistate.FocusPane(dx, dy) => groups.focus_toward(a, dx, dy),
  uistate.CyclePane(step) => groups.cycle(a, step),
  uistate.ResizePane(dx, dy) => groups.resize(a, dx, dy),
  uistate.ZoomPane => groups.toggle_zoom(a),
  uistate.EqualPanes => groups.equalize(a),
  _ => window_act(a, act)!,
}

/// What an input asks of the window: another, closing this one, the font
/// size, the system's appearance, the focus, a paste.
effect fn window_act(mut a: session.Session, act: uistate.Act) -> Unit = match act {
  uistate.NewWindow => { a.opening = some(tabset.cwd_of(a.tabs, a.active, a.home)) },
  uistate.CloseWindow => if tabset.may_close_window(a.tabs, a.ja) then { a.alive = false },
  uistate.Zoom(step) => zoom(a, step),
  uistate.Restyle => {
    a.r = prefs.styled(a.r, a.st)!
    uistate.touch(a.ui)
  },
  uistate.Focus(on) => focus(a, on),
  uistate.Paste => paste(a, clip.clipboard()!)!,
  uistate.PastePrimary => paste(a, sys.primary_get())!,
  uistate.Selected => copy_selection(a)!,
  uistate.Menu => menu(a)!,
  _ => (),
}

/// The pane in front closed — its tab with it when it is the last — if it
/// may.
fn close_pane(mut a: session.Session) -> Unit =
  if tabset.may_close_tab(a.tabs, a.active, a.ja) then groups.close_pane(a, tabset.fd_of(a.tabs, a.active))

/// A tab in the directory of the pane in front, brought to the front.
effect fn new_tab(mut a: session.Session) -> Unit = {
  let cwd = tabset.cwd_of(a.tabs, a.active, env.get("HOME") ?? "")
  let (cols, rows) = groups.new_tab_grid(a)
  match tabset.open_tab(cols, rows, shell.command(a.st.shell_integration)!, cwd, a.st.scrollback) {
    some(tb) => groups.add_tab(a, tb),
    none => (),
  }
}

/// The pane in front split across or down: a shell in its directory takes
/// the new half, and the keys.
effect fn split(mut a: session.Session, across: Bool) -> Unit = {
  let cwd = tabset.cwd_of(a.tabs, a.active, env.get("HOME") ?? "")
  let (cols, rows) = groups.split_grid(a, across)
  match tabset.open_tab(cols, rows, shell.command(a.st.shell_integration)!, cwd, a.st.scrollback) {
    some(tb) => groups.add_pane(a, tb, across),
    none => (),
  }
}

/// The font `step` points larger, or with 0 back to the config's size. As
/// for a resize: the screen now, scrollback once the size holds, so holding
/// Cmd+Plus stays quick.
fn zoom(mut a: session.Session, step: Int) -> Unit = {
  let size = if step == 0 then a.st.font_size
    else float.clamp(a.font_size + int.to_float(step), session.MIN_FONT_SIZE, session.MAX_FONT_SIZE)
  if size != a.font_size then {
    a.font_size = size
    a.r = session.sized(a)
    groups.relayout_live(a)
    a.resized_at = sys.now_ms()
    uistate.touch(a.ui)
  }
}

/// The window gained or lost the keyboard. Programs that asked (mode 1004)
/// are told: CSI I, CSI O.
fn focus(mut a: session.Session, on: Bool) -> Unit = {
  session.set_focused(a.r, on)
  match tabset.take(a.tabs, a.active) {
    some(tb) => {
      var cur = tb
      if cur.t.focus_events then {
        let _ = pty.write(cur.fd, if on then "\x1b[I" else "\x1b[O")
      }
      list.push(a.tabs, cur)
      a.tabs = list.swap(a.tabs, a.active, list.len(a.tabs) - 1)
    },
    none => (),
  }
  uistate.touch(a.ui)
}

/// The menu a right click opens, and what was picked from it done.
effect fn menu(mut a: session.Session) -> Unit = {
  let front = list.get(a.tabs, a.active)
  let has_sel = (front |> option.flat_map((tb) => tb.sel)) != none
  // The output of the command the pointer is on, as the shell marks it.
  // FIXME(almide#3177): read `a` in the closure once that doesn't lose what
  // the menu then does to it.
  let (r, scale, open) = (a.r, a.scale, groups.count(a))
  let output = front |> option.flat_map((tb) => prompts.output_at(tb.t, pointer.pointer_line(r, tb, scale, open)))
  let names = if a.ja then ["コピー", "貼り付け", "-", "すべてを選択", "コマンドの出力を選択", "検索", "クリア"]
    else ["Copy", "Paste", "-", "Select All", "Select Command Output", "Find", "Clear"]
  let off = (i: Int) => (i == 0 and not has_sel) or (i == 4 and output == none)
  let items = list.enumerate(names) |> list.map(((i, n)) => if off(i) then "!" + n else n)
  let picked = dialog.context_menu(list.join(items, "\n"))
  if picked == 1 then paste(a, clip.clipboard()!)!
  else if picked >= 0 then menu_pick(a, picked, output)!
}

effect fn menu_pick(mut a: session.Session, picked: Int, output: Option[(Int, Int)]) -> Unit = match tabset.take(a.tabs, a.active) {
  some(tb) => {
    var cur = tb
    if picked == 0 then match cur.sel {
      some(s) => clip.copy(view.selected_text(cur.t, s))!,
      none => (),
    }
    else if picked == 3 then shortcuts.select_all(cur)
    else if picked == 4 then shortcuts.select_lines(cur, output)
    else if picked == 5 then shortcuts.open_find(cur, a.ui)
    else if picked == 6 then shortcuts.clear(cur, a.ui)
    uistate.touch(a.ui)
    list.push(a.tabs, cur)
    a.tabs = list.swap(a.tabs, a.active, list.len(a.tabs) - 1)
  },
  none => (),
}

/// The selection just made copied, as `copy-on-select` says: to the PRIMARY
/// selection (`true`, X11's and Wayland's — macOS has none), to the
/// clipboard (`clipboard`), or not (`false`).
effect fn copy_selection(a: session.Session) -> Unit = match list.get(a.tabs, a.active) {
  some(tb) => match tb.sel {
    some(s) => {
      let text = view.selected_text(tb.t, s)
      if a.st.copy_on_select == "clipboard" then clip.copy(text)!
      else if a.st.copy_on_select == "true" then { let _ = sys.primary_set(text) }
    },
    none => (),
  },
  none => (),
}

/// `text` — the clipboard's, or the PRIMARY selection's — into the tab in
/// front. Lines pasted where nothing marks them as pasted run one by one as
/// they arrive: asked first.
effect fn paste(mut a: session.Session, text: String) -> Unit = match tabset.take(a.tabs, a.active) {
  some(tb) => {
    var cur = tb
    let protect = a.st.paste_protection and not cur.t.bracketed_paste and keys.multiline(text)
    if text != "" and (not protect or clip.paste_ok(text, a.ja)!) then {
      let _ = pty.write(cur.fd, keys.paste(text, cur.t.bracketed_paste))
      if cur.back != 0 then uistate.touch(a.ui)
      tabset.scroll_to(cur, 0)
    }
    list.push(a.tabs, cur)
    a.tabs = list.swap(a.tabs, a.active, list.len(a.tabs) - 1)
  },
  none => (),
}
