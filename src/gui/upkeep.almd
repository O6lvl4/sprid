// The loop's upkeep between inputs: how long to sleep, the cursor's blink,
// the config reloaded when saved, the window resized, SPRID_DEBUG's report
// and SPRID_AUTOSCROLL's turns.

import snaidhm.native.window as window
import self.gui.fonts
import self.gui.render
import self.pty
import self.sys
import self.gui.tabset
import self.gui.uistate
import self.gui.prefs
import self.gui.findkeys
import self.gui.pointer
import self.gui.session
import self.gui.groups

/// The PTYs, and the config file's watch.
fn watched(a: session.Session) -> List[Int] =
  list.map(a.tabs, (tb) => tb.fd) + (if a.config_fd >= 0 then [a.config_fd] else [])

/// How long to sleep: until input, output on any tab, or the next frame is
/// due — with nothing to draw that is indefinitely, so an idle window costs
/// nothing — or the next thing timed: settling after a resize, the cursor's
/// blink, the bell's light going out, a write to retry, a turn of the
/// autoscroll. -1 for no limit.
fn wait_for(mut a: session.Session) -> Int = {
  let now = sys.now_ms()
  blink(a, now)
  if a.flash_until >= 0 and now >= a.flash_until then {
    a.r.flash = false
    a.flash_until = -1
    a.ui.dirty = true
  }
  let frame_wait = int.max(0, a.last_frame + session.FRAME_MS - now)
  let idle = if a.capture == none then -1 else 50
  // A frame paced by the display waits for its tick, which wakes the loop
  // by itself; the wait here only catches a link gone quiet.
  let drawn = if not a.ui.dirty then idle
    else if session.paced(a.vsync_run, a.vsync_due, a.vsync_at, now) then int.max(0, a.vsync_at + session.VSYNC_LOST_MS - now)
    else int.max(frame_wait, tabset.sync_wait(a.tabs, a.active, now))
  let until = (at: Int) => if at < 0 then -1 else int.max(0, at - now)
  // Input a program hasn't taken yet (a big paste) is offered again soon.
  let write = if list.any(a.tabs, (tb) => pty.pending(tb.fd)) then session.WRITE_RETRY_MS else -1
  let settle = if a.resized_at < 0 then -1 else a.resized_at + session.SETTLE_MS
  // Output still waiting on the active tab's PTY (the drain's budget ran
  // out): no wait at all. Woken by the PTY instead, the loop came back 13
  // to 20 ms later on macOS, and a tab streaming output drew a frame every
  // 25 ms with half the time asleep.
  // A keep of the windows waiting (restore.keep_running) wakes the loop
  // once more, so the last change is kept with nothing after it.
  let keep = if a.stats.keep_due then until(a.stats.kept_at + session.KEEP_MS) else -1
  if a.streaming then 0
  else list.fold([until(settle), until(a.stats.auto_next), write, until(a.blink_at), until(a.flash_until), until(a.stats.quit_at), keep], drawn,
    (acc, w) => session.sooner(acc, w))
}

/// A blinking cursor turns on and off while the window has the focus.
fn blink(mut a: session.Session, now: Int) -> Unit =
  if a.r.focused and tabset.cursor_blinks(a.tabs, a.active, a.r) then {
    if a.blink_at < 0 then a.blink_at = now + session.BLINK_MS
    else if now >= a.blink_at then {
      a.r.blink_off = not a.r.blink_off
      a.blink_at = now + session.BLINK_MS
      a.ui.dirty = true
    }
  } else {
    a.blink_at = -1
    a.r.blink_off = false
  }

/// The config file was saved: it applies now — the theme, the font and its
/// size, the cursor, Option — over what was set before. (One save can be
/// seen more than once — the file, then its directory.)
effect fn reload(mut a: session.Session) -> Unit = {
  let saved = sys.watch_changed(a.config_fd)
  let fresh = if saved then prefs.read_settings()! else a.st
  if saved and fresh != a.st then {
    prefs.report(fresh)!
    let new_faces = fresh.font_family != a.st.font_family
    let resize = new_faces or (fresh.font_size, fresh.pad_x, fresh.pad_y, fresh.cell_height) != (a.st.font_size, a.st.pad_x, a.st.pad_y, a.st.cell_height)
    a.st = fresh
    window.set_option_as_alt(fresh.option_as_alt)
    if new_faces then new_font(a)!
    a.r = prefs.styled(a.r, fresh)!
    if resize then {
      a.font_size = fresh.font_size
      a.r = session.sized(a)
      groups.relayout_live(a)
      a.resized_at = sys.now_ms()
    }
    a.ui.dirty = true
  }
}

/// A renderer for the config's font family, when it is found.
effect fn new_font(mut a: session.Session) -> Unit = match fonts.find(a.st.font_family)! {
  some(f) => {
    let st = a.st
    a.r = { ...render.new(a.device, f, int.from_saturating(float.round(st.font_size * a.scale)),
      int.from_saturating(st.pad_x * a.scale), int.from_saturating(st.pad_y * a.scale), st.cell_height), focused: a.r.focused }
  },
  none => (),
}

/// SPRID_DEBUG: every 2 s, how often the loop woke and how long input took
/// to show.
fn report_wakes(mut a: session.Session, timeout: Int) -> Unit = {
  a.stats.wakes = a.stats.wakes + 1
  if a.stats.debug and sys.now_ms() - a.stats.wake_report >= 2000 then {
    let s = a.stats
    eprintln("sprid: ${int.to_string(s.wakes)} wakes in 2 s (dirty ${if a.ui.dirty then "yes" else "no"}, timeout ${int.to_string(timeout)})"
      + ", input to frame avg ${int.to_string(s.latency_sum / int.max(1, s.latency_n))} max ${int.to_string(s.latency_max)} ms over ${int.to_string(s.latency_n)}")
    a.stats = { ...s, latency_max: 0, latency_sum: 0, latency_n: 0, wakes: 0, wake_report: sys.now_ms() }
  }
}

/// The window changed size: the screens follow now, scrollback once the
/// size has held for a moment — and then the search is run again, the
/// lines being numbered anew. Moved to a display of another scale, the
/// text is drawn again at that scale, the same size to the eye.
fn resized(mut a: session.Session) -> Unit = {
  if window.resized() then {
    let scale = window.scale_factor()
    if scale != a.scale then {
      a.scale = scale
      a.r = session.sized(a)
    }
    a.width = window.width()
    a.height = window.height()
    if not window.is_fullscreen() then a.windowed = (float.from(a.width) / a.scale, float.from(a.height) / a.scale)
    groups.relayout_window(a)
    a.resized_at = sys.now_ms()
    a.ui.dirty = true
  }
  if a.resized_at >= 0 and sys.now_ms() - a.resized_at >= session.SETTLE_MS then {
    tabset.settle_all(a.tabs)
    a.resized_at = -1
    a.ui.dirty = true
    match tabset.take(a.tabs, a.active) {
      some(tb) => {
        var cur = tb
        findkeys.refresh_find(cur, a.ui)
        list.push(a.tabs, cur)
        a.tabs = list.swap(a.tabs, a.active, list.len(a.tabs) - 1)
      },
      none => (),
    }
  }
}

/// SPRID_AUTOSCROLL's turn of the wheel, when one is due.
fn autoscroll(mut a: session.Session) -> Unit = {
  let next = a.stats.auto_next
  if next >= 0 and sys.now_ms() >= next then {
    let auto = a.stats.auto
    match tabset.take(a.tabs, a.active) {
      some(tb) => {
        var cur = tb
        pointer.wheel(cur, a.ui, a.r, a.scale, auto[0], 40, 10)
        if a.stats.trace then eprintln("wheel ${int.to_string(sys.now_ms())}")
        list.push(a.tabs, cur)
        a.tabs = list.swap(a.tabs, a.active, list.len(a.tabs) - 1)
      },
      none => (),
    }
    a.stats.auto_next = if sys.now_ms() >= int.from_saturating(auto[2]) then -1 else next + int.from_saturating(auto[3])
  }
}
