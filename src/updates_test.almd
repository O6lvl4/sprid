// What a program asks of the window: updates the frame is held for,
// notifications, the clipboard, titles.

import self.terminal

test "a program that hides the cursor while it draws is mid-update while it is hidden" {
  var t = terminal.new(10, 3)
  terminal.feed_string(t, "\x1b[?25lab")
  // Hidden once, never shown: not known to pair them.
  assert_eq(terminal.mid_update(t), false)
  terminal.feed_string(t, "\x1b[?25h")
  assert_eq(terminal.mid_update(t), false)
  terminal.feed_string(t, "\x1b[?25lcd")
  assert_eq(terminal.mid_update(t), true)
  terminal.feed_string(t, "\x1b[?25h")
  assert_eq(terminal.mid_update(t), false)
  terminal.feed_string(t, "\x1b[?2026h")
  assert_eq(terminal.mid_update(t), true)
}

test "a full-screen program's first screen is mid-update until it shows the cursor" {
  var t = terminal.new(10, 3)
  // As a program starts: the cursor hidden, then the alternate screen.
  terminal.feed_string(t, "\x1b[?25l\x1b[?1049h\x1b[Htop")
  assert_eq(terminal.mid_update(t), true)
  terminal.feed_string(t, "\x1b[3;1Hbottom\x1b[?25h")
  assert_eq(terminal.mid_update(t), false)
  // Showing the cursor also made it known to pair them.
  terminal.feed_string(t, "\x1b[?25l")
  assert_eq(terminal.mid_update(t), true)
}

test "the main screen with a hidden cursor is not held" {
  var t = terminal.new(10, 3)
  terminal.feed_string(t, "\x1b[?25l\x1b[?1049h\x1b[?1049l")
  assert_eq(terminal.mid_update(t), false)
}

test "each update that begins is counted, so its hold is timed from its own start" {
  var t = terminal.new(10, 3)
  terminal.feed_string(t, "\x1b[?2026ha\x1b[?2026l\x1b[?2026hb")
  assert_eq(t.sync_starts, 2)
  // Hidden while hidden is the same redraw; shown and hidden again a new one.
  terminal.feed_string(t, "\x1b[?25l\x1b[?25l")
  assert_eq(t.hide_starts, 1)
  terminal.feed_string(t, "\x1b[?25h\x1b[?25l")
  assert_eq(t.hide_starts, 2)
  // A full-screen program's first screen begins one too.
  terminal.feed_string(t, "\x1b[?1049h")
  assert_eq(t.hide_starts, 3)
}

test "notifications: OSC 9, 777, 99 in parts, not ConEmu's 9;4" {
  var t = terminal.new(20, 3)
  terminal.feed_string(t, "\x1b]9;build done\x07\x1b]9;4;1;50\x07\x1b]777;notify;Claude;waiting; really\x1b\\")
  terminal.feed_string(t, "\x1b]99;i=1:d=0;Hello\x1b\\\x1b]99;i=1:p=body;World\x1b\\\x1b]99;e=1;aGk=\x07")
  assert_eq(terminal.take_notices(t), [("", "build done"), ("Claude", "waiting; really"), ("Hello", "World"), ("hi", "")])
  assert_eq(terminal.take_notices(t), [])
}

test "OSC 52 sets the clipboard; a read is passed on, not answered" {
  var t = terminal.new(20, 3)
  terminal.feed_string(t, "\x1b]52;c;5pel5pys6Kqe\x07")
  assert_eq(terminal.take_clipboard(t), some("日本語"))
  terminal.feed_string(t, "\x1b]52;c;?\x07")
  assert_eq((terminal.take_clipboard(t), terminal.take_replies(t), terminal.take_clipboard_ask(t), terminal.take_clipboard_ask(t)), (none, "", "c", ""))
  assert_eq(terminal.clipboard_reply("c", "日本語"), "\x1b]52;c;5pel5pys6Kqe\x1b\\")
}

test "a title with semicolons and UTF-8" {
  var t = terminal.new(20, 3)
  terminal.feed_string(t, "\x1b]2;a;b ✳ c\x07")
  assert_eq(t.title, "a;b ✳ c")
}

test "the shell's prompt is pending from a command's end to the prompt's end" {
  var t = terminal.new(20, 3)
  terminal.feed_string(t, "\x1b]133;A\x07")
  assert_eq((t.prompt_pending, t.prompt_starts), (true, 1))
  terminal.feed_string(t, "$ \x1b]133;B\x07")
  assert_eq(t.prompt_pending, false)
  terminal.feed_string(t, "ls\r\n\x1b]133;C\x07out\r\n\x1b]133;D;0\x07")
  assert_eq((t.prompt_pending, t.prompt_starts), (true, 2))
  // A, after D: the same wait, not another.
  terminal.feed_string(t, "\x1b]133;A\x07")
  assert_eq((t.prompt_pending, t.prompt_starts), (true, 2))
  terminal.feed_string(t, "$ \x1b]133;B\x07")
  assert_eq(t.prompt_pending, false)
}

test "the shell is at its prompt from the prompt's end until a command starts or Enter is typed" {
  var t = terminal.new(20, 3)
  assert_eq(t.at_prompt, false)
  terminal.feed_string(t, "\x1b]133;A\x07$ \x1b]133;B\x07")
  assert_eq(t.at_prompt, true)
  terminal.feed_string(t, "ls\r\n\x1b]133;C\x07out\r\n\x1b]133;D;0\x07")
  assert_eq(t.at_prompt, false)
  terminal.feed_string(t, "\x1b]133;A\x07$ \x1b]133;B\x07")
  assert_eq(terminal.enter_at_prompt(t), true)
  assert_eq((t.at_prompt, t.prompt_pending, t.prompt_starts), (false, true, 3))
  // Enter again before the prompt is back: no second wait.
  assert_eq(terminal.enter_at_prompt(t), false)
  assert_eq(t.prompt_starts, 3)
}

test "a title set while a command runs goes with the command; one set at the prompt stays" {
  var t = terminal.new(20, 3)
  let prompt = "\x1b]133;A\x07$ \x1b]133;B\x07"
  terminal.feed_string(t, prompt + "claude\r\n\x1b]133;C\x07\x1b]0;✳ sprid\x07")
  assert_eq(t.title, "✳ sprid")
  terminal.feed_string(t, "\x1b]133;D;0\x07")
  assert_eq(t.title, "")
  // A prompt's own title (set between A and B, or after D) is the shell's: kept.
  terminal.feed_string(t, "\x1b]133;A\x07\x1b]2;~/src\x07$ \x1b]133;B\x07ls\r\n\x1b]133;C\x07\x1b]133;D;0\x07" + prompt)
  assert_eq(t.title, "~/src")
  // A command's title with no D (the shell went with it): the next prompt clears it.
  terminal.feed_string(t, "ssh\r\n\x1b]133;C\x07\x1b]0;host\x07")
  assert_eq(t.title, "host")
  terminal.feed_string(t, "\x1b]133;A\x07")
  assert_eq(t.title, "")
}
