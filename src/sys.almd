// Process facts — @extern(rust) declarations, backed by native/sys.rs

import fs

@extern(rust, "crate::sys", "footprint")
fn footprint() -> Int = _

@extern(rust, "crate::sys", "now_ms")
fn now_ms() -> Int = _

@extern(rust, "crate::sys", "login_shell")
fn login_shell() -> String = _

@extern(rust, "crate::sys", "is_linux")
fn is_linux() -> Bool = _

@extern(rust, "crate::sys", "cwd")
fn cwd() -> String = _

@extern(rust, "crate::sys", "read_file")
fn read_file(path: String) -> Bytes = _

/// Set LANG to a UTF-8 locale when no locale is set (see native/sys.rs).
@extern(rust, "crate::sys", "ensure_utf8_locale")
fn ensure_utf8_locale() -> Unit = _

/// Put text on the system clipboard, `false` when there is no way to; and
/// read it (see native/sys.rs).
@extern(rust, "crate::sys", "clipboard_set")
fn clipboard_set(text: String) -> Bool = _

@extern(rust, "crate::sys", "clipboard_get")
fn clipboard_get() -> String = _

/// Start another sprid, a new window, in `cwd` (see native/sys.rs).
@extern(rust, "crate::sys", "open_window")
fn open_window(cwd: String) -> Bool = _

/// Open a URL or a file as the desktop does (see native/sys.rs).
@extern(rust, "crate::sys", "open_target")
fn open_target(target: String) -> Bool = _

/// Ignore SIGPIPE (see native/sys.rs).
@extern(rust, "crate::sys", "ignore_sigpipe")
fn ignore_sigpipe() -> Unit = _

/// Watch a file for changes: an fd for `wait_fds`, or -1 (see native/sys.rs).
@extern(rust, "crate::sys", "watch")
fn watch(path: String) -> Int = _

/// Whether the file watched by `fd` may have changed since last asked.
@extern(rust, "crate::sys", "watch_changed")
fn watch_changed(fd: Int) -> Bool = _

test "a watched file's save is seen" {
  let path = "/tmp/sprid-watch-test-${int.to_string(now_ms())}"
  let _ = fs.write(path, "a = 1\n")
  let fd = watch(path)
  assert_eq(fd >= 0, true)
  assert_eq(watch_changed(fd), false)
  let _ = fs.write(path, "a = 2\n")
  assert_eq(watch_changed(fd), true)
  assert_eq(watch_changed(fd), false)
  // Saved the way most editors do: a new file renamed over the old.
  let _ = fs.write(path + ".new", "a = 3\n")
  let _ = fs.rename(path + ".new", path)
  assert_eq(watch_changed(fd), true)
  let _ = fs.write(path, "a = 4\n")
  assert_eq(watch_changed(fd), true)
  let _ = fs.remove(path)
}
