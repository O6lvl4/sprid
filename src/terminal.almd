// The terminal: a VT parser feeding a screen.
//
// `feed` takes bytes from the PTY and applies them. Nothing here touches the
// OS or draws: the state is a grid of cells (see cell.almd) plus a cursor,
// modes and scrollback, and what the terminal must answer (device status,
// device attributes) collects in `replies` for the caller to write back, and
// what it asks of the window (a notification, the clipboard set) in
// `notices` and `clipboard`.
//
// The parser is the DEC VT500 state machine (vt100.net/emu/dec_ansi_parser)
// with UTF-8 decoded in the ground state. Its state lives in the Terminal
// record, so a sequence split across two reads continues where it stopped,
// and parsing allocates nothing per printed character.
//
// The grid is a ring: row y is stored at physical row (top + y) % rows, so
// scrolling the whole screen — what streaming output does on every line — is
// one row clear, not a copy of the screen. Scrolling inside margins copies
// rows.

import bytes
import self.cell
import self.record
import self.scrollback
import self.vt.core
import self.vt.screen
import self.vt.glyphs
import self.vt.csi
import self.vt.modes
import self.vt.osc
import self.vt.resize

/// The terminal (its fields: vt/core.almd).
type Terminal = core.Terminal

/// What XTVERSION reports (vt/core.almd).
let VERSION = core.VERSION
let DEFAULT_SCROLLBACK = core.DEFAULT_SCROLLBACK

fn new(cols: Int, rows: Int) -> Terminal = core.new(cols, rows)

fn with_scrollback(cols: Int, rows: Int, limit: Int) -> Terminal = core.with_scrollback(cols, rows, limit)

/// Change the screen to `cols` x `rows`.
///
/// A change of width on the main screen reflows it: the lines a program
/// wrapped — screen and scrollback — are joined and wrapped again at the new
/// width, and the cursor stays at its place in its line. The alternate screen
/// is cut or padded instead: the program on it redraws it for the new size.
/// When only the height changes, the lines above the cursor that no longer
/// fit move to scrollback, so the cursor's line stays on screen.
fn resize(mut t: Terminal, cols: Int, rows: Int) -> Unit = resize.resize(t, cols, rows)

/// `resize` while the size is still changing — a window being dragged: only
/// the screen is reflowed, which is quick; scrollback keeps its lines at the
/// widths they had until `settle`. Joining lines needs only the marks of
/// where they wrapped, so wrapping through the sizes in between loses
/// nothing.
fn resize_live(mut t: Terminal, cols: Int, rows: Int) -> Unit = resize.resize_live(t, cols, rows)

/// Reflow scrollback too, after `resize_live` — behind the alternate screen
/// when that is in front.
fn settle(mut t: Terminal) -> Unit = resize.settle(t)

/// Take the pending replies.
fn take_replies(mut t: Terminal) -> String = core.take_replies(t)

fn phys(t: Terminal, y: Int) -> Int = screen.phys(t, y)

fn row_off(t: Terminal, y: Int) -> Int = screen.row_off(t, y)

/// Combining marks of row y, keyed by column, for the scrollback record.
fn row_extras(t: Terminal, y: Int) -> Map[Int, String] = screen.row_extras(t, y)

/// Take the notifications asked for since last time.
fn take_notices(mut t: Terminal) -> List[(String, String)] = osc.take_notices(t)

/// Take the text a program put on the clipboard since last time.
fn take_clipboard(mut t: Terminal) -> Option[String] = osc.take_clipboard(t)

/// Take a program's request to read the clipboard: the targets it named,
/// "" when there is none.
fn take_clipboard_ask(mut t: Terminal) -> String = osc.take_clipboard_ask(t)

/// The answer to a clipboard read (OSC 52) for `targets`: `text` as base64.
fn clipboard_reply(targets: String, text: String) -> String = osc.clipboard_reply(targets, text)

/// The URI of link `id` (a cell's `cell.link_at`), when it is one.
fn link_uri(t: Terminal, id: Int) -> Option[String] =
  if id == 0 then none else map.get(t.links, id) |> option.map((e) => e.1)

/// The part of `mid_update` a hidden cursor tells: a program that hides it
/// to draw has it hidden, or a full-screen program draws its first screen.
fn drawing_hidden(t: Terminal) -> Bool = modes.drawing_hidden(t)

/// Whether the program is part way through drawing a screen: inside a
/// synchronized update (mode 2026), or with the cursor hidden — by a program
/// known to hide it while it draws, or by one drawing its first full
/// screen, which it shows the cursor on when done. A program writes a large
/// screen in pieces, sometimes tens of ms apart; drawn in between, the
/// screen shows its top half new and its bottom half old.
fn mid_update(t: Terminal) -> Bool = modes.mid_update(t)

/// Apply output from the PTY.
fn feed(mut t: core.Terminal, data: Bytes) -> Unit = {
  let n = bytes.len(data)
  var i = 0
  while i < n {
    let b = bytes.read_u8(data, i)
    // Printable ASCII in the ground state — most of any output — skips the
    // state machine, the width lookup and the combining-mark path.
    if b >= 0x20 and b < 0x7F and t.state == core.GROUND and t.utf8_need == 0 and not t.dec_graphics and not t.insert then {
      glyphs.print_ascii(t, b)
      i = glyphs.print_ascii_run(t, data, i + 1, n)
    } else {
      step(t, b)
      i = i + 1
    }
  }
}

fn feed_string(mut t: core.Terminal, s: String) -> Unit = feed(t, bytes.from_string(s))

fn step(mut t: core.Terminal, b: Int) -> Unit =
  if t.utf8_need > 0 and b >= 0x80 and b <= 0xBF then utf8_continue(t, b)
  else {
    // A sequence cut short: show the replacement, then take b afresh.
    if t.utf8_need > 0 then {
      t.utf8_need = 0
      glyphs.print(t, 0xFFFD)
    }
    control_or_state(t, b)
  }

/// The next byte of a UTF-8 sequence; the character printed at its last.
fn utf8_continue(mut t: core.Terminal, b: Int) -> Unit = {
  t.utf8_cp = int.bor(int.bshl(t.utf8_cp, 6), int.band(b, 0x3F))
  t.utf8_need = t.utf8_need - 1
  if t.utf8_need == 0 then glyphs.print(t, valid_cp(t.utf8_cp, t.utf8_min))
}

/// CAN and SUB cancel a sequence and ESC starts one in any state; any other
/// byte is the state's.
fn control_or_state(mut t: core.Terminal, b: Int) -> Unit =
  if b == 0x18 or b == 0x1A then { t.state = core.GROUND }
  else if b == 0x1B then {
    if t.state == core.OSC_STRING then osc.osc_dispatch(t)
    enter_escape(t)
  }
  else in_state(t, b)

/// `b` in the parser's state.
fn in_state(mut t: core.Terminal, b: Int) -> Unit =
  if t.state == core.GROUND then ground(t, b)
  else if t.state == core.OSC_STRING then osc.osc_byte(t, b)
  else if t.state == core.IGNORED_STRING then ()
  // DEL leaves ESC and CSI sequences in their current state (VT500).
  else if b == 0x7F then ()
  else if b < 0x20 then execute(t, b)
  else if t.state == core.ESCAPE then escape(t, b)
  else if t.state == core.ESCAPE_INTERMEDIATE then escape_intermediate(t, b)
  else csi.csi(t, b)

fn enter_escape(mut t: core.Terminal) -> Unit = {
  t.state = core.ESCAPE
  t.intermediate = 0
}

fn ground(mut t: core.Terminal, b: Int) -> Unit =
  if b < 0x20 then execute(t, b)
  else if b < 0x7F then glyphs.print(t, b)
  else if b == 0x7F then ()
  else utf8_lead(t, b)

/// The first byte of a UTF-8 sequence: how many follow, and the bits it
/// carries; anything else shown as the replacement character.
fn utf8_lead(mut t: core.Terminal, b: Int) -> Unit =
  if b >= 0xC2 and b <= 0xDF then { t.utf8_need = 1; t.utf8_cp = int.band(b, 0x1F); t.utf8_min = 0x80 }
  else if b >= 0xE0 and b <= 0xEF then { t.utf8_need = 2; t.utf8_cp = int.band(b, 0x0F); t.utf8_min = 0x800 }
  else if b >= 0xF0 and b <= 0xF4 then { t.utf8_need = 3; t.utf8_cp = int.band(b, 0x07); t.utf8_min = 0x10000 }
  else glyphs.print(t, 0xFFFD)

/// `cp` if UTF-8 may encode it in a sequence for at least `min`: else the
/// replacement character — overlong forms, surrogates and past U+10FFFF are
/// not characters, and `cat` of a binary file shows them as such.
fn valid_cp(cp: Int, min: Int) -> Int =
  if cp < min or (cp >= 0xD800 and cp <= 0xDFFF) or cp > 0x10FFFF then 0xFFFD else cp

fn execute(mut t: core.Terminal, b: Int) -> Unit = match b {
  0x07 => { t.bells = t.bells + 1 },
  0x08 => {
    if t.x > 0 then t.x = t.x - 1
    t.pending_wrap = false
  },
  0x09 => screen.tab_forward(t, 1),
  0x0A | 0x0B | 0x0C => screen.index(t),
  0x0D => {
    t.x = 0
    t.pending_wrap = false
  },
  0x0E | 0x0F => { () },
  _ => { () },
}

fn escape(mut t: core.Terminal, b: Int) -> Unit =
  if b >= 0x20 and b <= 0x2F then {
    t.intermediate = b
    t.state = core.ESCAPE_INTERMEDIATE
  }
  else if b == 0x5B then enter_csi(t)                            // [
  else if b == 0x5D then {                                       // ]
    t.state = core.OSC_STRING
    bytes.clear(t.osc)
  }
  // DCS, SOS, PM, APC: P X ^ _
  else if list.contains([0x50, 0x58, 0x5E, 0x5F], b) then { t.state = core.IGNORED_STRING }
  else {
    t.state = core.GROUND
    escape_final(t, b)
  }

fn enter_csi(mut t: core.Terminal) -> Unit = {
  t.state = core.CSI_ENTRY
  t.n_params = 0
  t.param = -1
  t.colon = false
  t.private = 0
  t.intermediate = 0
}

/// The escape sequences that are one byte after ESC.
fn escape_final(mut t: core.Terminal, b: Int) -> Unit =
  if list.contains([0x37, 0x38, 0x44, 0x45, 0x4D], b) then escape_cursor(t, b)
  else if b == 0x48 then bytes.set_u8(t.tabs, t.x, 1)             // H HTS
  else if b == 0x63 then modes.reset(t)                          // c RIS
  else if b == 0x3D or b == 0x3E then { t.app_keypad = b == 0x3D }  // = DECKPAM, > DECKPNM
  else ()

/// DECSC, DECRC, IND, NEL, RI.
fn escape_cursor(mut t: core.Terminal, b: Int) -> Unit = match b {
  0x37 => { t.saved = screen.save_cursor(t) },            // 7 DECSC
  0x38 => screen.restore_cursor(t, t.saved),              // 8 DECRC
  0x44 => screen.index(t),                                // D IND
  0x45 => { t.x = 0; t.pending_wrap = false; screen.index(t) }, // E NEL
  _ => screen.reverse_index(t),                           // M RI
}

fn escape_intermediate(mut t: core.Terminal, b: Int) -> Unit = {
  if b >= 0x20 and b <= 0x2F then t.intermediate = b
  else {
    t.state = core.GROUND
    if t.intermediate == 0x28 then t.dec_graphics = b == 0x30          // ( 0 / ( B
    else if t.intermediate == 0x23 and b == 0x38 then modes.align_test(t)   // # 8 DECALN
  }
}

/// Row y as text, trailing blanks trimmed.
fn row_text(t: core.Terminal, y: Int) -> String = {
  let off = screen.row_off(t, y)
  let row = bytes.slice(t.grid, off, off + t.cols * cell.SIZE)
  let extras = screen.row_extras(t, y)
  var s = ""
  for x in 0..<t.cols {
    s = s + record.cell_text(row, x, extras)
  }
  string.trim_end(s)
}

/// The screen as text, one line per row, trailing empty rows dropped.
fn screen_text(t: core.Terminal) -> String = {
  var lines = list.map(0..<t.rows, (y) => row_text(t, y))
  while list.len(lines) > 0 and list.last(lines) == some("") {
    lines = list.drop_end(lines, 1)
  }
  list.join(lines, "\n")
}

/// Everything the terminal holds, scrollback first.
fn full_text(t: core.Terminal) -> String =
  list.join(scrollback.texts(t.sb) + [screen_text(t)], "\n")

/// Attributes of the cell at (x, y), for tests and renderers.
fn cell_fg(t: core.Terminal, x: Int, y: Int) -> Int = bytes.read_u32_le(t.grid, screen.cell_off(t, x, y) + cell.OFF_FG)

fn cell_bg(t: core.Terminal, x: Int, y: Int) -> Int = bytes.read_u32_le(t.grid, screen.cell_off(t, x, y) + cell.OFF_BG)

fn cell_attrs(t: core.Terminal, x: Int, y: Int) -> Int = int.band(bytes.read_u16_le(t.grid, screen.cell_off(t, x, y) + cell.OFF_ATTRS), cell.ATTR_MASK)

fn cell_link(t: core.Terminal, x: Int, y: Int) -> Int = cell.link_at(t.grid, screen.cell_off(t, x, y))
