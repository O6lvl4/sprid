// Lines by absolute number, across scrollback and screen.
//
// Every line the terminal has ever held gets a number: scrollback's oldest
// kept line is `first_line`, the screen's row 0 is `screen_line`, and a line
// keeps its number while output scrolls it up and into scrollback. The
// viewport and a selection are held in these numbers, so neither moves when
// new output arrives underneath them.

import bytes
import self.cell
import self.scrollback
import self.terminal

fn first_line(t: terminal.Terminal) -> Int = t.sb.evicted_lines

fn screen_line(t: terminal.Terminal) -> Int = t.sb.evicted_lines + scrollback.line_count(t.sb)

/// Line `n` as a row of `t.cols` cells, or none when it has been evicted or
/// is below the screen. On the alternate screen only its rows are lines.
fn line_at(t: terminal.Terminal, n: Int) -> Option[scrollback.Row] = {
  let rel = n - first_line(t)
  let kept = scrollback.line_count(t.sb)
  if rel < 0 then none
  else if rel < kept then {
    if t.alt then none else scrollback.row(t.sb, rel, t.cols)
  } else if rel - kept < t.rows then {
    let y = rel - kept
    let off = terminal.row_off(t, y)
    some(scrollback.Row {
      cells: bytes.slice(t.grid, off, off + t.cols * cell.SIZE),
      extras: terminal.row_extras(t, y),
      wrapped: bytes.read_u8(t.wrapped, terminal.phys(t, y)) == 1,
    })
  } else none
}

/// Line of the viewport's top row when it is scrolled back `back` lines.
fn top_line(t: terminal.Terminal, back: Int) -> Int = screen_line(t) - back

/// How far back the viewport can scroll: all of scrollback on the main
/// screen, none on the alternate one.
fn max_back(t: terminal.Terminal) -> Int = if t.alt then 0 else scrollback.line_count(t.sb)

// ── Selection ─────────────────────────────────────────────────────────────

/// Cells from (anchor_line, anchor_col) to (head_line, head_col), both ends
/// included, in reading order whichever way it was dragged.
type Selection = { anchor_line: Int, anchor_col: Int, head_line: Int, head_col: Int }

/// The selection's ends in reading order: (start line, start col, end line,
/// end col).
fn ordered(s: Selection) -> (Int, Int, Int, Int) =
  if s.anchor_line < s.head_line or (s.anchor_line == s.head_line and s.anchor_col <= s.head_col)
  then (s.anchor_line, s.anchor_col, s.head_line, s.head_col)
  else (s.head_line, s.head_col, s.anchor_line, s.anchor_col)

fn selected(s: Selection, line: Int, col: Int) -> Bool = {
  let (l0, c0, l1, c1) = ordered(s)
  if line < l0 or line > l1 then false
  else if l0 == l1 then col >= c0 and col <= c1
  else if line == l0 then col >= c0
  else if line == l1 then col <= c1
  else true
}

/// The selected text. Lines end in a newline unless they wrapped onto the
/// next; trailing blanks of a line are dropped.
fn selected_text(t: terminal.Terminal, s: Selection) -> String = {
  let (l0, c0, l1, c1) = ordered(s)
  var out = ""
  for n in l0...l1 {
    match line_at(t, n) {
      some(row) => {
        let from = if n == l0 then c0 else 0
        let to = if n == l1 then int.min(c1, t.cols - 1) else t.cols - 1
        var line = ""
        for x in from...to {
          line = line + scrollback.cell_text(row.cells, x, row.extras)
        }
        let last = n == l1
        out = out + (if row.wrapped and not last then line else string.trim_end(line)) + (if last or row.wrapped then "" else "\n")
      },
      none => (),
    }
  }
  out
}

// ── Selecting by word and by line ──────────────────────────────────────────

/// What a press selects: a cell (`unit` 0: a drag goes cell by cell), the
/// word under it (1, a double click) or its line (2, a triple click), as
/// (start line, start col, end line, end col).
fn unit_span(t: terminal.Terminal, unit: Int, line: Int, col: Int) -> (Int, Int, Int, Int) =
  if unit == 1 then word_span(t, line, col)
  else if unit == 2 then line_span(t, line)
  else (line, col, line, col)

/// The line `line` is part of, as the program wrote it: from the row it
/// starts on to the row it ends on, across the rows it wrapped onto.
fn line_span(t: terminal.Terminal, line: Int) -> (Int, Int, Int, Int) = {
  var l0 = line
  while wraps_into(t, l0) {
    l0 = l0 - 1
  }
  var l1 = line
  while wraps(t, l1) and line_at(t, l1 + 1) != none {
    l1 = l1 + 1
  }
  (l0, 0, l1, t.cols - 1)
}

/// The run of cells around (`line`, `col`) of one kind (see `kind_of`),
/// across the rows a line wrapped onto: a word, a path or URL, a run of
/// Japanese of one script, a run of blanks.
fn word_span(t: terminal.Terminal, line: Int, col: Int) -> (Int, Int, Int, Int) = {
  let k = kind_in(t, line, col)
  guard k >= 0 else (line, col, line, col)
  // Left through the row, then onto the end of the row before when it
  // wrapped onto this one; right likewise.
  var l0 = line
  var c0 = col
  var going = true
  while going {
    let (l, c) = if c0 > 0 then (l0, c0 - 1) else if wraps_into(t, l0) then (l0 - 1, t.cols - 1) else (l0, -1)
    if c >= 0 and kind_in(t, l, c) == k then {
      l0 = l
      c0 = c
    } else going = false
  }
  var l1 = line
  var c1 = col
  going = true
  while going {
    let (l, c) = if c1 < t.cols - 1 then (l1, c1 + 1) else if wraps(t, l1) then (l1 + 1, 0) else (l1, -1)
    if c >= 0 and kind_in(t, l, c) == k then {
      l1 = l
      c1 = c
    } else going = false
  }
  (l0, c0, l1, c1)
}

/// The kind of the character at (`line`, `col`), -1 where there is no line.
fn kind_in(t: terminal.Terminal, line: Int, col: Int) -> Int = match line_at(t, line) {
  some(row) => kind_at(row, col),
  none => -1,
}

/// Whether line `n` continues onto the next.
fn wraps(t: terminal.Terminal, n: Int) -> Bool = match line_at(t, n) {
  some(row) => row.wrapped,
  none => false,
}

/// Whether line `n` continues the one before it.
fn wraps_into(t: terminal.Terminal, n: Int) -> Bool = wraps(t, n - 1)

/// The kind of the character at column `x` of `row`, the right half of a
/// wide character counting as the character.
fn kind_at(row: scrollback.Row, x: Int) -> Int = {
  let o = x * cell.SIZE
  let tail = x > 0 and bytes.read_u8(row.cells, o + cell.OFF_WIDTH) == 0
  kind_of(bytes.read_u32_le(row.cells, if tail then o - cell.SIZE + cell.OFF_CP else o + cell.OFF_CP))
}

/// Characters of one kind make one word: blanks (0); letters, digits and
/// what paths, URLs and options are made of (1) — a double click takes
/// `~/src/app.almd:12` or `--release` whole; Japanese by script, hiragana
/// (2), katakana (3), kanji (4), as it has no spaces between words; and
/// any other symbol (5), each kind apart from the others.
fn kind_of(cp: Int) -> Int =
  if cp <= 32 or cp == 0x3000 then 0
  else if (cp >= 0x30 and cp <= 0x39) or (cp >= 0x41 and cp <= 0x5A) or (cp >= 0x61 and cp <= 0x7A) then 1
  else if cp < 0x80 then (if string.contains("_-./~:@%+#?&=", string.from_codepoint(cp)) then 1 else 5)
  else if cp >= 0x3041 and cp <= 0x309F then 2
  else if (cp >= 0x30A0 and cp <= 0x30FF) or (cp >= 0x31F0 and cp <= 0x31FF) or (cp >= 0xFF66 and cp <= 0xFF9F) then 3
  else if (cp >= 0x4E00 and cp <= 0x9FFF) or (cp >= 0x3400 and cp <= 0x4DBF) or (cp >= 0xF900 and cp <= 0xFAFF) or cp == 0x3005 then 4
  // Box drawing, blocks, CJK and fullwidth punctuation: symbols.
  else if (cp >= 0x2500 and cp <= 0x259F) or (cp >= 0x3000 and cp <= 0x303F) or (cp >= 0xFF01 and cp <= 0xFF0F)
    or (cp >= 0xFF1A and cp <= 0xFF20) or (cp >= 0xFF3B and cp <= 0xFF40) or (cp >= 0xFF5B and cp <= 0xFF65) then 5
  else 1

fn run(cols: Int, rows: Int, input: String) -> terminal.Terminal = {
  var t = terminal.new(cols, rows)
  terminal.feed_string(t, input)
  t
}

fn text_of(t: terminal.Terminal, n: Int) -> String =
  match line_at(t, n) {
    some(row) => {
      var s = ""
      for x in 0..<t.cols {
        s = s + scrollback.cell_text(row.cells, x, row.extras)
      }
      string.trim_end(s)
    },
    none => "<none>",
  }

test "lines keep their numbers as they scroll into scrollback" {
  var t = run(10, 2, "a\r\nb")
  assert_eq((text_of(t, 0), text_of(t, 1)), ("a", "b"))
  terminal.feed_string(t, "\r\nc\r\nd")
  assert_eq((text_of(t, 0), text_of(t, 1), text_of(t, 2), text_of(t, 3)), ("a", "b", "c", "d"))
  assert_eq(screen_line(t), 2)
  assert_eq(text_of(t, 4), "<none>")
}

test "evicted lines are gone but numbers stay" {
  var t = terminal.new(10, 2)
  // A budget of one byte in 64-byte blocks: every sealed block is evicted.
  t.sb = scrollback.with_block(1, 64)
  for i in 0..<20 {
    terminal.feed_string(t, "line ${int.to_string(i)}\r\n")
  }
  terminal.feed_string(t, "d")
  assert(first_line(t) > 0)
  assert_eq(text_of(t, first_line(t) - 1), "<none>")
  assert_eq(text_of(t, screen_line(t) + 1), "d")
}

test "a selection reads across scrollback and screen" {
  let t = run(10, 2, "hello\r\nworld\r\nagain")
  let s = Selection { anchor_line: 2, anchor_col: 2, head_line: 0, head_col: 1 }
  assert_eq(selected_text(t, s), "ello\nworld\naga")
}

test "wrapped lines copy as one" {
  let t = run(4, 3, "abcdefg")
  let s = Selection { anchor_line: 0, anchor_col: 0, head_line: 1, head_col: 3 }
  assert_eq(selected_text(t, s), "abcdefg")
}

test "selected is inclusive at both ends" {
  let s = Selection { anchor_line: 1, anchor_col: 5, head_line: 3, head_col: 2 }
  assert(selected(s, 1, 5))
  assert(not selected(s, 1, 4))
  assert(selected(s, 2, 0))
  assert(selected(s, 3, 2))
  assert(not selected(s, 3, 3))
}

test "a double click takes a word, a path whole, and Japanese by script" {
  let t = run(40, 2, "ls ~/src/app.almd:12 done\r\n漢字をひらがなカタカナ")
  let span = (l, c) => { let (l0, c0, l1, c1) = word_span(t, l, c); selected_text(t, Selection { anchor_line: l0, anchor_col: c0, head_line: l1, head_col: c1 }) }
  assert_eq(span(0, 0), "ls")
  assert_eq(span(0, 8), "~/src/app.almd:12")
  assert_eq(span(1, 1), "漢字")
  assert_eq(span(1, 7), "をひらがな")
  assert_eq(span(1, 15), "カタカナ")
}

test "a double click follows a word onto the row it wrapped onto" {
  let t = run(4, 3, "ab cdefgh")
  assert_eq(word_span(t, 1, 1), (0, 3, 2, 0))
}

test "a triple click takes the whole line, wrapped rows included" {
  let t = run(4, 4, "x\r\nabcdefg\r\ny")
  assert_eq(line_span(t, 2), (1, 0, 2, 3))
  assert_eq(line_span(t, 1), (1, 0, 2, 3))
  assert_eq(line_span(t, 0), (0, 0, 0, 3))
}
