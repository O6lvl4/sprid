// What the config file sets, as values with their defaults: the parsed file
// (`config.almd`) read into the settings sprid runs with, each value that
// doesn't parse reported and left at its default.

import self.config
import self.theme

type Settings = {
  // A font by family name ("" for sprid's choice), its size in points, the
  // cell height as a multiple of the font's line, padding in points.
  font_family: String,
  font_size: Float,
  cell_height: Float,
  pad_x: Float,
  pad_y: Float,
  // The themes for a light and a dark system appearance.
  theme_light: String,
  theme_dark: String,
  scrollback: Int,
  // The cursor until a program sets one: DECSCUSR's numbers (1 blinking
  // block .. 6 steady bar); 0 leaves it to sprid's default (a steady bar).
  cursor_shape: Int,
  // Which Option keys type as Alt: 0 neither, 1 both, 2 left, 3 right.
  option_as_alt: Int,
  // Programs may set the clipboard (OSC 52); reading it is asked first
  // ("ask"), always let ("allow") or never ("deny").
  clipboard_write: Bool,
  clipboard_read: String,
  // What a bell does: the screen lit for a moment, the Dock icon bounced
  // while the window is in the background, the tab marked, the system's
  // alert sound.
  bell_flash: Bool,
  bell_attention: Bool,
  bell_title: Bool,
  bell_system: Bool,
  // Ask before pasting line breaks where they would run each line.
  paste_protection: Bool,
  // What a selection made with the pointer is copied to: "true" the PRIMARY
  // selection (X11, Wayland), "clipboard" the clipboard, "false" nowhere.
  copy_on_select: String,
  // Load sprid's shell integration into zsh, bash and fish.
  shell_integration: Bool,
  // Whether quitting keeps the windows' tabs to open again: "default" as
  // the system does, "always", "never".
  window_save_state: String,
  // The file as parsed, for the colours it sets over the theme.
  file: config.Config,
  problems: List[String],
}

let DEFAULT_FONT_SIZE = 14.5
let DEFAULT_CELL_HEIGHT = 1.15
let DEFAULT_THEME = "Tokyo Night Storm"
let DEFAULT_SCROLLBACK = 10000000

fn defaults() -> Settings = {
  let problems: List[String] = []
  Settings {
    font_family: "", font_size: DEFAULT_FONT_SIZE, cell_height: DEFAULT_CELL_HEIGHT, pad_x: 12.0, pad_y: 8.0,
    theme_light: DEFAULT_THEME, theme_dark: DEFAULT_THEME, scrollback: DEFAULT_SCROLLBACK,
    cursor_shape: 0, option_as_alt: 0, clipboard_write: true, clipboard_read: "ask",
    bell_flash: true, bell_attention: true, bell_title: true, bell_system: false, paste_protection: true, copy_on_select: "true", shell_integration: true, window_save_state: "default", file: config.empty(), problems: problems,
  }
}

/// The settings `c` makes, from the defaults.
fn from(c: config.Config) -> Settings = {
  let d = defaults()
  let (light, dark) = config.get(c, "theme") |> option.map((v) => config.theme_pair(v)) ?? (d.theme_light, d.theme_dark)
  let blink = read(c, "cursor-style-blink", config.flag) ?? false
  let bells = string.split(config.get(c, "bell-features") ?? "", ",") |> list.map((b) => string.trim(b))
  Settings {
    font_family: config.get(c, "font-family") ?? d.font_family,
    font_size: read(c, "font-size", size_of) ?? d.font_size,
    cell_height: read(c, "adjust-cell-height", percent) |> option.map((p) => DEFAULT_CELL_HEIGHT * (1.0 + p / 100.0)) ?? d.cell_height,
    pad_x: read(c, "window-padding-x", padding_of) ?? d.pad_x,
    pad_y: read(c, "window-padding-y", padding_of) ?? d.pad_y,
    theme_light: light,
    theme_dark: dark,
    scrollback: read(c, "scrollback-limit", config.bytes_of) ?? d.scrollback,
    cursor_shape: read(c, "cursor-style", shape_of) |> option.map((shape) => if blink then shape - 1 else shape) ?? (if blink then 1 else 0),
    option_as_alt: read(c, "macos-option-as-alt", option_as_alt_of) ?? d.option_as_alt,
    clipboard_write: read(c, "clipboard-write", (v) => one_of(v, ["allow", "deny"])) |> option.map((v) => v == "allow") ?? d.clipboard_write,
    clipboard_read: read(c, "clipboard-read", (v) => one_of(v, ["ask", "allow", "deny"])) ?? d.clipboard_read,
    bell_flash: bell(bells, "flash", d.bell_flash),
    bell_attention: bell(bells, "attention", d.bell_attention),
    bell_title: bell(bells, "title", d.bell_title),
    bell_system: bell(bells, "system", d.bell_system),
    paste_protection: read(c, "clipboard-paste-protection", config.flag) ?? d.paste_protection,
    copy_on_select: read(c, "copy-on-select", (v) => one_of(v, ["true", "false", "clipboard"])) ?? d.copy_on_select,
    shell_integration: read(c, "shell-integration", (v) => one_of(v, ["detect", "none"])) |> option.map((v) => v == "detect") ?? d.shell_integration,
    window_save_state: read(c, "window-save-state", (v) => one_of(v, ["default", "always", "never"])) ?? d.window_save_state,
    file: c,
    problems: problems_in(c, bells),
  }
}

/// The value `key` sets in `c`, when there is one `parse` makes sense of.
fn read[T](c: config.Config, key: String, parse: (String) -> Option[T]) -> Option[T] =
  config.get(c, key) |> option.flat_map(parse)

/// What sprid makes of each key's value, to say which don't parse.
fn checks() -> List[(String, (String) -> Bool)] = [
  ("font-size", (v) => size_of(v) != none),
  ("adjust-cell-height", (v) => percent(v) != none),
  ("window-padding-x", (v) => padding_of(v) != none),
  ("window-padding-y", (v) => padding_of(v) != none),
  ("scrollback-limit", (v) => config.bytes_of(v) != none),
  ("cursor-style-blink", (v) => config.flag(v) != none),
  ("cursor-style", (v) => shape_of(v) != none),
  ("macos-option-as-alt", (v) => option_as_alt_of(v) != none),
  ("clipboard-write", (v) => one_of(v, ["allow", "deny"]) != none),
  ("clipboard-read", (v) => one_of(v, ["ask", "allow", "deny"]) != none),
  ("clipboard-paste-protection", (v) => config.flag(v) != none),
  ("copy-on-select", (v) => one_of(v, ["true", "false", "clipboard"]) != none),
  ("shell-integration", (v) => one_of(v, ["detect", "none"]) != none),
  ("window-save-state", (v) => one_of(v, ["default", "always", "never"]) != none),
]

/// What is wrong with `c`: the parser's complaints, keys sprid doesn't
/// know, values it can't use, bell features it doesn't have.
fn problems_in(c: config.Config, bells: List[String]) -> List[String] = {
  let unknown = config.unknown(c) |> list.map((k) => "unknown key: ${k}")
  let bad_values = checks() |> list.filter_map(((key, valid)) => match config.get(c, key) {
    some(v) => if valid(v) then none else some(bad(key, v)),
    none => none,
  })
  let bad_bells = bells |> list.filter((b) => b != "" and not list.contains(BELL_FEATURES, feature_of(b))) |> list.map((b) => bad("bell-features", b))
  c.problems + unknown + bad_values + bad_bells
}

fn bad(key: String, v: String) -> String = "${key}: can't use \"${v}\""

let BELL_FEATURES = ["flash", "attention", "title", "system"]

/// `flash` or `no-flash` as `flash`.
fn feature_of(item: String) -> String = if string.starts_with(item, "no-") then string.drop(item, 3) else item

/// Whether `feature` is on after `items` (`name` on, `no-name` off, the
/// last one said winning), else `fallback`.
fn bell(items: List[String], feature: String, fallback: Bool) -> Bool =
  list.fold(items, fallback, (on, item) => if item == feature then true else if item == "no-" + feature then false else on)

fn size_of(v: String) -> Option[Float] = match float.parse(v) {
  ok(f) => if f >= 4.0 and f <= 200.0 then some(f) else none,
  err(_) => none,
}

fn padding_of(v: String) -> Option[Float] = match float.parse(v) {
  ok(f) => some(float.max(0.0, f)),
  err(_) => none,
}

/// DECSCUSR's steady shape for a cursor-style.
fn shape_of(v: String) -> Option[Int] = match v {
  "block" => some(2),
  "underline" => some(4),
  "bar" => some(6),
  _ => none,
}

/// 0 neither, 1 both, 2 left, 3 right.
fn option_as_alt_of(v: String) -> Option[Int] = match v {
  "left" => some(2),
  "right" => some(3),
  _ => config.flag(v) |> option.map((on) => if on then 1 else 0),
}

fn one_of(v: String, allowed: List[String]) -> Option[String] = if list.contains(allowed, v) then some(v) else none

/// `15%` or `15` as 15.0.
fn percent(v: String) -> Option[Float] = {
  let n = if string.ends_with(v, "%") then string.drop_end(v, 1) else v
  match float.parse(string.trim(n)) {
    ok(f) => if f > -50.0 and f < 400.0 then some(f) else none,
    err(_) => none,
  }
}

/// The theme for the system appearance: a built-in one by name (or what
/// `load` makes of the name, say from a theme file), with the colours the
/// config sets over it.
fn theme_for(s: Settings, dark: Bool, load: (String) -> Option[theme.Theme]) -> theme.Theme = {
  let name = if dark then s.theme_dark else s.theme_light
  let base = match theme.named(name) {
    some(t) => t,
    none => load(name) ?? theme.default(),
  }
  theme.apply(base, s.file)
}

test "defaults when the file sets nothing" {
  let s = from(config.parse(""))
  assert_eq((s.font_size, s.theme_dark, s.scrollback, s.option_as_alt, s.cursor_shape), (14.5, "Tokyo Night Storm", 10000000, 0, 0))
}

test "values from the file, problems for the rest" {
  let s = from(config.parse("font-size = 16\ntheme = light:Almide Light,dark:Dracula\nscrollback-limit = 20MB\ncursor-style = bar\ncursor-style-blink = true\nmacos-option-as-alt = left\nfont-size2 = 3\nwindow-padding-x = x"))
  assert_eq((s.font_size, s.theme_light, s.theme_dark), (16.0, "Almide Light", "Dracula"))
  assert_eq((s.scrollback, s.cursor_shape, s.option_as_alt), (20971520, 5, 2))
  assert_eq(s.problems, ["unknown key: font-size2", "window-padding-x: can't use \"x\""])
  let c = from(config.parse("clipboard-write = deny\nclipboard-paste-protection = false"))
  assert_eq((c.clipboard_write, c.paste_protection, s.clipboard_write, s.paste_protection), (false, false, true, true))
  let b = from(config.parse("bell-features = no-flash, system,bogus\nclipboard-read = allow"))
  assert_eq((b.bell_flash, b.bell_attention, b.bell_title, b.bell_system, b.clipboard_read), (false, true, true, true, "allow"))
  assert_eq(b.problems, ["bell-features: can't use \"bogus\""])
  let sel = from(config.parse("copy-on-select = clipboard"))
  assert_eq((sel.copy_on_select, b.copy_on_select, from(config.parse("copy-on-select = maybe")).problems), ("clipboard", "true", ["copy-on-select: can't use \"maybe\""]))
}

test "the theme for each appearance, with the file's colours over it" {
  let s = from(config.parse("theme = light:Almide Light,dark:Dracula\nbackground = #000000"))
  let none_loaded = (n: String) => {
    let missing: Option[theme.Theme] = none
    missing
  }
  assert_eq(theme_for(s, true, none_loaded).name, "Dracula")
  assert_eq(theme_for(s, false, none_loaded).bg, 0x000000)
  let unknown = from(config.parse("theme = Nonesuch"))
  assert_eq(theme_for(unknown, true, none_loaded).name, "Tokyo Night Storm")
}

test "shell integration is on unless turned off" {
  assert_eq((defaults().shell_integration, from(config.parse("shell-integration = none")).shell_integration), (true, false))
  assert_eq(from(config.parse("shell-integration = zsh")).problems, ["shell-integration: can't use \"zsh\""])
}
