// Colour themes: the 16 colours, background, foreground, cursor and
// selection, and the window's own colours (tab bar, find marks) worked out
// from them, so any palette — built in, or a theme file in the config's
// format — dresses the whole window.
//
// Colours are 0xRRGGBB.

import self.config

type Theme = {
  name: String,
  bg: Int,
  fg: Int,
  cursor: Int,
  selection: Int,
  ansi: List[Int],
  // Worked out by `finish`.
  tab_bar: Int,
  tab_dim: Int,
  tab_rule: Int,
  accent: Int,
  match_bg: Int,
  match_current: Int,
  match_fg: Int,
  no_match: Int,
}

/// A theme from its own colours, the window's worked out from them.
fn make(name: String, bg: Int, fg: Int, cursor: Int, selection: Int, ansi: List[Int]) -> Theme =
  finish(Theme { name: name, bg: bg, fg: fg, cursor: cursor, selection: selection, ansi: ansi,
    tab_bar: 0, tab_dim: 0, tab_rule: 0, accent: 0, match_bg: 0, match_current: 0, match_fg: 0, no_match: 0 })

/// `t` with the window's colours worked out from its own: the tab bar a
/// shade darker than the background (lighter on a light one), its dim text
/// and rules between foreground and background, the accent the palette's
/// blue, find marks in its yellow.
fn finish(t: Theme) -> Theme = {
  let light = luma(t.bg) > 128
  let yellow = ansi_or(t, 3, 0xE0AF68)
  {
    ...t,
    tab_bar: mix(t.bg, if light then 0x000000 else 0x000000, if light then 0.06 else 0.18),
    tab_dim: mix(t.fg, t.bg, 0.45),
    tab_rule: mix(t.fg, t.bg, 0.78),
    accent: ansi_or(t, 4, t.fg),
    match_bg: mix(yellow, t.bg, if light then 0.55 else 0.65),
    match_current: ansi_or(t, 11, yellow),
    match_fg: if luma(ansi_or(t, 11, yellow)) > 128 then 0x1A1B26 else 0xFFFFFF,
    no_match: ansi_or(t, 1, 0xF7768E),
  }
}

fn ansi_or(t: Theme, i: Int, fallback: Int) -> Int = list.get(t.ansi, i) ?? fallback

fn channel(c: Int, shift: Int) -> Int = int.band(int.bshr(c, shift), 0xFF)

/// Perceived brightness, 0..255.
fn luma(c: Int) -> Int = (channel(c, 16) * 299 + channel(c, 8) * 587 + channel(c, 0) * 114) / 1000

/// `a` moved toward `b` by `t` (0: a, 1: b).
fn mix(a: Int, b: Int, t: Float) -> Int = {
  let m = (sh: Int) => {
    let x = int.to_float(channel(a, sh))
    let y = int.to_float(channel(b, sh))
    float.to_int(float.round(x + (y - x) * t))
  }
  m(16) * 65536 + m(8) * 256 + m(0)
}

