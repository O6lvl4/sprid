let SOLARIZED = [
  0x073642, 0xDC322F, 0x859900, 0xB58900, 0x268BD2, 0xD33682, 0x2AA198, 0xEEE8D5,
  0x002B36, 0xCB4B16, 0x586E75, 0x657B83, 0x839496, 0x6C71C4, 0x93A1A1, 0xFDF6E3,
]

fn solarized_dark() -> Theme = make("Solarized Dark", 0x002B36, 0x839496, 0x93A1A1, 0x073642, SOLARIZED)

fn solarized_light() -> Theme = make("Solarized Light", 0xFDF6E3, 0x657B83, 0x586E75, 0xEEE8D5, SOLARIZED)

fn builtin() -> List[Theme] = [tokyo_night_storm(), almide_light(), almide_dark(), catppuccin_mocha(),
  catppuccin_latte(), dracula(), solarized_dark(), solarized_light()]

/// The theme sprid starts with when the config names none.
fn default() -> Theme = tokyo_night_storm()

/// The built-in theme called `name`, ignoring case and spaces vs dashes.
fn named(name: String) -> Option[Theme] = {
  let key = fold_name(name)
  list.find(builtin(), (t) => fold_name(t.name) == key)
}

fn fold_name(s: String) -> String = string.replace(string.replace(string.to_lower(string.trim(s)), "-", " "), "_", " ")

/// `base` with the colours a config — the user's, or a theme file in the
/// same format — sets: background, foreground, cursor-color,
/// selection-background and palette (`N=#rrggbb`).
fn apply(base: Theme, c: config.Config) -> Theme = {
  var t = base
  match config.get(c, "background") |> option.flat_map((v) => config.color(v)) { some(v) => { t.bg = v }, none => () }
  match config.get(c, "foreground") |> option.flat_map((v) => config.color(v)) { some(v) => { t.fg = v }, none => () }
  match config.get(c, "cursor-color") |> option.flat_map((v) => config.color(v)) { some(v) => { t.cursor = v }, none => () }
  match config.get(c, "selection-background") |> option.flat_map((v) => config.color(v)) { some(v) => { t.selection = v }, none => () }
  var ansi = t.ansi
  for entry in config.all(c, "palette") {
    match string.split_once(entry, "=") {
      some((i, v)) => match (int.parse(string.trim(i)), config.color(string.trim(v))) {
        (ok(n), some(rgb)) => if n >= 0 and n < 16 then { ansi = list.set(ansi, n, rgb) },
        _ => (),
      },
      none => (),
    }
  }
  t.ansi = ansi
  finish(t)
}

test "built-in themes by name" {
  assert_eq(named("tokyo-night-storm").map((t) => t.bg), some(0x24283B))
  assert_eq(named("Almide Light").map((t) => t.fg), some(0x1F3A5F))
  assert_eq(named("nope"), none)
  assert_eq(list.len(builtin()), 8)
  assert_eq(list.all(builtin(), (t) => list.len(t.ansi) == 16), true)
}

test "a config's colours over a theme" {
  let c = config.parse("background = #000000\npalette = 1=#ff0000\npalette = 20=#ffffff\nforeground = nonsense")
  let t = apply(default(), c)
  assert_eq((t.bg, t.ansi[1], t.fg), (0x000000, 0xFF0000, 0xC0CAF5))
}

test "window colours follow light and dark" {
  let dark = default()
  let light = almide_light()
  assert_eq(luma(dark.tab_bar) < luma(dark.bg), true)
  assert_eq(luma(light.tab_bar) < luma(light.bg), true)
  assert_eq(mix(0x000000, 0xFFFFFF, 0.5), 0x808080)
}
