// OSC strings: titles, the working directory, links, prompts,
// notifications, the clipboard.

import base64
import bytes
import self.cell
import self.vt.core
import self.vt.screen

fn osc_byte(mut t: core.Terminal, b: Int) -> Unit = {
  if b == 0x07 then {
    osc_dispatch(t)
    t.state = core.GROUND
  } else if b >= 0x20 and bytes.len(t.osc) < core.OSC_MAX then bytes.push(t.osc, b)
}

fn osc_dispatch(mut t: core.Terminal) -> Unit = {
  let s = bytes.to_string_lossy(t.osc)
  let (cmd, arg) = string.split_once(s, ";") ?? (s, "")
  if not screen_osc(t, cmd, arg) then outward_osc(t, cmd, arg)
  if bytes.len(t.osc) > core.OSC_KEEP then t.osc = bytes.new(0) else bytes.clear(t.osc)
}

/// What a program says of what it shows: the title, its directory, links,
/// prompts. Whether `cmd` was one.
fn screen_osc(mut t: core.Terminal, cmd: String, arg: String) -> Bool = match cmd {
  "0" => { t.title = arg; true },
  "2" => { t.title = arg; true },
  "7" => { t.cwd = file_url_path(arg); true },
  "8" => { hyperlink(t, arg); true },
  "133" => { prompt_mark(t, arg); true },
  _ => false,
}

/// What a program asks of the world outside: notifications, the clipboard.
fn outward_osc(mut t: core.Terminal, cmd: String, arg: String) -> Unit = match cmd {
  "9" => message_notice(t, arg),
  "777" => rxvt_notice(t, arg),
  "99" => kitty_notice(t, arg),
  "52" => clipboard(t, arg),
  _ => (),
}

/// `8;params;URI` starts a link — what is printed after it, up to an
/// `8;;`, links to the URI. Parts of one link (as a program redraws around
/// it) share an `id=` among the params.
fn hyperlink(mut t: core.Terminal, arg: String) -> Unit = {
  let (params, uri) = string.split_once(arg, ";") ?? ("", "")
  let named = string.split(params, ":") |> list.filter_map((kv) => string.split_once(kv, "=")) |> list.filter((e) => e.0 == "id") |> list.last
  let name = named |> option.map((e) => e.1) ?? ""
  let link = if uri == "" then 0 else cell.link_bits(link_id(t, name, uri))
  t.attrs = int.bor(int.band(t.attrs, int.bnot(cell.LINK_MASK)), link)
}

/// `133;A` starts a shell's prompt (as do `N` and `P`), `133;B` ends it —
/// the command typed follows — `133;C` starts the command's output and
/// `133;D;status` ends it. What is printed from a start to the next of the
/// others is marked as prompt; a status other than 0 marks the prompt the
/// command was typed at as failed.
fn prompt_mark(mut t: core.Terminal, arg: String) -> Unit = {
  let kind = string.take(arg, 1)
  if kind != "" and string.contains("ANP", kind) then t.attrs = int.bor(t.attrs, cell.PROMPT_BIT)
  else if kind != "" and string.contains("BCD", kind) then t.attrs = int.band(t.attrs, int.bnot(cell.PROMPT_BIT))
  if kind == "B" then t.command_line = screen.cursor_line(t)
  if kind == "D" then {
    let status = string.split(arg, ";") |> list.get(1) ?? "0"
    if t.command_line >= 0 and status != "" and status != "0" then screen.mark_failed(t, t.command_line)
    t.command_line = -1
  }
}

/// The id of link (`name`, `uri`): the one it was given, or the next free
/// one — past `cell.LINK_MAX` the oldest are given out again.
fn link_id(mut t: core.Terminal, name: String, uri: String) -> Int = {
  let key = name + "\n" + uri
  match map.get(t.link_ids, key) {
    some(id) => id,
    none => {
      let id = t.link_next
      t.link_next = if id >= cell.LINK_MAX then 1 else id + 1
      match map.get(t.links, id) {
        some(old) => map.delete(t.link_ids, old.0 + "\n" + old.1),
        none => (),
      }
      map.insert(t.links, id, (name, uri))
      map.insert(t.link_ids, key, id)
      id
    },
  }
}

/// `9;message`. ConEmu's `9;N;...` (progress and the like, N a number up
/// to 12) shares the number and is not a message.
fn message_notice(mut t: core.Terminal, arg: String) -> Unit = {
  let first = (string.split_once(arg, ";") ?? (arg, "")).0
  let conemu = match int.parse(first) {
    ok(n) => n >= 1 and n <= 12,
    err(_) => false,
  }
  if not conemu and arg != "" then notice(t, "", arg)
}

/// rxvt's `777;notify;title;body`.
fn rxvt_notice(mut t: core.Terminal, arg: String) -> Unit = match string.split_once(arg, ";") {
  some(("notify", rest)) => {
    let (title, body) = string.split_once(rest, ";") ?? (rest, "")
    notice(t, title, body)
  },
  _ => (),
}

/// `52;targets;base64` sets the clipboard; `52;targets;?` asks for it,
/// which the window answers only if the user lets it (`clipboard_reply`).
fn clipboard(mut t: core.Terminal, arg: String) -> Unit = {
  let (targets, data) = string.split_once(arg, ";") ?? ("", "")
  if data == "?" then t.clipboard_asked = if targets == "" then "c" else targets
  else match base64.decode(data) {
    ok(b) => { t.clipboard = some(bytes.to_string_lossy(b)) },
    err(_) => (),
  }
}

fn notice(mut t: core.Terminal, title: String, body: String) -> Unit = {
  // A program printing in a loop can't pile them up.
  if list.len(t.notices) < 16 then list.push(t.notices, (title, body))
}

/// kitty's `99;metadata;payload`: the payload is the title or the body
/// (`p=`), base64 when `e=1`, and the notification is shown at the part that
/// says it is done (`d=1`, the default); parts of one share an id (`i=`).
fn kitty_notice(mut t: core.Terminal, arg: String) -> Unit = {
  let (meta, payload) = string.split_once(arg, ";") ?? (arg, "")
  let keys = string.split(meta, ":") |> list.filter_map((kv) => string.split_once(kv, "="))
  // A key given twice: the last one counts.
  let get = (k: String, fallback: String) => list.filter(keys, (e) => e.0 == k) |> list.last |> option.map((e) => e.1) ?? fallback
  let id = get("i", "")
  let text = if get("e", "0") == "1" then decoded(payload) else payload
  let (pid, ptitle, pbody) = t.notice_parts
  let (title, body) = if pid == id then (ptitle, pbody) else ("", "")
  let part = get("p", "title")
  let next = if part == "title" then (title + text, body)
    else if part == "body" then (title, body + text)
    else (title, body)
  if get("d", "1") == "0" then { t.notice_parts = (id, next.0, next.1) }
  else {
    t.notice_parts = ("", "", "")
    // A title alone is the notification's text.
    if next.0 != "" or next.1 != "" then notice(t, next.0, next.1)
  }
}

/// `payload` from base64, "" when it isn't.
fn decoded(payload: String) -> String = match base64.decode(payload) {
  ok(b) => bytes.to_string_lossy(b),
  err(_) => "",
}

/// Take the notifications asked for since last time.
fn take_notices(mut t: core.Terminal) -> List[(String, String)] = {
  let n = t.notices
  let none_yet: List[(String, String)] = []
  t.notices = none_yet
  n
}

/// Take a program's request to read the clipboard: the targets it named,
/// "" when there is none.
fn take_clipboard_ask(mut t: core.Terminal) -> String = {
  let a = t.clipboard_asked
  t.clipboard_asked = ""
  a
}

/// The answer to a clipboard read (OSC 52) for `targets`: `text` as base64.
fn clipboard_reply(targets: String, text: String) -> String =
  "\x1b]52;${targets};${base64.encode(bytes.from_string(text))}\x1b\\"

/// Take the text a program put on the clipboard since last time.
fn take_clipboard(mut t: core.Terminal) -> Option[String] = {
  let c = t.clipboard
  t.clipboard = none
  c
}

/// The path of a `file://host/path` URL, percent-decoded; "" when it is not
/// one.
fn file_url_path(url: String) -> String = {
  guard string.starts_with(url, "file://") else ""
  let rest = string.drop(url, 7)
  let path = match string.index_of(rest, "/") {
    some(i) => string.drop(rest, i),
    none => "",
  }
  let raw = bytes.from_string(path)
  var out = bytes.new(0)
  var i = 0
  let n = bytes.len(raw)
  while i < n {
    let b = bytes.read_u8(raw, i)
    let hex = if b == 0x25 and i + 2 < n then int.from_hex(bytes.read_string_at(raw, i + 1, 2)) else err("")
    match hex {
      ok(v) => {
        bytes.push(out, v)
        i = i + 3
      },
      err(_) => {
        bytes.push(out, b)
        i = i + 1
      },
    }
  }
  bytes.to_string_lossy(out)
}
