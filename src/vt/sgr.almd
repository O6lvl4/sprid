// SGR: colours and attributes.

import self.cell
import self.vt.core

fn sgr(mut t: core.Terminal) -> Unit = {
  let n = t.n_params
  var i = 0
  while i < n {
    i = i + 1 + sgr_at(t, i, subs_after(t, i))
  }
}

/// How many sub-parameters (introduced by ':') follow parameter `i`.
fn subs_after(t: core.Terminal, i: Int) -> Int = {
  var subs = 0
  while i + subs + 1 < t.n_params and core.colon_at(t, i + subs + 1) {
    subs = subs + 1
  }
  subs
}

/// Apply parameter `i`, `subs` sub-parameters after it; how many of the
/// parameters after it it took.
fn sgr_at(mut t: core.Terminal, i: Int, subs: Int) -> Int = {
  let p = int.max(core.param_at(t, i), 0)
  if p == 38 or p == 48 or p == 58 then {
    let (color, used) = if subs > 0 then extended_color_colon(t, i, subs) else extended_color(t, i)
    if p == 38 then { t.fg = color } else if p == 48 then { t.bg = color }
    if subs > 0 then subs else used
  } else {
    sgr_one(t, p, if subs > 0 then int.max(core.param_at(t, i + 1), 0) else -1)
    subs
  }
}

/// `38;5;n` / `38;2;r;g;b`: the color and how many parameters follow 38.
fn extended_color(t: core.Terminal, i: Int) -> (Int, Int) = {
  let kind = core.arg0(t, i + 1)
  if kind == 5 then (cell.palette(core.arg0(t, i + 2)), 2)
  else if kind == 2 then (cell.rgb(core.arg0(t, i + 2), core.arg0(t, i + 3), core.arg0(t, i + 4)), 4)
  else (cell.COLOR_DEFAULT, 1)
}

/// `38:5:n` / `38:2:r:g:b` / `38:2:colorspace:r:g:b`.
fn extended_color_colon(t: core.Terminal, i: Int, subs: Int) -> (Int, Int) = {
  let kind = core.arg0(t, i + 1)
  if kind == 5 then (cell.palette(core.arg0(t, i + 2)), subs)
  else if kind == 2 then {
    let first = if subs >= 5 then i + 3 else i + 2
    (cell.rgb(core.arg0(t, first), core.arg0(t, first + 1), core.arg0(t, first + 2)), subs)
  } else (cell.COLOR_DEFAULT, subs)
}

/// The attributes SGR parameters set and clear: (parameter, set, clear).
let ATTRIBUTES = [
  (1, cell.ATTR_BOLD, 0), (2, cell.ATTR_FAINT, 0), (3, cell.ATTR_ITALIC, 0),
  (5, cell.ATTR_BLINK, 0), (6, cell.ATTR_BLINK, 0), (7, cell.ATTR_INVERSE, 0),
  (8, cell.ATTR_HIDDEN, 0), (9, cell.ATTR_STRIKE, 0), (21, cell.ATTR_DOUBLE_UNDERLINE, 0),
  (22, 0, cell.ATTR_BOLD + cell.ATTR_FAINT), (23, 0, cell.ATTR_ITALIC),
  (24, 0, cell.ATTR_UNDERLINE + cell.ATTR_DOUBLE_UNDERLINE), (25, 0, cell.ATTR_BLINK),
  (27, 0, cell.ATTR_INVERSE), (28, 0, cell.ATTR_HIDDEN), (29, 0, cell.ATTR_STRIKE),
  (53, cell.ATTR_OVERLINE, 0), (55, 0, cell.ATTR_OVERLINE),
]

/// One SGR parameter; `sub` is its first sub-parameter, or -1.
fn sgr_one(mut t: core.Terminal, p: Int, sub: Int) -> Unit =
  if p == 0 then { t.fg = 0; t.bg = 0; t.attrs = int.band(t.attrs, int.bnot(cell.ATTR_MASK)) }
  else if p >= 30 and p <= 49 then base_color(t, p)
  else if p >= 90 and p <= 107 then bright_color(t, p)
  else if p == 4 then {
    // 4:0 none, 4:2 double, any other single.
    set_attr(t, cell.ATTR_UNDERLINE, sub != 0)
    set_attr(t, cell.ATTR_DOUBLE_UNDERLINE, sub == 2)
  }
  else match list.find(ATTRIBUTES, (a) => a.0 == p) {
    some((_, on, off)) => { t.attrs = int.bor(int.band(t.attrs, int.bnot(off)), on) },
    none => (),
  }

/// 30-37 and 40-47 the first 8 colours, 39 and 49 the default (38 and 48
/// are `extended_color`'s).
fn base_color(mut t: core.Terminal, p: Int) -> Unit = {
  let k = p % 10
  let color = if k == 9 then cell.COLOR_DEFAULT else cell.palette(k)
  if k == 8 then () else if p < 40 then { t.fg = color } else { t.bg = color }
}

/// 90-97 and 100-107: the bright 8.
fn bright_color(mut t: core.Terminal, p: Int) -> Unit = {
  let k = if p < 100 then p - 90 else p - 100
  if k > 7 then () else if p < 100 then { t.fg = cell.palette(k + 8) } else { t.bg = cell.palette(k + 8) }
}

fn set_attr(mut t: core.Terminal, bit: Int, on: Bool) -> Unit = {
  t.attrs = if on then int.bor(t.attrs, bit) else int.band(t.attrs, int.bnot(bit))
}
